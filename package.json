{
  "name": "daninihub",
  "version": "1.0.0",
  "description": "DaniniHub deploy package.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "npm run build:front",
    "build:front": "npm --prefix daninihub-front install && npm --prefix daninihub-front run build",
    "start": "node server.js",
    "dev": "node server.js",
    "check:syntax": "node --check danini.js && node --check server.js && node --check server-public-runtime.js && node --check server-guided-analysis-runtime.js && node --check server-gumroad-runtime.js && node --check server-admin-runtime.js && find agents core -name '*.js' -type f -print0 | xargs -0 -n1 node --check",
    "check:tree": "find . \\( -path './node_modules' -o -path './.git' -o -path './_archive' \\) -prune -o -type f -print | sort",
    "health": "node scripts/healthcheck.js",
    "agent": "node danini.js",
    "agent:dev": "node danini.js --agent dev_cto --task",
    "agent:controller": "node danini.js --agent controller --task",
    "snapshot": "npm run check:tree && npm run health",
    "test:core": "node scripts/test-agent-execution-contract.js",
    "test:guided": "node scripts/test-guided-analysis-contract.js",
    "test:gumroad": "node scripts/test-gumroad-activation-contract.js",
    "test:admin": "node scripts/test-admin-runtime-contract.js",
    "test:pilot-policy": "node scripts/test-pilot-policy-contract.js",
    "test:dispatch": "node scripts/test-dispatch-workspace-contract.js",
    "test:public": "node scripts/test-public-content-contract.js && node scripts/test-contact-lead-store.js && npm run test:pilot-policy",
    "test:os": "npm run test:core && npm run test:guided && npm run test:gumroad && npm run test:admin && npm run test:public && npm run test:dispatch",
    "test:artifact": "node scripts/test-artifact.js",
    "test:pdf": "node scripts/test-pdf.js",
    "audit:last": "node scripts/audit-last.js",
    "audit:last5": "node scripts/audit-last.js 5",
    "test:email-body": "node scripts/test-email-body.js",
    "email:send:test": "node scripts/send-latest-email.js",
    "activation:test": "node scripts/full-activation-test.js",
    "stripe:checkout:test": "node scripts/stripe-checkout-test.js",
    "stripe:simulate:completed": "node scripts/simulate-stripe-completed.js",
    "webhook:stripe": "node server/stripe-webhook.js",
    "stripe:status": "node scripts/stripe-status.js",
    "server": "node server.js",
    "dev:server": "node server.js",
    "agent:cli": "node danini.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.3",
    "openai": "^6.35.0",
    "pdfkit": "^0.18.0",
    "stripe": "^22.1.0"
  }
}
