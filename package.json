{
  "name": "daninihub",
  "version": "1.0.0",
  "private": true,
  "description": "DaniniHub production runtime: Express, Project Mode, Gate workflow, ledger, integrations and admin control.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "validate:env": "node scripts/validate-env.js",
    "validate:system": "node scripts/validate-system.js",
    "build": "npm run validate:env && npm run validate:system"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "4.18.3",
    "helmet": "^8.0.0",
    "mysql2": "^3.11.5",
    "openai": "^4.77.0",
    "stripe": "^17.4.0"
  }
}
