---
import type { Locale } from "../lib/content";
const { locale = "de" } = Astro.props as { locale: Locale };
const de = locale === "de";
---
<section id="anfrage" class="bc-section">
  <div class="wrap bc-layout">
    <div class="bc-intro">
      <p class="bc-eyebrow">DANINI BUSINESS · {de ? "PROJEKTANFRAGE" : "POSLOVNI UPIT"}</p>
      <h2>{de ? "Welchen Ablauf möchten Sie verbessern?" : "Koji poslovni postupak želite da unapredite?"}</h2>
      <p>{de
        ? "Beschreiben Sie kurz Ihre Ausgangslage. Wir prüfen Ihr Anliegen persönlich und klären Umfang und Konditionen vor einer möglichen Beauftragung."
        : "Ukratko opišite svoju situaciju. Lično proveravamo zahtev, a obim i uslove potvrđujemo pre eventualnog angažovanja."}</p>
      <p class="bc-fine">{de
        ? "Wir melden uns mit einer persönlichen Einschätzung und den nächsten konkreten Schritten."
        : "Odgovaramo lično, sa procenom zahteva i jasnim sledećim koracima."}</p>
      <div class="bc-fallback">
        <strong>{de ? "Direkter Kontakt" : "Direktan kontakt"}</strong>
        <a href="mailto:info@daninihub.com?subject=DANINI%20Business%20-%20Anfrage">info@daninihub.com</a>
      </div>
    </div>
    <form class="bc-form" data-business-enquiry data-locale={locale} aria-label={de ? "Geschäftsanfrage" : "Poslovni upit"}>
      <div class="bc-fieldset">
        <label for={"bc-name-"+locale}>{de ? "Ihr Name" : "Ime i prezime"} *</label>
        <input id={"bc-name-"+locale} name="name" autocomplete="name" required maxlength="90"/>
      </div>
      <div class="bc-fieldset">
        <label for={"bc-email-"+locale}>E-Mail *</label>
        <input id={"bc-email-"+locale} name="email" type="email" autocomplete="email" required maxlength="254"/>
      </div>
      <div class="bc-fieldset">
        <label for={"bc-company-"+locale}>{de ? "Unternehmen (optional)" : "Preduzeće (opciono)"}</label>
        <input id={"bc-company-"+locale} name="company" autocomplete="organization" maxlength="120"/>
      </div>
      <div class="bc-fieldset">
        <label for={"bc-country-"+locale}>{de ? "Zielland" : "Ciljno tržište"}</label>
        <select id={"bc-country-"+locale} name="country"><option value="DE">Deutschland / Nemačka</option><option value="AT">Österreich / Austrija</option><option value="CH">Schweiz / Švajcarska</option></select>
      </div>
      <div class="bc-fieldset">
        <label for={"bc-service-"+locale}>{de ? "Gewünschte Leistung" : "Usluga koja vas interesuje"} *</label>
        <select id={"bc-service-"+locale} name="service" required>
          <option value="">{de ? "Bitte auswählen" : "Izaberite uslugu"}</option>
          <option value="check">DANINI Business Check</option>
          <option value="intake">DANINI Anfragebüro</option>
          <option value="support">DANINI Office Betreuung</option>
          <option value="crossborder">{de ? "DACH–Balkan Geschäftsanbahnung & Lieferantenanfrage" : "DACH–Balkan poslovno povezivanje i upiti dobavljačima"}</option>
        </select>
        <small class="bc-clarity">{de ? "Wählen Sie die passende Aufgabe. Bei B2B-Anbahnung unterstützen wir die Vorbereitung von Anforderungen und Rückfragen; wir versprechen keine Geschäftspartner oder Abschlüsse." : "Odaberite zadatak. Za DACH–Balkan povezivanje pripremamo zahtev i pitanja; ne obećavamo partnera ili zaključen posao."}</small>
      </div>
      <div class="bc-fieldset">
        <label for={"bc-message-"+locale}>{de ? "Was ist das Problem und was möchten Sie erreichen?" : "Šta je problem i koji rezultat želite?"} *</label>
        <textarea id={"bc-message-"+locale} name="message" minlength="20" maxlength="3000" rows="5" required
          placeholder={de ? "Welche Anfragen gehen verloren? Welche Aufgabe kostet Zeit?" : "Koji upiti se gube? Koji zadatak oduzima previše vremena?"}></textarea>
        <small>{de ? "Bitte keine Ausweisdaten, Passwörter oder sensiblen Personaldaten senden." : "Ne šaljite lozinke, brojeve dokumenata ili osetljive lične podatke."}</small>
      </div>
      <label class="bc-consent">
        <input type="checkbox" name="consent" required/>
        <span>{de ? "Ich bin mit der Verarbeitung meiner Angaben zur Bearbeitung dieser konkreten Anfrage einverstanden." : "Saglasan/saglasna sam da se moji podaci obrade radi odgovora na ovaj konkretan upit."}
          <a href={"/"+locale+"/datenschutz/"}>{de ? "Datenschutz" : "Politika privatnosti"}</a> *</span>
      </label>
      <div class="bc-captcha" data-business-captcha aria-label={de ? "Sicherheitsprüfung" : "Bezbednosna provera"}></div>
      <button type="submit" data-business-submit disabled>{de ? "Unverbindliche Anfrage absenden" : "Pošalji neobavezujući upit"}</button>
      <p class="bc-action-note">{de ? "Nächster Schritt: Wir prüfen die Angaben und klären den Umfang per E-Mail. Es erfolgt keine automatische Bestellung und keine Zahlung." : "Sledeći korak: pregledamo podatke i mejlom preciziramo obim. Slanje nije narudžbina niti pokretanje naplate."}</p>
      <p class="bc-status" data-business-status role="status" aria-live="polite">
        {de ? "Sicherheitsprüfung wird vorbereitet …" : "Priprema bezbednosne provere …"}
      </p>
      <p class="bc-disclaimer">{de ? "Ihre Angaben dienen nur der Bearbeitung dieser Anfrage. Cloudflare Turnstile schützt vor automatisierten Einsendungen. Bitte keine Passwörter oder sensiblen Unterlagen übermitteln. Alternativ erreichen Sie uns per E-Mail." : "Podatke koristimo samo za obradu ovog upita. Cloudflare Turnstile štiti formular od automatske zloupotrebe. Ne šaljite lozinke ni osetljiva dokumenta. Dostupan je i direktan e-mail."}</p>
    </form>
  </div>
</section>
<script>
  type TSWidget = {
    render: (target: HTMLElement, options: Record<string, unknown>) => string;
    getResponse: (widget: string) => string;
    reset: (widget: string) => void;
  };
  const getTurnstile = () => (window as Window & { turnstile?: TSWidget }).turnstile;
  const serviceLabels: Record<string,string> = {
    check: "DANINI Business Check",
    intake: "DANINI Anfragebüro",
    support: "DANINI Office Betreuung",
    crossborder: "DACH–Balkan B2B Support"
  };
  for (const form of document.querySelectorAll<HTMLFormElement>("[data-business-enquiry]")) {
    const de = form.dataset.locale === "de";
    const status = form.querySelector<HTMLElement>("[data-business-status]");
    const submit = form.querySelector<HTMLButtonElement>("[data-business-submit]");
    const challenge = form.querySelector<HTMLElement>("[data-business-captcha]");
    if (!status || !submit || !challenge) continue;
    let widget: string | null = null;
    let b2b = false;
    let requestId = crypto.randomUUID();
    let active = false;
    let sending = false;
    const unavailable = () => {
      active = false;
      submit.disabled = true;
      status.textContent = de
        ? "Das sichere Formular ist derzeit nicht verfügbar. Bitte schreiben Sie an info@daninihub.com."
        : "Bezbedni formular trenutno nije dostupan. Pišite na info@daninihub.com.";
    };
    const reset = () => {
      active = false;
      submit.disabled = true;
      try { if (widget) getTurnstile()?.reset(widget); } catch { unavailable(); }
    };
    const initialize = async () => {
      try {
        const tenantResponse = await fetch("/api/tenant-config", {cache:"no-store"});
        const tenant = (tenantResponse.ok ? await tenantResponse.json() : null) as {enabled?:boolean} | null;
        b2b = tenant?.enabled === true;
        const response = await fetch("/api/lead/status", {cache:"no-store"});
        if (!response.ok) throw Error("lead_unavailable");
        const data = await response.json() as {enabled?:boolean;turnstileSiteKey?:string};
        if (data.enabled !== true || !data.turnstileSiteKey) throw Error("lead_disabled");
        const script = document.createElement("script");
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        script.onload = () => {
          try {
            const turnstile = getTurnstile();
            if (!turnstile) throw Error("turnstile_missing");
            widget = turnstile.render(challenge, {
              sitekey: data.turnstileSiteKey,
              action: b2b ? "b2b-intake" : "business-contact",
              language: de ? "de" : "sr",
              callback: () => {
                active = true;
                if (!sending) submit.disabled = false;
                status.textContent = "";
              },
              "expired-callback": reset,
              "error-callback": unavailable
            });
            status.textContent = de ? "Bitte Sicherheitsprüfung abschließen." : "Završite bezbednosnu proveru.";
          } catch { unavailable(); }
        };
        script.onerror = unavailable;
        document.head.appendChild(script);
      } catch { unavailable(); }
    };
    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (!form.reportValidity() || !active || !widget || sending) return;
      const turnstile = getTurnstile();
      const token = turnstile?.getResponse(widget);
      if (!token) {reset();return;}
      const values = new FormData(form);
      const service = String(values.get("service")||"");
      if (!Object.hasOwn(serviceLabels,service)) return;
      sending = true;
      submit.disabled = true;
      status.textContent = de ? "Ihre Anfrage wird sicher übermittelt …" : "Vaš upit se bezbedno šalje …";
      try {
        const result = await fetch(b2b ? "/api/intake" : "/api/lead", {
          method:"POST",
          headers:{"content-type":"application/json", ...(b2b ? {"idempotency-key":requestId} : {})},
          body:JSON.stringify({
            kind:"business",
            name:String(values.get("name")||"").trim(),
            email:String(values.get("email")||"").trim(),
            company:String(values.get("company")|| (de ? "Nicht angegeben" : "Nije navedeno")).trim(),
            country:String(values.get("country")||"DE"),
            vertical:service === "crossborder" ? "nearshoring" : "business",
            topic:serviceLabels[service],
            message:String(values.get("message")||"").trim(),
            language:de?"de":"sr",
            consent:values.get("consent")==="on",
            details:{service},
            turnstileToken:token
          })
        });
        const response = await result.json() as {accepted?:boolean;reference?:string;receiptAccepted?:boolean;caseId?:string;accessToken?:string};
        if (result.status!==202 || response.accepted!==true || !response.reference) throw Error("delivery_unconfirmed");
        status.textContent = (de ? "Anfrage zur Bearbeitung angenommen. Referenz: " : "Upit je prihvaćen za obradu. Broj: ") + response.reference;
        if (b2b && response.caseId && response.accessToken) {
          const panel = document.createElement("section");
          panel.className = "bc-preliminary";
          panel.setAttribute("aria-label", de ? "Vorläufige Geschäftsanalyse" : "Preliminarna poslovna analiza");
          panel.style.cssText = "color:#102238;background:#f1f5f9;padding:20px;border-radius:12px;overflow-wrap:anywhere";
          form.appendChild(panel);
          const reference = response.reference;
          const updateResult = async () => {
            const check = await fetch("/api/case/"+response.caseId, { headers: {authorization:"Bearer "+response.accessToken},cache:"no-store" });
            if (!check.ok) throw Error("status_unavailable");
            const current = await check.json() as {preliminary?:{generatedBy:string;summary:string;questions:string[]}};
            panel.replaceChildren();
            const p = document.createElement("p");
            p.textContent = current.preliminary ? ((current.preliminary.generatedBy === "ai" ? (de ? "KI-Vorprüfung: " : "AI preliminarna analiza: ") : (de ? "Strukturierte Vorprüfung: " : "Strukturisana predanaliza: ")) + current.preliminary.summary) : (de ? "Ihr Vorgang wird verarbeitet. " : "Vaš predmet se obrađuje. ")+reference;
            panel.appendChild(p);
            if (current.preliminary) {
              for (const question of current.preliminary.questions || []) {const item=document.createElement("p");item.textContent=question;panel.appendChild(item);}
              const note=document.createElement("p");note.textContent=de?"Vorläufig, nicht unabhängig recherchiert. Ein detaillierter Bericht erfordert eine gesonderte Vereinbarung.":"Preliminarno, bez nezavisnog istraživanja. Detaljan izveštaj zahteva zaseban dogovor.";panel.appendChild(note);
              const link=document.createElement("a");link.textContent=de?"DANINI Business Research Report anfragen":"Zatraži DANINI Business Research Report";
              link.href="mailto:info@daninihub.com?subject="+encodeURIComponent("DANINI Business Research Report | "+reference);panel.appendChild(link);
              return true;
            }
            return false;
          };
          const refresh=document.createElement("button");refresh.type="button";refresh.textContent=de?"Bearbeitungsstand aktualisieren":"Osveži status predmeta";
          refresh.addEventListener("click",()=>{void updateResult().catch(()=>{panel.textContent=de?"Status derzeit nicht verfügbar. Referenz: "+reference:"Status trenutno nije dostupan. Referenca: "+reference;});});
          form.appendChild(refresh);
          // Bounded polling; never resubmit the intake or duplicate the workflow.
          for (let attempt=0;attempt<8;attempt++) {
            if (await updateResult().catch(()=>false)) break;
            await new Promise(resolve=>setTimeout(resolve,2500));
          }
          requestId=crypto.randomUUID();
        }
        form.reset();
      } catch {
        status.textContent = de
          ? "Die Übermittlung konnte nicht bestätigt werden. Bitte prüfen Sie vor einem erneuten Versuch per E-Mail, ob die Anfrage bereits eingegangen ist."
          : "Prijem nije mogao da se potvrdi. Pre ponovnog slanja proverite e-mailom da li je upit već stigao.";
      } finally {
        sending = false;
        reset();
      }
    });
    void initialize();
  }
</script>
<style>
.bc-section{background:#0f172a;color:#fff;padding:clamp(56px,6vw,90px) 0}
.bc-layout{display:grid;grid-template-columns:minmax(0,.88fr) minmax(0,1.12fr);gap:clamp(35px,5vw,80px);align-items:start}
.bc-eyebrow{color:#facc15;font-size:.74rem;letter-spacing:.12em;font-weight:800;margin:0 0 17px}
.bc-intro h2{color:#fff;font-size:clamp(2rem,3.25vw,3.2rem);line-height:1.14;margin:0 0 24px}
.bc-intro p{color:#d0dbe5;line-height:1.75}
.bc-intro .bc-fine{color:#b3c4d4;font-size:.85rem}
.bc-fallback{border:1px solid #51677b;background:#ffffff0b;border-radius:13px;padding:19px;display:grid;gap:10px;margin-top:32px}
.bc-fallback a{color:#facc15;font-weight:800;overflow-wrap:anywhere}
.bc-form{background:#fff;color:#102238;border-radius:20px;padding:clamp(24px,3vw,40px);box-shadow:0 24px 60px #03071235;display:grid;gap:19px;min-width:0}
.bc-fieldset{display:grid;gap:9px;min-width:0}
.bc-fieldset label,.bc-consent{color:#102238;font-size:.91rem;font-weight:730;line-height:1.45}
.bc-fieldset input,.bc-fieldset select,.bc-fieldset textarea{width:100%;border:1.5px solid #8fa3b7;border-radius:9px;padding:13px 15px;background:#fbfdff;color:#102238;font:inherit;line-height:1.5}
.bc-fieldset textarea{resize:vertical;min-height:135px}
.bc-fieldset :is(input,select,textarea):focus{outline:3px solid #facc15;outline-offset:2px;border-color:#164e63}
.bc-fieldset input::placeholder,.bc-fieldset textarea::placeholder{color:#61758a;opacity:1}
.bc-fieldset small{color:#546579;font-size:.76rem;line-height:1.55}
.bc-consent{display:flex;gap:13px;align-items:flex-start;font-weight:500;font-size:.82rem}
.bc-consent input{width:19px;height:19px;flex-shrink:0;accent-color:#0f766e;margin-top:3px}
.bc-consent a{color:#085c54;text-decoration:underline;text-underline-offset:2px;font-weight:800}
.bc-captcha{min-height:66px;max-width:100%;overflow:hidden}
.bc-form button[type=submit]{background:#facc15;color:#102238;border:0;border-radius:10px;min-height:52px;padding:14px 19px;font-weight:800;font:inherit;cursor:pointer}
.bc-form button[type=submit]:disabled{background:#d6dde4;color:#485b70;cursor:not-allowed}
.bc-status{font-size:.84rem;font-weight:670;color:#30536a;min-height:24px;margin:0}
.bc-disclaimer{color:#4d6174;font-size:.75rem;margin:0;line-height:1.6}
@media(max-width:960px){.bc-layout{grid-template-columns:1fr}.bc-intro{max-width:770px}}
@media(max-width:600px){.bc-section{padding:55px 0}.bc-form{padding:22px}.bc-captcha{min-height:65px}}
</style>
