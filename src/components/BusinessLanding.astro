---
import Base from "../layouts/Base.astro";
import BusinessContact from "./BusinessContact.astro";
import type { Locale } from "../lib/content";
const { locale } = Astro.props as { locale: Locale };
const de = locale === "de";
const offerings = de ? [
  {title:"DANINI Business Check",desc:"Eine bestehende Anfrage- oder Verwaltungsroutine durchgehen, Datenlücken sichtbar machen und die nächsten Verbesserungen schriftlich festhalten.",output:"Ergebnis: strukturierte Analyse und konkrete Handlungsschritte."},
  {title:"DANINI Anfragebüro",desc:"Einen klar abgegrenzten Ablauf für Anfrage, Qualifizierung, CRM-Erfassung und Antwortentwurf entwerfen und nach Freigabe umsetzen.",output:"Ergebnis: ein überprüfbarer Workflow mit menschlicher Freigabe."},
  {title:"DANINI Office Betreuung",desc:"Bestehende digitale Abläufe im vereinbarten Umfang betreuen, überwachen und bei Bedarf verbessern. Laufende Betreuung nach individueller Vereinbarung.",output:"Ergebnis: kontrollierte Wartung und dokumentierte Verbesserungen."}
] : [
  {title:"DANINI Business Check",desc:"Pregled jednog postojećeg postupka za obradu upita ili administracije, identifikacija nedostataka i pisani predlog poboljšanja.",output:"Rezultat: strukturisana analiza i konkretni sledeći koraci."},
  {title:"DANINI Anfragebüro",desc:"Priprema i, nakon odobrenja, uvođenje jednog procesa: upit, kvalifikacija, CRM evidencija i nacrt odgovora.",output:"Rezultat: proverljiv tok sa ljudskim odobravanjem."},
  {title:"DANINI Office Betreuung",desc:"Praćenje, održavanje i unapređenje postojećih digitalnih procesa u dogovorenom obimu. Kontinuirana podrška prema individualnom dogovoru.",output:"Rezultat: kontrolisano održavanje i dokumentovana poboljšanja."}
];
---
<Base locale={locale} slug="business"
  title={de ? "DANINI Business — Geschäftsanfragen zwischen Balkan und Deutschland" : "DANINI Business — poslovni most između Balkana i Nemačke"}
  description={de ? "Unterstützung für Unternehmen vom Balkan: deutschsprachige Anfragen, Angebotsentwürfe, Lieferantenkommunikation und kontrollierte digitale Büroabläufe." : "Za firme sa Balkana: poslovni upiti, priprema ponuda i dokumentacije za nemačko tržište i kontrolisani digitalni tokovi."}>
  <section class="b-hero">
    <div class="wrap b-grid">
      <div>
        <p class="b-eyebrow">DANINI BUSINESS · DACH ↔ BALKAN</p>
        <h1>{de ? "Geschäfte mit Deutschland vorbereiten. Anfragen, Unterlagen und Antworten im Griff." : "Poslujete ili želite saradnju sa Nemačkom? Sredimo upite i dokumentaciju."}</h1>
        <p class="b-intro">{de ? "Sie führen ein Unternehmen auf dem Balkan und möchten mit deutschen Kunden, Einkäufern oder Lieferanten arbeiten? DANINI hilft, Anforderungen und Unterlagen zu strukturieren, Rückfragen zu klären und deutschsprachige Anfragen oder Angebotsentwürfe vorzubereiten. Sie prüfen und entscheiden vor jedem Versand." : "Vodite firmu na Balkanu i želite kupce, dobavljače ili partnere u Nemačkoj? DANINI pomaže da sredite zahteve, dokumentaciju i poslovnu komunikaciju, pripremite upit ili nacrt ponude na nemačkom i znate šta još nedostaje. Ništa se ne šalje bez vašeg odobrenja."}</p>
        <div class="b-actions">
          <a class="b-btn" href="#anfrage">{de ? "Geschäftsanfrage für Deutschland stellen" : "Pošalji poslovni zahtev za Nemačku"}</a>
          <a class="b-secondary" href={de ? "/de/danini-methode/" : "/sr/danini-metoda/"}>{de ? "Unsere Methode" : "Naša metoda"} →</a>
        </div>
        <p class="b-note">{de ? "Eine Anfrage ist keine Bestellung. Umfang, Verfügbarkeit und Preis klären wir vorab schriftlich." : "Slanje upita nije narudžbina. Obim, dostupnost i cenu potvrđujemo pisanim putem pre angažovanja."}</p>
      </div>
      <aside class="b-side">
        <span class="b-side-label">{de ? "BEISPIEL EINES ANFRAGEPROZESSES" : "PRIMER OBRADE POSLOVNOG UPITA"}</span>
        <ol>
          <li>{de ? "Anfrage erfassen" : "Prijem upita"}</li>
          <li>{de ? "Fehlende Angaben erkennen" : "Utvrđivanje podataka koji nedostaju"}</li>
          <li>{de ? "Antwortentwurf vorbereiten" : "Priprema nacrta odgovora"}</li>
          <li>{de ? "Menschlich prüfen und freigeben" : "Ljudska provera i odobrenje"}</li>
        </ol>
        <small>{de ? "Schematische Darstellung, keine Behauptung einer bereits vollautomatischen Leistung." : "Šematski prikaz, ne tvrdnja da je čitav proces već automatizovan."}</small>
      </aside>
    </div>
  </section>
  <section class="b-section">
    <div class="wrap">
      <p class="b-eyebrow">{de ? "KLARE LEISTUNGEN" : "JASNO DEFINISANE USLUGE"}</p>
      <h2>{de ? "Nicht nur übersetzen: Anforderungen klären, Unterlagen ordnen, Entscheidungen vorbereiten." : "Ne nudimo samo prevod: sređujemo zahtev, dokumenta i naredne korake saradnje."}</h2>
      <div class="b-cards">
        {offerings.map((offer,i)=>(
          <article class="b-card">
            <span class="b-number">0{i+1}</span>
            <h3>{offer.title}</h3>
            <p>{offer.desc}</p>
            <p class="b-output">{offer.output}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="b-section b-proof" aria-labelledby="business-demo-title">
    <div class="wrap b-demo-grid">
      <div>
        <p class="b-eyebrow">{de ? "BEISPIEL EINES ERGEBNISSES · FIKTIVER FALL" : "PRIMER REZULTATA · IZMIŠLJEN SLUČAJ"}</p>
        <h2 id="business-demo-title">{de ? "Was bekommt ein Unternehmen konkret?" : "Šta firma konkretno dobija?"}</h2>
        <p>{de ? "Beispiel: Ein Produktionsbetrieb vom Balkan möchte einem deutschen Einkäufer antworten. Vor einem Angebot fehlen Menge, Zeichnungsversion und Liefertermin. DANINI bereitet eine prüfbare Rückfrage und einen nächsten Schritt vor." : "Primer: proizvođač sa Balkana dobio je upit nemačkog kupca. Pre izrade ponude nedostaju količina, verzija tehničkog crteža i rok isporuke. DANINI priprema pregled nedostataka i nacrt odgovora na nemačkom."}</p>
        <a class="b-btn" href="#anfrage">{de ? "Eigenen Geschäftsfall schildern" : "Opiši svoj poslovni slučaj"}</a>
      </div>
      <div class="b-demo-document">
        <p class="b-demo-stamp">{de ? "DEMO · KEIN KUNDENPROJEKT" : "DEMO · NIJE STVARNI KLIJENT"}</p>
        <strong>{de ? "Anfrageakte: Zulieferer → DE-Einkauf" : "Dosije upita: dobavljač → kupac iz DE"}</strong>
        <div><span>{de ? "Vorliegend" : "Dostupno"}</span><b>{de ? "Produktbeschreibung, Ansprechpartner" : "Opis proizvoda, kontakt osoba"}</b></div>
        <div><span>{de ? "Offen" : "Nedostaje"}</span><b>{de ? "Menge, Zeichnungsversion, Liefertermin" : "Količina, verzija crteža, rok isporuke"}</b></div>
        <div><span>{de ? "Entwurf auf Deutsch" : "Nacrt na nemačkom"}</span><b>„Könnten Sie uns bitte die benötigte Menge, den aktuellen Zeichnungsstand und den gewünschten Liefertermin nennen?“</b></div>
        <div><span>{de ? "Nächster Schritt" : "Sledeći korak"}</span><b>{de ? "Entwurf durch den Auftraggeber prüfen lassen" : "Korisnik odobrava nacrt pre slanja"}</b></div>
        <small>{de ? "Illustratives Muster, keine zugesagte Leistung ohne individuelle Abstimmung." : "Ilustrativni prikaz, nije dokaz već isporučene usluge."}</small>
      </div>
    </div>
  </section>

  <section class="b-section b-extra">
    <div class="wrap b-extra-grid">
      <div>
        <p class="b-eyebrow">{de ? "ERGÄNZENDE B2B-UNTERSTÜTZUNG" : "DODATNA B2B PODRŠKA"}</p>
        <h2>{de ? "Geschäftsvorbereitung zwischen DACH und Balkan." : "Priprema poslovne saradnje između DACH regiona i Balkana."}</h2>
        <p>{de ? "Auf konkrete Anfrage unterstützen wir die strukturierte Vorbereitung von Lieferanten-/RFQ-Unterlagen sowie begrenzte CBAM- und Nachunternehmer-Dokumentation. Fachliche und rechtliche Prüfungen bleiben bei qualifizierten Stellen." : "Na konkretan zahtev pomažemo da se srede podaci o dobavljačima, RFQ zahtevi i ograničena priprema CBAM ili dokumentacije podizvođača. Stručne i pravne procene ostaju u nadležnosti kvalifikovanih lica."}</p>
      </div>
      <a class="b-extra-link" href="#anfrage">{de ? "Umfang anfragen" : "Zatražite procenu obima"} →</a>
    </div>
  </section>
  <section class="b-section b-extra" aria-labelledby="business-guides-heading"><div class="wrap"><h2 id="business-guides-heading">{de?"Wissen für Ihre Büroprozesse":"Vodiči za poslovne procese"}</h2><p>{de?"Ausführliche Praxisartikel zur strukturierten Anfragebearbeitung, Angebotsvorbereitung und Datenschutz.":"Praktični vodiči za rad sa upitima i administracijom."}</p><ul><li><a href={de?"/de/wissen/anfragemanagement-kleine-unternehmen/":"/sr/wissen/kundenanfragen/"}>{de?"Kundenanfragen strukturiert bearbeiten":"Organizacija poslovnih upita"}</a></li><li><a href={de?"/de/wissen/ki-angebotsvorbereitung/":"/sr/wissen/email-formular-crm/"}>{de?"KI-gestützte Angebotsvorbereitung":"E-mail, formular i CRM"}</a></li><li><a href={de?"/de/wissen/dsgvo-kundenanfragen-ki/":"/sr/wissen/ki-buero/"}>{de?"DSGVO bei Kundenanfragen und KI":"AI u kancelariji i ljudska kontrola"}</a></li></ul><a class="b-extra-link" href={`/${locale}/wissen/`}>{de?"Alle DANINI Ratgeber":"Svi DANINI vodiči"}</a></div></section>
  <BusinessContact locale={locale} />
</Base>
<style>
.b-hero{background:linear-gradient(125deg,#101e31,#12364b);color:#fff;padding:clamp(64px,7vw,100px) 0}
.b-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(300px,.8fr);align-items:center;gap:clamp(30px,5vw,80px)}
.b-eyebrow{font-size:.72rem;letter-spacing:.13em;font-weight:800;color:#0b7669}
.b-hero .b-eyebrow{color:#facc15}
.b-hero h1{color:#fff;font-size:clamp(2.7rem,5vw,4.9rem);letter-spacing:-.055em}
.b-intro{color:#d7e4ef;font-size:clamp(1.04rem,1.45vw,1.2rem)}
.b-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin:27px 0 15px}
.b-btn{display:inline-flex;justify-content:center;align-items:center;padding:16px 23px;min-height:53px;border-radius:10px;background:#facc15;color:#102238;font-weight:800;text-align:center}
.b-secondary{font-weight:800;color:#fff}
.b-note{color:#b4cbd7;font-size:.8rem}
.b-side{background:#ffffff12;border:1px solid #ffffff30;border-radius:20px;padding:clamp(25px,3vw,40px)}
.b-side-label{font-size:.72rem;color:#facc15;font-weight:800;letter-spacing:.1em}
.b-side ol{padding-left:27px;color:#fff;font-weight:700;line-height:1.8}
.b-side li{padding:10px 0;border-bottom:1px solid #ffffff20}
.b-side small{font-size:.78rem;line-height:1.5;color:#c9dce9;display:block;margin-top:18px}
.b-section{padding:clamp(64px,7vw,95px) 0;background:#f5f8fc}
.b-section h2{font-size:clamp(2rem,3.2vw,3.05rem);max-width:940px;color:#102238}
.b-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin-top:36px}
.b-card{background:#fff;border:1px solid #d7e2eb;border-radius:16px;padding:clamp(22px,3vw,34px);display:flex;flex-direction:column;min-width:0}
.b-number{color:#0f766e;font-weight:850;font-size:.9rem}
.b-card h3{font-size:1.5rem;color:#12243b;line-height:1.25;margin:22px 0 9px}
.b-card p{font-size:.9rem;color:#40546b}
.b-card .b-output{margin-top:auto;padding-top:22px;color:#165c60;font-weight:750}
.b-extra{background:white}
.b-extra-grid{display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center}
.b-extra-grid p:not(.b-eyebrow){max-width:840px;color:#40546b;line-height:1.75}
.b-extra-link{color:#085c54;font-weight:800}
.b-cta{background:#112236;color:white}
.b-cta h2{color:white}
.b-cta p{color:#c7d3df;max-width:750px}
@media(max-width:960px){.b-grid,.b-extra-grid{grid-template-columns:1fr}.b-cards{grid-template-columns:1fr}}
@media(max-width:600px){.b-actions .b-btn,.b-cta .b-btn{width:100%}.b-section{padding:55px 0}}

.b-proof{background:#eaf1f6}
.b-demo-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.95fr);gap:clamp(22px,4vw,60px);align-items:center}
.b-demo-grid>div>p:not(.b-eyebrow){color:#344b61;line-height:1.75}
.b-demo-document{background:#fff;border:1px solid #b7c9d7;border-radius:18px;padding:clamp(20px,3vw,30px);box-shadow:0 18px 42px #12243b12;display:grid;gap:12px}
.b-demo-document .b-demo-stamp{font-size:.72rem;color:#0b655c;font-weight:800;letter-spacing:.06em;margin:0}
.b-demo-document>strong{font-size:1.16rem;color:#132a3c}
.b-demo-document>div{display:grid;gap:5px;border-top:1px solid #dfe7ed;padding-top:12px}
.b-demo-document span{font-size:.73rem;font-weight:800;color:#365f63;text-transform:uppercase;letter-spacing:.04em}
.b-demo-document b{font-size:.9rem;color:#243b52;line-height:1.55;font-weight:600;overflow-wrap:anywhere}
.b-demo-document small{color:#51687c;line-height:1.5}
@media(max-width:900px){.b-demo-grid{grid-template-columns:1fr}}
</style>
