---
/** Small first-party icon set. Decorative by default; adjacent labels carry meaning. */
type IconName = "academy" | "business" | "car" | "document" | "search" | "shield" | "message" | "download" | "arrow";
const { name, size = 24 } = Astro.props as { name: IconName; size?: number };
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" class="danini-icon">
  {name === "academy" && <><path d="M3 9.5 12 5l9 4.5-9 4.5-9-4.5Z"/><path d="M7 11.5V16c3.1 2.5 6.9 2.5 10 0v-4.5"/><path d="M21 9.5V16"/></>}
  {name === "business" && <><rect x="3" y="7" width="18" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2"/></>}
  {name === "car" && <><path d="m5 11 2-5h10l2 5"/><path d="M4 11h16a2 2 0 0 1 2 2v5H2v-5a2 2 0 0 1 2-2Z"/><path d="M5 18v2h3v-2m8 0v2h3v-2M6 14h2m8 0h2"/></>}
  {name === "document" && <><path d="M6 2h8l4 4v16H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Z"/><path d="M14 2v5h5M8 12h8M8 16h8"/></>}
  {name === "search" && <><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></>}
  {name === "shield" && <><path d="M12 2 20 5v6c0 5-3.3 8.4-8 11-4.7-2.6-8-6-8-11V5l8-3Z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></>}
  {name === "message" && <><path d="M20 17a2 2 0 0 1-2 2H8l-4 3V5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12Z"/><path d="M8 9h8M8 13h6"/></>}
  {name === "download" && <><path d="M12 3v13m-5-5 5 5 5-5M4 18v3h16v-3"/></>}
  {name === "arrow" && <><path d="M4 12h16m-6-6 6 6-6 6"/></>}
</svg>
<style>
.danini-icon{display:inline-block;vertical-align:middle;flex:none;overflow:visible}
</style>
