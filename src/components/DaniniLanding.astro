---
import Base from "../layouts/Base.astro";
import type { Locale } from "../lib/content";
const { locale } = Astro.props as { locale: Locale };
const de = locale === "de";
const business = "/" + locale + "/business/";
const auto = "/" + locale + "/auto-check/";
const academy = "/" + locale + "/akademija/";
const method = de ? "/de/danini-methode/" : "/sr/danini-metoda/";
---
<Base locale={locale}
  title={de ? "DANINI Akademie — mit KI ein eigenes Online-Business entwickeln" : "DANINI Akademija — nauči da izgradiš online preduzeće uz AI"}
  description={de ? "DANINI vermittelt praxisnah, wie Sie mit KI eine Geschäftsidee prüfen und ein Online-Business entwickeln. Kostenlose erste Lektion mit praktischen Beispielen aus DANINI Business und AutoDanini." : "DANINI uči kako da uz AI proveriš poslovnu nišu i izgradiš online preduzeće. Besplatna prva lekcija i praktični primeri AutoDanini i DANINI Business."}>
  <section class="d-hero" aria-labelledby="danini-home-title">
    <div class="wrap d-hero-grid">
      <div>
        <p class="d-eyebrow">DANINI · DACH ↔ BALKAN · {de ? "KI-BUSINESS-AKADEMIE" : "AI EDUKACIJA I ONLINE BIZNIS"}</p>
        <h1 id="danini-home-title">{de ? "Mit KI ein eigenes Online-Business entwickeln. Schritt für Schritt." : "Nauči kako da uz AI izgradiš sopstveno online preduzeće."}</h1>
        <p class="d-lead">{de ? "Lernen Sie mit konkreten Übungen, wie Sie eine Nische prüfen, ein Angebot formulieren und KI für Recherche, Inhalte und Arbeitsabläufe nutzen. Unsere Praxisbeispiele: DANINI Business und AutoDanini. Keine Erfolgs- oder Einkommensgarantie." : "Kroz konkretne zadatke nauči da proveriš bilo koju poslovnu nišu, napraviš ponudu i koristiš AI za istraživanje, sadržaj i organizaciju. Kako to radimo pokazujemo kroz DANINI Business i AutoDanini — bez obećanja zarade."}</p>
        <div class="d-actions">
          <a class="d-btn primary" href={academy}>{de ? "Kostenlose erste KI-Lektion starten" : "Započni besplatnu AI lekciju"}</a>
          <a class="d-btn outline" href="#arbeitsbereiche">{de ? "Praxisprojekte ansehen" : "Pogledaj naše praktične primere"}</a>
        </div>
        <div class="d-hero-benefits" aria-label={de ? "Unsere Arbeitsprinzipien" : "Način rada"}>
          <span>{de ? "KI lernen und anwenden" : "Uči i primeni AI"}</span>
          <span>{de ? "Eigene Nische entwickeln" : "Razvij sopstvenu nišu"}</span>
          <span>{de ? "Echte Praxisbeispiele" : "Primeri iz prakse"}</span>
        </div>
        <p class="d-small">{de ? "Die Module 01–03 sind kostenlos verfügbar. Die Module 04–06 sind in Vorbereitung; der kostenpflichtige Gesamtkurs wird noch nicht angeboten." : "Moduli 01–03 su besplatni i dostupni. Moduli 04–06 su u pripremi; kompletan plaćeni kurs nije u prodaji."}</p>
      </div>
      <div class="d-visual" aria-label={de ? "DANINI Geschäftsbereiche" : "DANINI poslovne oblasti"}>
        <div class="d-visual-head"><span>DANINI / AI BUSINESS ACADEMY</span><span>DACH ↔ BALKAN</span></div>
        <div class="d-visual-title">{de ? "Ein Lernweg. Zwei Praxisbeispiele." : "Jedan sistem učenja. Dva primera iz prakse."}</div>
        <a class="d-visual-service d-visual-education" href={academy}>
          <span class="d-visual-icon" aria-hidden="true">00</span>
          <span><strong>DANINI AKADEMIJA</strong><small>{de ? "Nische → KI-Übung → überprüfbares Angebot" : "Niša → AI zadatak → proverljiva ponuda"}</small></span>
          <span class="d-visual-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="d-visual-service" href={business}>
          <span class="d-visual-icon" aria-hidden="true">01</span>
          <span><strong>DANINI BUSINESS</strong><small>{de ? "Anfrage → Einordnung → Antwortentwurf" : "Upit → analiza → nacrt odgovora"}</small></span>
          <span class="d-visual-arrow" aria-hidden="true">↗</span>
        </a>
        <a class="d-visual-service" href={auto}>
          <span class="d-visual-icon" aria-hidden="true">02</span>
          <span><strong>AUTODANINI</strong><small>{de ? "Inserat → Nachweise → Prüffragen" : "Oglas → dokumenta → pitanja"}</small></span>
          <span class="d-visual-arrow" aria-hidden="true">↗</span>
        </a>
        <div class="d-visual-foot"><span class="d-online-dot"></span>{de ? "Lernen, selbst umsetzen und an echten Projekten prüfen" : "Nauči, primeni i proveri na stvarnim projektima"}</div>
      </div>
    </div>
  </section>

  <section class="d-section d-education" aria-labelledby="academy-home-title">
    <div class="wrap d-education-grid">
      <div><p class="d-eyebrow">DANINI AKADEMIJA / {de?"HAUPTPRODUKT":"GLAVNI PROIZVOD"}</p>
      <h2 id="academy-home-title">{de?"Von der Geschäftsidee zum ersten prüfbaren Ergebnis.":"Od poslovne ideje do prvog proverljivog rezultata."}</h2>
      <p>{de?"Drei kostenlose Praxislektionen zeigen, wie Sie eine Nische eingrenzen, Marktsignale prüfen und ein konkretes Angebot erstellen. Mit kopierbaren KI-Prompts und ausdruckbaren Arbeitsblättern." : "Tri besplatne praktične lekcije pokazuju kako da izabereš nišu, proveriš tržišne signale i pripremiš konkretnu ponudu uz AI zadatke i radne sveske."}</p>
      <a class="d-education-cta" href={academy}>{de?"Mit Modul 01 beginnen":"Počni od modula 01"} ↗</a>
      <small>{de?"Sechs Themen geplant, aktuell drei kostenlose Praxislektionen verfügbar. Keine Kurs- oder Verdienstgarantie." : "Planirano šest oblasti; trenutno su dostupne tri besplatne praktične lekcije. Nema garancija zarade."}</small></div>
      <div class="d-education-preview"><span>01 / {de?"LERNEN":"UČENJE"}</span><strong>{de?"Nische":"Niša"}</strong><span>02 / {de?"PRÜFEN":"PROVERA"}</span><strong>{de?"Nachfrage":"Potreba"}</strong><span>03 / {de?"ENTWICKELN":"IZGRADNJA"}</span><strong>{de?"Erstes Angebot":"Prva ponuda"}</strong></div>
    </div>
  </section>
  <section id="arbeitsbereiche" class="d-section d-light">
    <div class="wrap">
      <p class="d-eyebrow">{de ? "UNSERE PRAXISBEISPIELE" : "NAŠI PRIMERI IZ PRAKSE"}</p>
      <h2>{de ? "Was Sie in der Akademie lernen, zeigen wir in unseren eigenen Projekten." : "Ono što učimo — pokazujemo kroz sopstvene projekte."}</h2>
      <div class="d-cards">
        <article class="d-card d-card-business">
          <div class="d-card-media d-business-media" aria-hidden="true">
            <div class="d-media-grid"></div><span>DANINI BUSINESS</span><strong>AI / OFFICE</strong><small>ANFRAGEN · KOMMUNIKATION · PROZESSE</small>
          </div>
          <span class="d-tag">01 / DANINI BUSINESS</span>
          <h3>{de ? "Kundenanfragen, deutsche Angebote, digitale Bürounterstützung." : "Nemački poslovni upiti, ponude i digitalna podrška."}</h3>
          <p>{de ? "Für kleine Unternehmen vom Balkan: Anfragen und Anforderungen deutscher Geschäftspartner ordnen, fehlende Angaben erkennen und deutschsprachige Antwort- und Angebotsentwürfe mit menschlicher Freigabe vorbereiten." : "Za firme sa Balkana: priprema upita, odgovora i dokumentacije za saradnju sa nemačkim kupcima ili dobavljačima, uz jasne korake i ljudsko odobrenje."}</p>
          <a href={business} aria-label={de ? "DANINI Business Anfrage starten" : "Pokreni DANINI Business upit"}>{de ? "Jetzt Business-Anfrage starten" : "Pokreni Business upit"} →</a>
        </article>
        <article class="d-card d-card-auto">
          <div class="d-card-media d-auto-media" aria-hidden="true">
            <img src="/images/DANINI_Kartica_01_Salon_Auto_Bez_Osobe.jpg" alt="" loading="lazy" decoding="async" width="960" height="560" />
            <span>AUTODANINI / FAHRZEUG-CHECK</span>
          </div>
          <span class="d-tag">02 / AUTODANINI</span>
          <h3>{de ? "Fahrzeugangebote vor Reise und Anzahlung prüfen." : "Proveri oglas pre putovanja i kapare."}</h3>
          <p>{de ? "Prüffragen, fehlende Nachweise und bekannte Kosten übersichtlich erfassen. Bei Bedarf eine unabhängige Prüfung anfragen." : "Pregled oglasnih podataka, nedostajućih dokaza i poznatih troškova. Po potrebi zahtev za nezavisni pregled."}</p>
          <a href={auto} aria-label={de ? "AutoDanini Fahrzeugangebot prüfen" : "AutoDanini provera oglasa"}>{de ? "Fahrzeugangebot jetzt prüfen" : "Proveri oglas vozila"} →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="d-section d-trust">
    <div class="wrap d-trust-grid">
      <div>
        <p class="d-eyebrow">{de ? "VERANTWORTLICHE KI" : "ODGOVORNA UPOTREBA AI"}</p>
        <h2>{de ? "Frag KI — KI fragt zurück." : "Pitaj AI — AI pita tebe!"}</h2>
        <p>{de ? "Keine unüberprüfbaren Versprechen: Wir kennzeichnen, was belegt, geschätzt oder noch offen ist. Unsere digitalen Werkzeuge ersetzen keine fachliche Fahrzeugprüfung oder Rechtsberatung." : "Bez neproverljivih obećanja: jasno označavamo potvrđene, procenjene i nepoznate podatke. Digitalni alati ne zamenjuju stručni pregled vozila ili pravno savetovanje."}</p>
      </div>
      <div class="d-trust-note">
        <strong>{de ? "Eine gemeinsame DANINI-Infrastruktur" : "Jedna zajednička DANINI infrastruktura"}</strong>
        <p>{de ? "Ein digitaler Einstieg für grenzüberschreitende Geschäftsfragen und Fahrzeugentscheidungen. Jeder Vorgang trennt Angaben, fehlende Nachweise und nächste Schritte." : "Jedna online ulazna tačka za posao i kupovinu vozila između Balkana i Nemačke: podatak, dokaz, otvoreno pitanje, naredni korak."}</p>
      </div>
    </div>
  </section>

  <section id="kontakt" class="d-section d-contact">
    <div class="wrap d-contact-grid">
      <div>
        <p class="d-eyebrow">{de ? "KONTAKT" : "KONTAKT"}</p>
        <h2>{de ? "Beschreiben Sie Ihr Anliegen." : "Opišite šta vam je potrebno."}</h2>
        <p>{de ? "Eine Nachricht ist noch kein Auftrag. Leistungsumfang und Preis werden vor einer Beauftragung individuell geklärt." : "Slanje poruke nije narudžbina. Obim usluge i cena dogovaraju se pre angažovanja."}</p>
      </div>
      <div class="d-contact-actions">
        <a class="d-btn primary" href={business + "#anfrage"}>{de ? "Business-Anfrage senden" : "Pošalji Business upit"}</a>
        <a class="d-btn outline" href={auto + "#contact"}>{de ? "Fahrzeugprüfung anfragen" : "Zatraži proveru vozila"}</a>
        <a class="d-email-link" href="mailto:info@daninihub.com?subject=DANINI%20-%20Anfrage">info@daninihub.com</a>
      </div>
    </div>
  </section>
</Base>
<style>
:global(html:has(.d-hero)),:global(body:has(.d-hero)){overflow-x:clip}
.d-visual-education{background:#facc151a;border-color:#facc1588}.d-education{background:#fff}.d-education-grid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(275px,.8fr);gap:50px;align-items:center}.d-education h2{font-size:clamp(2rem,3.4vw,3.15rem);color:#112c40}.d-education p{color:#425c6d;font-size:1.08rem}.d-education small{display:block;margin-top:14px;color:#5b7180}.d-education-cta{display:inline-flex;background:#0b5b61;color:#fff;font-weight:850;border-radius:10px;padding:15px 22px;margin-top:16px}.d-education-preview{border-radius:18px;background:linear-gradient(140deg,#12283c,#0b565b);padding:clamp(25px,4vw,45px);display:grid;grid-template-columns:1fr;gap:8px;box-shadow:0 20px 45px #0c273723}.d-education-preview span{font-size:.72rem;color:#e9d28c;font-weight:850;letter-spacing:.12em}.d-education-preview strong{font-size:clamp(1.6rem,2.8vw,2.7rem);color:#fff;margin-bottom:14px}@media(max-width:820px){.d-education-grid{grid-template-columns:1fr}.d-education-preview{max-width:620px}}
.d-hero{background:radial-gradient(ellipse at 80% 10%,#17526a 0%,transparent 42%),linear-gradient(128deg,#091523 0%,#102638 60%,#092329 100%);color:#f9fafb;padding:clamp(58px,7.5vw,112px) 0;position:relative;overflow:hidden}
.d-hero:before{content:"";position:absolute;inset:0;background-image:linear-gradient(#ffffff07 1px,transparent 1px),linear-gradient(90deg,#ffffff07 1px,transparent 1px);background-size:56px 56px;mask-image:linear-gradient(90deg,transparent,#000);pointer-events:none}
.d-hero .wrap{position:relative}
.d-hero-grid{display:grid;grid-template-columns:minmax(0,1.07fr) minmax(320px,.93fr);gap:clamp(32px,5vw,72px);align-items:center}
.d-hero-benefits{display:flex;flex-wrap:wrap;gap:9px;margin-top:25px}
.d-hero-benefits span{border:1px solid #7597a754;background:#ffffff0b;border-radius:999px;padding:8px 12px;color:#dce9f0;font-size:.76rem;font-weight:700}
.d-visual{background:linear-gradient(155deg,#162e42 0%,#0b1c2e 100%);border:1px solid #698ba45c;border-radius:23px;box-shadow:0 30px 85px #0006;padding:clamp(22px,3vw,36px);position:relative;overflow:hidden}
.d-visual:before{content:"";position:absolute;width:220px;height:220px;right:-110px;top:-100px;border:1px solid #35b3a64f;border-radius:50%;box-shadow:0 0 0 50px #1ca4940a;pointer-events:none}
.d-visual-head{display:flex;flex-wrap:wrap;gap:8px;justify-content:space-between;font-size:.61rem;font-weight:750;letter-spacing:.12em;color:#93c9d4}
.d-visual-title{font-size:clamp(1.5rem,2.1vw,2.2rem);font-weight:820;letter-spacing:-.045em;line-height:1.18;margin:35px 0 25px;color:#fff}
.d-visual-service{display:flex;align-items:center;gap:16px;background:#ffffff0c;border:1px solid #b3d6e029;border-radius:15px;margin-top:12px;padding:19px 16px;color:#fff;transition:background .15s ease,transform .15s ease}
.d-visual-service:hover,.d-visual-service:focus-visible{background:#ffffff1d;transform:translateY(-2px)}
.d-visual-icon{background:#facc15;color:#0a1c2b;border-radius:12px;width:43px;height:43px;flex:none;display:grid;place-items:center;font-weight:850;font-size:.8rem}
.d-visual-service strong,.d-visual-service small{display:block}.d-visual-service strong{font-size:.85rem;letter-spacing:.04em}.d-visual-service small{font-size:.72rem;color:#c3d4e0;margin-top:7px;line-height:1.4}
.d-visual-arrow{margin-left:auto;color:#facc15;font-size:1.25rem}
.d-visual-foot{display:flex;align-items:center;gap:9px;font-size:.72rem;color:#b9ced9;margin-top:24px}.d-online-dot{height:8px;width:8px;border-radius:50%;background:#4ade80;box-shadow:0 0 12px #4ade8080}
.d-eyebrow{font-size:.74rem;font-weight:800;letter-spacing:.13em;color:#0b7669;margin:0 0 18px}
.d-hero .d-eyebrow,.d-panel .d-eyebrow{color:#facc15}
.d-hero h1{overflow-wrap:anywhere;hyphens:auto;color:#fff;font-size:clamp(2.25rem,5.4vw,5.25rem);max-width:860px;margin:0 0 25px;letter-spacing:-.057em}
.d-lead{font-size:clamp(1.04rem,1.5vw,1.24rem);max-width:680px;line-height:1.76;color:#dce7f3}
.d-actions{display:flex;gap:12px;flex-wrap:wrap;margin:32px 0 21px}
.d-btn{display:inline-flex;min-height:54px;align-items:center;justify-content:center;padding:15px 23px;border-radius:11px;font-weight:800;font-size:.92rem;text-align:center}
.d-btn.primary{background:#facc15;color:#101e2f}
.d-btn.outline{border:1px solid #859fb1;color:#fff;background:#ffffff0a}
.d-small{font-size:.81rem;color:#b9cbd8;max-width:620px}
.d-panel{background:#ffffff0c;border:1px solid #7892a850;border-radius:22px;padding:clamp(26px,3vw,42px);box-shadow:0 24px 65px #050c153d}
.d-panel h2{font-size:clamp(1.65rem,2.3vw,2.25rem);line-height:1.24;color:#fff;margin:0 0 24px}
.d-flow{display:flex;gap:17px;padding:17px 0;border-top:1px solid #ffffff26;align-items:center}
.d-flow>span{background:#facc1526;color:#facc15;font-weight:800;border-radius:10px;padding:12px}
.d-flow div{display:grid;gap:6px}
.d-flow strong{font-size:.95rem}
.d-flow small{font-size:.8rem;color:#c3d3df}
.d-panel-link{display:inline-block;color:#facc15;font-weight:750;font-size:.9rem;margin-top:19px}
.d-section{padding:clamp(64px,7vw,94px) 0}
.d-light{background:#f5f8fb}
.d-section h2{font-size:clamp(2rem,3.5vw,3.15rem);color:#0f172a;max-width:780px}
.d-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;margin-top:35px}
.d-card-media{height:190px;margin:-1px -1px 27px;position:relative;overflow:hidden;border-radius:20px 20px 0 0;display:flex;flex-direction:column;align-items:flex-start;justify-content:flex-end;padding:22px;color:#fff}
.d-business-media{background:radial-gradient(circle at 80% 20%,#247e82,#0d2a42 56%,#092238)}
.d-business-media:after{content:"";position:absolute;right:12%;top:15%;width:130px;height:130px;border:1px solid #ffffff4a;border-radius:28px;transform:rotate(-18deg);box-shadow:0 0 0 26px #ffffff0a,0 0 0 50px #ffffff07}
.d-business-media>*{position:relative;z-index:1}
.d-business-media span,.d-auto-media span{font-size:.65rem;font-weight:850;letter-spacing:.14em;background:#081622b0;padding:7px 10px;border-radius:5px}
.d-business-media strong{font-size:2rem;letter-spacing:-.04em;margin-top:10px}.d-business-media small{font-size:.65rem;letter-spacing:.09em;color:#d4e5ee}
.d-auto-media{padding:20px}.d-auto-media:after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,#071623b8,transparent 65%)}
.d-auto-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.d-auto-media span{position:relative;z-index:1}

.d-card{background:#fff;border:1px solid #d4dfe8;border-radius:20px;padding:0 clamp(24px,3vw,37px) clamp(28px,3vw,38px);box-shadow:0 18px 44px #0f172a13;display:flex;flex-direction:column;min-width:0;overflow:hidden;transition:transform .15s ease,box-shadow .15s ease}
.d-card:hover{transform:translateY(-3px);box-shadow:0 25px 60px #0f172a21}
.d-tag{font-size:.72rem;color:#0b7669;font-weight:800;letter-spacing:.1em}
 .d-card h3{overflow-wrap:anywhere;hyphens:auto;color:#12243a;font-size:clamp(1.32rem,2vw,1.8rem);line-height:1.26}
.d-card p{color:#40556c;font-size:.96rem;flex:1}
.d-card a{display:inline-flex;align-items:center;align-self:flex-start;background:#0c6762;color:#fff;border-radius:9px;font-weight:800;margin-top:22px;padding:13px 16px;min-height:48px;font-size:.85rem}
.d-card a:hover,.d-card a:focus-visible{background:#084b47}
.d-trust{background:white}
.d-trust-grid{display:grid;grid-template-columns:1.1fr .8fr;gap:40px;align-items:center}
.d-trust-grid p{font-size:1rem;color:#40556c}
.d-trust-note{background:#edf4f7;border-left:4px solid #0b7669;border-radius:12px;padding:28px}
.d-trust-note strong{color:#102b3c}
.d-contact{background:#0f172a;color:#fff}
.d-contact-grid{display:grid;grid-template-columns:1fr auto;gap:35px;align-items:center}
.d-contact h2{color:#fff}
.d-contact p{color:#c1ccda}
.d-contact-actions{display:flex;align-items:center;justify-content:flex-end;gap:12px;flex-wrap:wrap;max-width:620px}
.d-contact-actions .d-email-link{color:#e4edf7;font-weight:730;text-decoration:underline;text-underline-offset:4px}
.d-contact-actions .d-btn.outline{border-color:#a7b8c5}
@media(max-width:900px){.d-hero-grid,.d-trust-grid{grid-template-columns:1fr}.d-panel{max-width:720px}.d-contact-grid{grid-template-columns:1fr}}
@media(max-width:600px){.d-cards{grid-template-columns:1fr}.d-hero{padding-top:54px}.d-btn{width:100%}.d-contact-grid .d-btn{width:100%}.d-section{padding:58px 0}.d-visual{padding:21px}.d-visual-title{margin:24px 0 18px}.d-card-media{height:170px}.d-hero-benefits span{font-size:.7rem}}
@media(prefers-reduced-motion:reduce){.d-visual-service,.d-card{transition:none}}
</style>
