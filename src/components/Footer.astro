---
import type { Locale } from "../lib/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isDe = locale === "de";
const legalLinks = [
  { href: `/${locale}/impressum/`, label: "Impressum" },
  { href: `/${locale}/datenschutz/`, label: isDe ? "Datenschutz" : "Privatnost" },
  { href: `/${locale}/agb/`, label: isDe ? "AGB" : "Uslovi" },
];
---

<footer>
  <div class="wrap">
    <div>
      <b>DANINI</b>
      <p class="micro">
        {isDe
          ? "© 2026 DANINI. Alle Rechte vorbehalten."
          : "© 2026 DANINI. Sva prava zadržana."}
      </p>
    </div>
    <nav aria-label={isDe ? "Rechtliche Informationen" : "Pravne informacije"}>
      {legalLinks.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href="mailto:info@daninihub.com">info@daninihub.com</a>
    </nav>
  </div>
</footer>
