---
import type { Locale } from "../lib/content";
import {daniniBrandLogo} from "../lib/danini-brand-logo";
import {originalEvergreen} from "../lib/original-evergreen";
import {srBusinessEvergreen} from "../lib/sr-business-evergreen";
interface Props { locale: Locale; slug?: string; }
const { locale, slug = "" } = Astro.props;
const isDe = locale === "de";
const home = "/" + locale + "/";
const altSlug = (language: "de" | "sr") => {
  if (["ueber-danini", "o-danini"].includes(slug)) return language === "de" ? "ueber-danini" : "o-danini";
  if (["danini-methode", "danini-metoda"].includes(slug)) return language === "de" ? "danini-methode" : "danini-metoda";
  if ([...originalEvergreen,...srBusinessEvergreen].some(a => "wissen/" + a.slug === slug && a.locale !== language)) return "wissen";
  return slug;
};
const navItems = [
  { href: home, label: isDe ? "Startseite" : "Početna", active: !slug },
  { href: home + "akademija/", label: isDe ? "DANINI Akademie" : "DANINI Akademija", active: slug === "akademija" },
  { href: home + "business/", label: "DANINI Business", active: slug === "business" },
  { href: home + "auto-check/", label: "AutoDanini", active: slug === "auto-check" },
  { href: home + "wissen/", label: isDe ? "Wissen & Ratgeber" : "Vodiči i saveti", active: slug.startsWith("wissen") },
  { href: home + (isDe ? "danini-methode/" : "danini-metoda/"), label: isDe ? "Unsere Methode" : "Naša metoda", active: ["danini-methode", "danini-metoda"].includes(slug) },
  { href: home + (isDe ? "ueber-danini/" : "o-danini/"), label: isDe ? "Über DANINI" : "O DANINI", active: ["ueber-danini", "o-danini"].includes(slug) },
  { href: home + "#kontakt", label: "Kontakt", active: false }
];
---
<header>
  <div class="wrap nav danini-header">
    <a class="brand" href={home} aria-label={isDe ? "DANINI — Startseite" : "DANINI — Početna"}>
      <span class="brand-lockup"><img class="brand-logo" src={daniniBrandLogo} width="360" height="120" alt="DANINI" decoding="async" /><small>AI EDUKACIJA · BUSINESS · AUTO</small></span>
    </a>
    <nav class="business-nav" aria-label={isDe ? "Hauptnavigation" : "Glavna navigacija"}>
      {navItems.map(item => <a href={item.href} aria-current={item.active ? "page" : undefined}>{item.label}</a>)}
    </nav>
    <div class="lang" aria-label={isDe ? "Sprache" : "Jezik"}>
      {(["de","sr"] as const).map(language => (
        <a href={"/" + language + "/" + (altSlug(language) ? altSlug(language) + "/" : "")}
          lang={language} aria-current={language === locale ? "page" : undefined}>{language.toUpperCase()}</a>
      ))}
    </div>
  </div>
</header>
<style>
.danini-header{max-width:1480px;min-height:91px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:clamp(13px,1.9vw,27px);align-items:center}
.danini-header .brand{display:flex;gap:11px;align-items:center;min-width:0;color:#f4f8fc;font-weight:820;font-size:1.33rem;letter-spacing:.08em}
.danini-header .brand .brand-lockup{display:flex;flex-direction:column;align-items:center;width:clamp(170px,17vw,222px);min-width:0}
.danini-header .brand .brand-logo{display:block;width:100%;height:auto;aspect-ratio:3/1;object-fit:contain;background:transparent;border:0;border-radius:0;padding:0;box-shadow:none;flex:none;filter:invert(1) hue-rotate(180deg);mix-blend-mode:screen}
.danini-header .brand small{display:block;font-size:.46rem;letter-spacing:.02em;color:#aec4cf;margin-top:3px;white-space:nowrap;text-align:center}
.danini-header .business-nav{display:flex;gap:clamp(9px,1.2vw,22px);align-items:center;justify-content:center;min-width:0;margin:0}
.danini-header .business-nav a{color:#e8f1f6;white-space:nowrap;display:inline-flex;min-height:44px;align-items:center;font-size:.78rem;font-weight:680;line-height:1.3}
.danini-header .business-nav a:hover,.danini-header .business-nav a:focus-visible{color:#facc15}
.danini-header .business-nav a[aria-current="page"]{color:#facc15;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:6px}
.danini-header .lang{display:flex;gap:4px;margin:0;border-left:1px solid #344859;padding-left:12px;flex-shrink:0}
.danini-header .lang a{display:grid;place-items:center;min-width:33px;min-height:38px;border-radius:7px;color:#dbe7ee;font-size:.76rem;font-weight:800}
.danini-header .lang [aria-current]{background:#105954;color:#fff;text-decoration:none}
:global(header:has(.danini-header)){background:#0b1928;border-bottom:1px solid #294154}
@media(max-width:1439px){
 .danini-header{grid-template-columns:1fr auto;row-gap:7px;padding-block:14px}
 .danini-header .business-nav{grid-column:1/-1;grid-row:2;width:100%;padding-top:10px;border-top:1px solid #294154;display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:6px}
 .danini-header .business-nav a{white-space:normal;justify-content:center;text-align:center;padding:8px 4px}
 .danini-header .lang{grid-column:2;grid-row:1}
}
@media(min-width:701px) and (max-width:980px){.danini-header .business-nav{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:700px){
 .danini-header .brand{font-size:1.12rem}
 .danini-header .brand .brand-lockup{width:clamp(135px,36vw,180px)}
 .danini-header .brand small{font-size:.41rem}
 .danini-header .business-nav{grid-template-columns:repeat(3,minmax(0,1fr))}
 .danini-header .business-nav a{background:#15293b;border:1px solid #2b4254;border-radius:8px;font-size:.76rem;min-height:44px}
}
@media(max-width:390px){.danini-header .business-nav{grid-template-columns:repeat(2,minmax(0,1fr))}.danini-header .brand small{font-size:.38rem}}
</style>
