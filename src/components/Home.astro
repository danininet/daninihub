---
import Base from "../layouts/Base.astro";
import type { Locale } from "../lib/content";
const { locale = "de" } = Astro.props as { locale: Locale };
const de = locale === "de";
---
<Base
  locale={locale}
  title={de ? "Auto aus Deutschland sicherer kaufen — KI-Berater und Fahrzeugprüfung" : "Kupovina automobila iz Nemačke — AI Savetnik i provera vozila"}
  description={de ? "Inserat prüfen lassen, Fragen klären und eine unabhängige Vor-Ort-Prüfung anfragen. Keine Garantie für ein risikofreies Fahrzeug." : "Proverite oglas, razjasnite rizike i zatražite proveru automobila na terenu. Bez obećanja o kupovini bez rizika."}
>
  <section class="auto-hero">
    <div class="wrap auto-hero-grid">
      <div class="auto-hero-copy">
        <span class="eyebrow">AUTODANINI · {de ? "FAHRZEUGKAUF MIT KLAREN FAKTEN" : "KUPOVINA VOZILA UZ PROVERLJIVE PODATKE"}</span>
        <h1>{de ? "Fahrzeugkauf in Deutschland. Klar prüfen, sicherer entscheiden." : "Automobil iz Nemačke. Proveri pre nego što kupiš."}</h1>
        <p class="auto-lead">{de ? "Sie haben ein Inserat gefunden? Wir helfen, offene Fragen sichtbar zu machen, Dokumente zu prüfen und eine Vor-Ort-Prüfung anzufragen." : "Pronašao si oglas? Prođi kroz tri ključne provere, saznaj šta nedostaje i zatraži nezavisan pregled vozila pre kupovine."}</p>
        <div class="actions">
          <a class="button" href="#ai-savetnik">{de ? "Inserat jetzt prüfen" : "Proveri oglas sada"}</a>
          <a class="button secondary" href="#provera-na-terenu">{de ? "Vor-Ort-Prüfung anfragen" : "Zatraži pregled na terenu"}</a>
        </div>
        <p class="micro auto-hero-note">{de ? "Klare Prüffragen statt falscher Versprechen. Ein Inserat allein ist kein Fahrzeugnachweis." : "Jasna pitanja i provere, bez lažnih garancija. Oglas nije dokaz o stanju vozila."}</p>
      </div>
      <div class="auto-hero-panel" aria-label={de ? "Drei Schritte zur informierten Kaufentscheidung" : "Tri koraka do informisane odluke"}>
        <span class="eyebrow">{de ? "SO LÄUFT IHRE PRÜFUNG" : "KAKO IZGLEDA PROVERA"}</span><h2 class="auto-panel-title">{de ? "Drei Schritte. Eine klarere Entscheidung." : "Tri koraka. Sigurnija odluka."}</h2>
        <div class="auto-panel-step"><span>01</span><div><strong>{de ? "Inserat erfassen" : "Unesi oglas"}</strong><small>{de ? "Link, FIN oder Anzeigentext" : "Link, VIN ili tekst oglasa"}</small></div></div>
        <div class="auto-panel-step"><span>02</span><div><strong>{de ? "Risiken eingrenzen" : "Razjasni rizike"}</strong><small>{de ? "Drei konkrete Prüffragen" : "Tri konkretna pitanja"}</small></div></div>
        <div class="auto-panel-step"><span>03</span><div><strong>{de ? "Nächsten Schritt wählen" : "Izaberi sledeći korak"}</strong><small>{de ? "Dokumente, Kosten, Besichtigung" : "Dokumenta, troškovi, pregled"}</small></div></div>
        <p class="auto-panel-bottom">{de ? "Keine automatische Fahrzeuggarantie. Sie behalten die Kontrolle." : "Bez automatskih garancija. Odluka ostaje tvoja."}</p>
      </div>
    </div>
  </section>

  <div class="auto-benefits"><div class="wrap auto-benefits-inner"><span>{de ? "KLARE FRAGEN" : "JASNA PITANJA"}</span><span>{de ? "KEINE VERSTECKTEN SCHRITTE" : "BEZ SKRIVENIH KORAKA"}</span><span>{de ? "ENTSCHEIDUNG BLEIBT BEI IHNEN" : "ODLUKA JE TVOJA"}</span></div></div>

  <section id="ai-savetnik" class="auto-advisor">
    <div class="wrap">
      <div class="auto-advisor-box">
        <div class="auto-section-number">01 / {de ? "IHRE FAHRZEUGANGABEN" : "PODACI O VOZILU"}</div>
        <span class="eyebrow">{de ? "SCHRITT 1 · INSERAT / FIN" : "KORAK 1 · OGLAS / VIN"}</span>
        <h2>{de ? "Starten Sie mit Ihrem Inserat." : "Počni od svog oglasa."}</h2>
        <p>{de ? "Fügen Sie einen Link von einem beliebigen deutschen Autoportal oder Kleinanzeigenmarkt (z. B. mobile.de, Kleinanzeigen, Quoka, lokale Händler) ein — alternativ FIN oder kopierten Anzeigentext." : "Zalepite link bilo kog nemačkog oglasnika (mobile.de, Kleinanzeigen, Quoka, lokalni oglasi) ili unesite VIN odnosno kopirani opis automobila."}</p>
        <form class="auto-advisor-form" id="universal-advisor-form" data-locale={locale}>
          <label for="vehicle-source">{de ? "Inseratslink, FIN oder Anzeigentext" : "Link oglasa, VIN ili tekst opisa"}</label>
          <textarea id="vehicle-source" name="source" required maxlength="6000" rows="4" placeholder={de ? "Link eines beliebigen Inserats (mobile.de, Kleinanzeigen...) oder FIN / Beschreibung einfügen..." : "Zalepite link bilo kog oglasnika (mobile.de, Kleinanzeigen...) ili unesite VIN / opis automobila..."} autocomplete="off" aria-describedby="source-privacy" ></textarea>
          <p id="source-privacy" class="micro">{de ? "Keine Ausweisbilder, Telefonnummern, Adressen oder Zahlungsdaten einfügen. Die Eingabe bleibt bei dieser Vorprüfung im Browser." : "Ne unosite slike dokumenata, brojeve telefona, adrese ni podatke za plaćanje. Unos za ovu preliminarnu proveru ostaje u pregledaču."}</p>
          <div class="auto-advisor-controls">
            <button class="button" type="submit">{de ? "Weiter zur 3-Fragen-Prüfung" : "Nastavi na 3 pitanja"}</button>
          </div>
        </form>
        <div class="auto-risk-result" id="universal-risk-result" hidden role="status" aria-live="polite">
          <h3 id="universal-risk-heading"></h3>
          <p id="universal-risk-summary"></p>
          <ul id="universal-risk-list"></ul>
          <p class="micro">{de ? "Dies ist eine vorsorgliche Checkliste, keine KI-Analyse, Betrugserkennung oder Prüfung des Verkäufers." : "Ovo je preventivna kontrolna lista, ne AI analiza, otkrivanje prevare niti provera prodavca."}</p>
          <a class="button secondary" href="#contact">{de ? "Persönliche Prüfung anfragen" : "Zatraži ličnu proveru"}</a>
        </div>
        <p class="micro">{de ? "Die Eingabe öffnet den KI-Berater mit drei Prüffragen und einer Risikomatrix. Es erfolgt kein automatischer Abruf oder eine unabhängige Prüfung von Inseraten." : "Unos otvara AI Savetnika sa tri pitanja i matricom rizika. Sadržaj oglasa se ne preuzima niti nezavisno proverava automatski."}</p>
      </div>
    </div>
  </section>

  <section class="section white auto-process" aria-labelledby="auto-steps-title">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{de ? "SO FUNKTIONIERT ES" : "KAKO FUNKCIONIŠE"}</span>
        <h2 id="auto-steps-title">{de ? "Drei Schritte statt Bauchgefühl." : "Tri koraka umesto nagađanja."}</h2>
      </div>
      <div class="auto-steps">
        <article><b>01</b><h3>{de ? "Inserat ansehen" : "Pregled oglasa"}</h3><p>{de ? "Fahrzeugdaten, Verkäuferangaben und offene Fragen sammeln." : "Prikupljamo podatke o vozilu, tvrdnje prodavca i otvorena pitanja."}</p></article>
        <article><b>02</b><h3>{de ? "Risiken dokumentieren" : "Dokumentovanje rizika"}</h3><p>{de ? "Widersprüche und fehlende Nachweise kennzeichnen. Keine automatische Garantie." : "Obeležavamo neslaganja i dokaze koji nedostaju. Bez automatskih garancija."}</p></article>
        <article><b>03</b><h3>{de ? "Fahrzeug prüfen lassen" : "Provera vozila"}</h3><p>{de ? "Auf Wunsch eine unabhängige Prüfung am Standort abstimmen." : "Po zahtevu dogovaramo nezavisnu proveru na lokaciji."}</p></article>
      </div>
    </div>
  </section>

  <section class="section auto-inspection" id="provera-na-terenu">
    <div class="wrap auto-inspection-grid">
      <div>
        <span class="eyebrow">{de ? "SCHRITT 2 · PRÜFUNG VOR ORT" : "KORAK 2 · PROVERA NA TERENU"}</span>
        <h2>{de ? "Ein Inserat ist kein technischer Prüfbericht." : "Oglas nije izveštaj o tehničkom stanju."}</h2>
        <p>{de ? "Lassen Sie eine Prüfung am Standort anfragen. Umfang, Verfügbarkeit und Kosten werden vor einer Beauftragung persönlich bestätigt." : "Zatražite pregled vozila na lokaciji. Obim usluge, dostupnost i cena potvrđuju se pre angažovanja."}</p>
      </div>
      <div><a class="button" href="#contact">{de ? "Vor-Ort-Prüfung anfragen" : "Zatraži pregled na terenu"}</a></div>
    </div>
  </section>

  <section class="section white auto-contact-section" id="contact">
    <div class="wrap auto-contact">
      <span class="eyebrow">{de ? "KONTAKT" : "KONTAKT"}</span>
      <h2>{de ? "Fahrzeugprüfung persönlich abstimmen." : "Dogovorite proveru vozila."}</h2>
      <p>{de ? "Senden Sie uns den Inseratslink und den gewünschten Prüfungsort. Wir melden uns mit den nächsten Schritten." : "Pošaljite link oglasa i mesto gde se vozilo nalazi. Javićemo vam naredne korake."}</p>
      <a class="button" href="mailto:info@daninihub.com?subject=AutoDanini%20-%20Fahrzeugpruefung">info@daninihub.com</a>
    </div>
  </section>

  <section class="auto-storage" aria-labelledby="storage-title">
    <div class="wrap">
      <span class="eyebrow">DANINI · {de ? "WEITERE ANGEBOTE" : "OSTALE OBLASTI"}</span>
      <h2 id="storage-title">{de ? "DANINI für Geschäftspartner" : "DANINI za poslovne partnere"}</h2>
      <div class="auto-storage-grid">
        <div><strong>{de ? "Marketplace / Auktionen" : "Marketplace / Aukcije"}</strong><p>{de ? "Angebot für Geschäftspartner in Vorbereitung." : "Ponuda za poslovne partnere u pripremi."}</p></div>
        <div><strong>{de ? "Digitale Produkte" : "Digitalni proizvodi"}</strong><p>{de ? "Zusätzliche Werkzeuge und Informationen." : "Dodatni alati i informacije."}</p></div>
        <div><strong>DANINI Business (B2B)</strong><p>{de ? "Weitere Geschäftsdienstleistungen" : "Dodatne poslovne usluge"}</p><a href={de ? "/de/danini-methode/" : "/sr/danini-metoda/"}>{de ? "Mehr erfahren" : "Saznajte više"} →</a></div>
      </div>
    </div>
  </section>
</Base>

<style>
/* AutoDanini customer experience — scoped to this component and its Astro children */
.auto-hero{position:relative;isolation:isolate;overflow:hidden;background:linear-gradient(120deg,#f5f9fd 0%,#edf4f9 55%,#e3edf5 100%);padding:clamp(54px,7vw,112px) 0 clamp(64px,7vw,105px)}
.auto-hero:before{content:"";position:absolute;right:-13%;top:-42%;width:52vw;height:52vw;max-width:900px;max-height:900px;border-radius:50%;border:1px solid #b1c8d9;box-shadow:0 0 0 60px #dceaf43d,0 0 0 120px #dceaf422;pointer-events:none;z-index:-1}
.auto-hero-grid{display:grid;grid-template-columns:minmax(0,1.13fr) minmax(345px,.87fr);gap:clamp(35px,6vw,94px);align-items:center}
.auto-hero-copy{min-width:0}
.auto-hero .eyebrow{color:#0d7669;letter-spacing:.16em;font-size:.74rem;font-weight:800}
.auto-hero h1{max-width:820px;font-size:clamp(2.9rem,5vw,5.6rem);font-weight:820;line-height:1.08;letter-spacing:-.065em;color:#0f172a;margin:24px 0}
.auto-hero .auto-lead{max-width:680px;font-size:clamp(1.08rem,1.55vw,1.3rem);line-height:1.75;color:#334155;margin:0}
.auto-hero .actions{gap:13px;margin:33px 0 20px}
.auto-hero .button,.auto-advisor .button,.auto-inspection .button,.auto-contact .button{border-radius:12px;font-size:.94rem;min-height:56px;padding:15px 26px;font-weight:780;box-shadow:0 10px 28px #0f766e15;transition:transform .15s ease, box-shadow .15s ease}
.auto-hero .button:hover,.auto-advisor .button:hover,.auto-inspection .button:hover,.auto-contact .button:hover{transform:translateY(-2px);box-shadow:0 14px 30px #0f766e25}
.auto-hero .button:not(.secondary){background:#0b7669;color:white}
.auto-hero .button.secondary{background:#fff;color:#142338;border:1.5px solid #aebfce}
.auto-hero .auto-hero-note{font-size:.81rem;max-width:600px;color:#536779}
.auto-hero-panel{background:linear-gradient(155deg,#14283d 0%,#0b1728 100%);color:white;border:1px solid #314359;border-radius:26px;padding:clamp(29px,3vw,46px);box-shadow:0 32px 70px #0c1c302f;position:relative}
.auto-hero-panel:before{content:"";position:absolute;top:-13px;right:32px;width:90px;height:6px;border-radius:6px;background:#facc15}
.auto-hero-panel .eyebrow{color:#9fe7dc;font-size:.7rem}
.auto-hero-panel .auto-panel-title{font-size:clamp(1.45rem,2vw,2rem);font-weight:750;line-height:1.22;letter-spacing:-.035em;color:#f9fafb;margin:14px 0 18px}
.auto-panel-step{display:grid;grid-template-columns:48px 1fr;gap:16px;align-items:center;border-top:1px solid #ffffff23;padding:18px 0}
.auto-panel-step span{display:grid;place-items:center;height:46px;width:46px;border-radius:13px;background:#ffffff12;color:#facc15;font-weight:800;font-size:.9rem}
.auto-panel-step div{display:flex;flex-direction:column;gap:5px}
.auto-panel-step strong{font-size:1.02rem;font-weight:750;color:#fff;line-height:1.4}
.auto-panel-step small{font-size:.82rem;color:#cbd5e1;line-height:1.4}
.auto-hero-panel .auto-panel-bottom{font-size:.8rem;color:#d4e0ec;margin:18px 0 0;line-height:1.65}
.auto-benefits{background:#0f2434;border-top:1px solid #223d53;border-bottom:1px solid #223d53}
.auto-benefits-inner{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;padding-top:19px;padding-bottom:19px;text-align:center}
.auto-benefits span{font-size:.7rem;font-weight:800;letter-spacing:.14em;color:#c6e9e3}
.auto-advisor{padding:clamp(48px,6vw,92px) 0;background:#f2f6fa;scroll-margin-top:16px}
.auto-advisor-box{position:relative;display:block;max-width:1080px;margin:0 auto;border-radius:24px;border:1px solid #d8e2ec;background:white;padding:clamp(28px,5vw,65px);box-shadow:0 28px 70px #1c314414}
.auto-section-number{position:absolute;right:clamp(28px,5vw,65px);top:27px;color:#0f766e;font-size:.7rem;letter-spacing:.14em;font-weight:800}
.auto-advisor-box .eyebrow{color:#0f766e}
.auto-advisor-box h2{font-size:clamp(2rem,3.4vw,3.2rem);max-width:780px;color:#102235;line-height:1.14;margin:18px 0}
.auto-advisor-box > p{max-width:770px;color:#40546a;font-size:1rem;line-height:1.75}
.auto-advisor-form{margin-top:30px}
.auto-advisor-form label{display:block;font-size:.94rem;font-weight:750;color:#17273c;margin:0 0 13px}
.auto-advisor-form textarea{width:100%;min-height:164px;padding:21px 24px;border:2px solid #9cb3c5;border-radius:15px;color:#0f172a;background:#fbfdff;font-size:1rem;line-height:1.6;resize:vertical;transition:border-color .15s ease,box-shadow .15s ease}
.auto-advisor-form textarea:focus{border-color:#0f766e;box-shadow:0 0 0 4px #0f766e20}
.auto-advisor-form textarea::placeholder{color:#52677a;opacity:1}
.auto-advisor-form #source-privacy{font-size:.8rem;margin:12px 0 19px}
.auto-advisor-controls{display:flex;justify-content:flex-start}
.auto-advisor-controls .button{background:#0f766e;color:#fff;min-width:290px}
.auto-advisor-box > .micro:last-child{font-size:.78rem;border-top:1px solid #e2e8f0;padding-top:21px;margin-top:27px}
.auto-risk-result{margin-top:30px;padding:26px;border:1px solid #cbd5e1;border-left:5px solid #eab308;border-radius:15px;background:#f8fafc;color:#17273c}
.auto-risk-result[hidden]{display:none}
.auto-risk-result h3{font-size:1.3rem;color:#0f172a}
.auto-risk-result p,.auto-risk-result li{color:#334155}
.auto-risk-result li{line-height:1.6;margin:9px 0}
.auto-process{background:#fff;padding:clamp(65px,7vw,100px) 0}
.auto-process .section-head{text-align:center;margin:0 auto 44px}
.auto-process .section-head .eyebrow{color:#0f766e}
.auto-process .section-head h2{color:#0f172a;font-size:clamp(2rem,3.5vw,3.2rem)}
.auto-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.auto-steps article{background:#f6f9fc;border:1px solid #d7e1ea;border-radius:19px;padding:clamp(24px,3vw,38px);min-width:0;box-shadow:0 10px 25px #16263c08}
.auto-steps article b{display:grid;place-items:center;width:49px;height:49px;border-radius:13px;background:#d4f1e8;color:#0d7669;font-weight:800}
.auto-steps article h3{font-size:clamp(1.12rem,1.5vw,1.4rem);line-height:1.3;color:#142338;margin:22px 0 10px}
.auto-steps article p{font-size:.92rem;line-height:1.75;color:#40546a;margin:0}
.auto-inspection{background:#0f2434;padding:clamp(60px,6vw,94px) 0;scroll-margin-top:20px}
.auto-inspection-grid{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(240px,.7fr);gap:65px;align-items:center}
.auto-inspection h2{font-size:clamp(2rem,3.2vw,3.2rem);line-height:1.15;color:#fff;max-width:770px}
.auto-inspection p{font-size:1.03rem;line-height:1.75;color:#d4e0ea;max-width:800px}
.auto-inspection .eyebrow{color:#9fe7dc}
.auto-inspection .button{background:#facc15;color:#172033}
.auto-contact-section{background:#fff;padding:clamp(72px,7vw,110px) 0}
.auto-contact{text-align:center;max-width:900px}
.auto-contact .eyebrow{color:#0f766e}
.auto-contact h2{color:#0f172a;font-size:clamp(2.2rem,3.7vw,3.6rem);line-height:1.12;max-width:860px;margin:22px auto}
.auto-contact p{color:#465a6e;max-width:700px;margin:0 auto;font-size:1.02rem}
.auto-contact .button{margin-top:31px;background:#0f766e;color:#fff;font-size:1rem}
.auto-storage{background:#edf3f8;border-top:1px solid #d6e1ea;padding:48px 0 65px}
.auto-storage .eyebrow{color:#0f766e}
.auto-storage h2{color:#17273c;font-size:clamp(1.5rem,2.4vw,2.05rem);margin:10px 0 23px}
.auto-storage-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
.auto-storage-grid>div{border:1px solid #d3dee8;border-radius:14px;background:#fff;padding:22px}
.auto-storage-grid strong{display:block;color:#17273c;font-size:.95rem;margin-bottom:10px}
.auto-storage-grid p{font-size:.86rem;color:#52677a;margin:0 0 8px}
.auto-storage-grid a{font-size:.85rem;font-weight:750;text-decoration:underline;color:#0f766e}
@media(max-width:980px){.auto-hero-grid{grid-template-columns:1fr;gap:38px}.auto-hero-copy{max-width:800px}.auto-hero-panel{max-width:850px}.auto-inspection-grid{grid-template-columns:1fr;gap:24px}}
@media(max-width:730px){.auto-hero{padding:48px 0 58px}.auto-hero h1{font-size:clamp(2.45rem,8.6vw,3.5rem)}.auto-benefits-inner{grid-template-columns:1fr;gap:10px;padding-block:22px}.auto-steps,.auto-storage-grid{grid-template-columns:1fr}.auto-process .section-head{text-align:left}.auto-inspection{padding-block:60px}.auto-advisor-box{padding:28px 23px}.auto-section-number{position:static;margin-bottom:16px}.auto-advisor-controls .button{width:100%;min-width:0}.auto-hero .actions{display:grid;grid-template-columns:1fr}.auto-hero .button{width:100%}.auto-contact .button{max-width:100%}}
@media(prefers-reduced-motion:reduce){.auto-hero .button,.auto-advisor .button,.auto-inspection .button,.auto-contact .button{transition:none}}
</style>

<script>
  // Client-side guidance only: neither fetches third-party sites nor submits user data.
  const form = document.getElementById("universal-advisor-form") as HTMLFormElement | null;
  const textarea = document.getElementById("vehicle-source") as HTMLTextAreaElement | null;
  const result = document.getElementById("universal-risk-result");
  const heading = document.getElementById("universal-risk-heading");
  const summary = document.getElementById("universal-risk-summary");
  const list = document.getElementById("universal-risk-list");
  if (form && textarea && result && heading && summary && list) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const value = textarea.value.trim();
      if (!value) { textarea.focus(); return; }
      // One-tab handoff; avoid exposing listing text and VIN in URL or server logs.
      let transferred = false;
      try {
        sessionStorage.setItem("danini-advisor-source-v1", value.slice(0, 6000));
        transferred = true;
      } catch { /* Browser storage disabled: continue with local checklist. */ }
      if (transferred) {
        window.location.assign(form.dataset.locale === "de" ? "/de/ai-savetnik/" : "/sr/ai-savetnik/");
        return;
      }
      const vin = /^[A-HJ-NPR-Z0-9]{17}$/i.test(value);
      const match = value.match(/https?:\/\/[^\s<>"']+/i);
      let url: URL | null = null;
      if (match) {
        try {
          const parsed = new URL(match[0]);
          if (parsed.protocol === "https:" || parsed.protocol === "http:") url = parsed;
        } catch { /* Treat as copied text */ }
      }
      const host = url?.hostname.toLowerCase().replace(/^www\./, "") || "";
      const classified = vin ? "vin" : url ? "link" : "text";
      const marketplace = !!host && (host === "kleinanzeigen.de" || host.endsWith(".kleinanzeigen.de") || host === "quoka.de" || host.endsWith(".quoka.de"));
      const privateOrUnknown = !vin && (marketplace || classified === "text" || (classified === "link" && !/(^|\.)(mobile\.de|autoscout24\.de)$/.test(host)));
      const de = form.dataset.locale === "de";
      const questionsDe = [
        "FIN am Fahrzeug mit Zulassungsbescheinigung Teil I und Teil II abgleichen; Fahrzeugidentität und Berechtigung zur Veräußerung unabhängig prüfen.",
        "Verkäuferidentität und Verfügungsberechtigung klären; bei fremdem Namen Vollmacht und Eigentumskette prüfen.",
        "HU-Bericht, Wartungsbelege, Laufleistung, Unfallschäden und offene Finanzierung anhand unabhängiger Nachweise prüfen.",
        "Keine Anzahlung, Ausweiskopie oder Zahlungsdaten nur auf Basis des Inserats versenden; sichere Übergabe und Zahlung vereinbaren.",
        "Vor dem Kauf unabhängige Besichtigung und Diagnose vereinbaren."
      ];
      const questionsSr = [
        "Uporediti VIN na vozilu sa saobraćajnom dozvolom i dokumentima vozila (Zulassungsbescheinigung Teil I i II); nezavisno proveriti identitet vozila i pravo prodaje.",
        "Proveriti identitet prodavca i ovlašćenje za prodaju; ako vozilo nije na njegovo ime, tražiti dokaz o ovlašćenju i vlasništvu.",
        "Tražiti TÜV/HU izveštaj, servisnu istoriju, dokaze o kilometraži, udesima i eventualnom finansiranju.",
        "Ne uplaćivati avans niti slati lična dokumenta samo na osnovu oglasa; dogovoriti bezbedno plaćanje i primopredaju.",
        "Organizovati nezavisni fizički pregled i dijagnostiku pre kupovine."
      ];
      heading.textContent = de ? "Checkliste zur Kaufvorbereitung" : "Kontrolna lista pre kupovine";
      summary.textContent = de
        ? (privateOrUnknown
          ? "Kleinanzeige, lokaler Anbieter oder kopierter Text: Verkäuferstatus und Eigentumsnachweise sind unklar. Zusätzliche Identitäts- und Dokumentenprüfung empfohlen. Die Plattform allein belegt keinen Betrug."
          : "Auch auf großen Portalen und bei FIN-Eingaben müssen Angaben unabhängig überprüft werden. Keine automatische Auswertung durchgeführt.")
        : (privateOrUnknown
          ? "Mali oglas, lokalni izvor ili kopirani tekst: status prodavca i dokumentacija nisu potvrđeni. Preporučena je dodatna provera identiteta i vlasništva. Sama platforma nije dokaz prevare."
          : "I kod velikih platformi ili unosa VIN-a podaci zahtevaju nezavisnu proveru. Automatska analiza nije izvršena.");
      list.replaceChildren();
      for (const text of de ? questionsDe : questionsSr) {
        const li = document.createElement("li");
        li.textContent = text;
        list.appendChild(li);
      }
      result.hidden = false;
      result.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  }
</script>
