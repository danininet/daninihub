---
import Base from "../layouts/Base.astro";
import Intake from "./Intake.astro";
import ClarityCheck from "./ClarityCheck.astro";
import { content, type Locale } from "../lib/content";
const { locale = "de" } = Astro.props as { locale: Locale };
const c = content[locale];
---

<Base
  locale={locale}
  title={
    locale === "de"
      ? "DANINI — Digitale Unternehmensunterstützung DACH und Balkan"
      : "DANINI — Digitalna poslovna podrška DACH i Balkan"
  }
  description={c.intro}
>
  <div class="wrap">
    <section class="hero">
      <div>
        <span class="eyebrow">{c.eyebrow}</span>
        <h1>
          {locale === "de" ? "Ihr Vorhaben verdient eine klare Entscheidung." : "Od pravog pitanja do jasne odluke."}
          <span class="accent hero-line">{locale === "de" ? "Mit DANINI." : "Uz DANINI."}</span>
        </h1>
        <p class="intro">{locale === "de" ? "Wir verbinden Unternehmen zwischen DACH und Balkan: Informationen klären, Geschäftspartner vorbereiten und administrative Aufgaben nachvollziehbar bearbeiten. Digitale Systeme unterstützen — wichtige Entscheidungen treffen Menschen." : "Povezujemo firme iz DACH regiona i Balkana: razjašnjavamo informacije, pripremamo poslovne kontakte i uređujemo administrativne zadatke. Digitalni sistemi pomažu — važne odluke donose ljudi."}</p>
        <div class="actions">
          <a class="button" href="#contact">
            {c.cta} ↗
          </a>
          <a class="button secondary" href={locale === "de" ? "/de/danini-methode/" : "/sr/danini-metoda/"}>{locale === "de" ? "Unsere Arbeitsweise" : "Kako radimo"} ↗</a>
        </div>
        <p class="micro">
          {locale === "de"
            ? "Für Unternehmen · DE / SR · Klar vereinbarter Leistungsumfang"
            : "Za preduzeća · DE / SR · Jasno dogovoren obim usluge"}
        </p>
      </div>
      <div
        class="visual"
        role="img"
        aria-label={
          locale === "de"
            ? "Drei dokumentationsbasierte Leistungen verbinden DACH und Balkan"
            : "Tri oblasti pripreme dokumentacije povezuju DACH i Balkan"
        }
      >
        <div class="visual-head">
          <span>DANINI / BUSINESS OPERATIONS</span>
          <span>DE · AT · CH</span>
        </div>
        <div class="bridge">
          <strong>DACH</strong>
          <span></span>
          <strong>BALKAN</strong>
        </div>
        <div class="visual-agent-label">{locale === "de" ? "UNSER NACHVOLLZIEHBARER ARBEITSABLAUF" : "NAŠ PROVERLJIVI NAČIN RADA"}</div>
        <div class="workflow-preview">
          <span>{locale === "de" ? "Anliegen" : "Upit"}</span><span>→</span>
          <span>{locale === "de" ? "Prüfen" : "Provera"}</span><span>→</span>
          <span>{locale === "de" ? "Freigabe" : "Odobrenje"}</span>
        </div>
        {c.cards.map((v) => (
          <div class="visual-row">
            <b>{v.num}</b>
            <strong>{v.title}</strong>
          </div>
        ))}
        <div class="visual-foot">
          {locale === "de"
            ? "Strukturierte Daten → Menschliche Prüfung"
            : "Strukturirani podaci → Ljudska provera"}
        </div>
      </div>
    </section>
  </div>
  <div class="strip">
    <div class="wrap">
      <span>
        {locale === "de" ? "Klare Leistungsgrenzen" : "Jasne granice usluge"}
      </span>
      <span>
        {locale === "de"
          ? "Zweisprachige Zusammenarbeit"
          : "Dvojezična saradnja"}
      </span>
      <span>
        {locale === "de" ? "Freigabe durch Menschen" : "Ljudsko odobrenje"}
      </span>
    </div>
  </div>
  <section class="master-teaser" aria-labelledby="master-teaser-title">
    <div class="wrap master-teaser-inner">
      <div><span class="eyebrow">DANINI OS · {locale === "de" ? "METHODE" : "METODA"}</span>
        <h2 id="master-teaser-title">{locale === "de" ? "Frag KI — KI fragt zurück." : "Pitaj AI — AI pita tebe!"}</h2>
        <p>{locale === "de" ? "Nicht irgendeine Antwort. Erst die richtigen Fragen, dann Fakten, Optionen und eine menschliche Entscheidung. Unsere regelbasierte Vorbereitung ist von freigabepflichtigen, noch nicht aktivierten KI-Funktionen getrennt." : "Ne bilo kakav odgovor. Najpre prava pitanja, zatim činjenice, opcije i ljudska odluka. Priprema zasnovana na pravilima odvojena je od AI funkcija koje još nisu odobrene za rad."}</p></div>
      <div class="master-teaser-action"><a class="button" href={locale === "de" ? "/de/danini-methode/" : "/sr/danini-metoda/"}>{locale === "de" ? "Die sechs Schritte ansehen" : "Pogledajte šest koraka"} ↗</a><a class="link" href={locale === "de" ? "/de/ueber-danini/" : "/sr/o-danini/"}>{locale === "de" ? "Über DANINI" : "O DANINI"} ↗</a></div>
    </div>
  </section>
  <section class="section white" id="services">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.services}</span>
        <h2>{c.lead}</h2>
        <p>{c.sub}</p>
      </div>
      <div class="cards">
        {c.cards.map((v) => (
          <article class="card">
            <span class="number">{v.num} / DANINI</span>
            <h3>{v.title}</h3>
            <b class="micro">{v.short}</b>
            <p>{v.text}</p>
            <ul>
              {v.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
            <a class="link" href={`/${locale}/${v.id}/`}>
              {locale === "de"
                ? "Leistungsumfang ansehen"
                : "Pogledajte obim usluge"}{" "}
              ↗
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section" id="process">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">{c.process}</span>
        <h2>
          {locale === "de"
            ? "Vom Vorhaben zur Arbeitsgrundlage."
            : "Od namere do pregledne dokumentacije."}
        </h2>
      </div>
      <div class="process-grid">
        {c.flow.map((v, i) => (
          <div class="step">
            <span>0{i + 1}</span>
            <h3>{v}</h3>
            <p>{c.flowText[i]}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section dark">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">DANINI OS · ASSISTED OPERATIONS</span>
        <h2>{c.ai}</h2>
        <p>{c.aiText}</p>
        <p class="micro">{locale === "de" ? "Heute: regelbasierte Zuordnung und vorbereitete Prüf- und Freigabeschritte. Generative KI und erweiterte Dokumentenannahme sind derzeit nicht aktiv." : "Danas: razvrstavanje po pravilima i pripremljeni koraci za proveru i odobravanje. Generativni AI i napredni prijem dokumenata trenutno nisu aktivni."}</p>
        <a
          class="button secondary"
          href={`/${locale}/ai-transparenz/`}
          style="color:white"
        >
          {locale === "de" ? "Transparenz ansehen" : "Kako koristimo AI"} ↗
        </a>
      </div>
      <div>
        <div class="pill">
          01 /{" "}
          {locale === "de"
            ? "Strukturierte Informationen"
            : "Strukturirane informacije"}
        </div>
        <div class="pill">
          02 /{" "}
          {locale === "de" ? "Nachvollziehbare Entwürfe" : "Proverljivi nacrti"}
        </div>
        <div class="pill">
          03 /{" "}
          {locale === "de"
            ? "Freigabe vor dem finalen Bericht"
            : "Odobrenje pre završnog izveštaja"}
        </div>
        <p class="micro">{c.boundary}</p>
      </div>
    </div>
  </section>
  <ClarityCheck locale={locale} />
  <section class="section" id="contact">
    <div class="wrap two-col">
      <div>
        <span class="eyebrow">{c.contact}</span>
        <h2>{c.formTitle}</h2>
        <p>{c.formText}</p>
        <p>
          <a href="mailto:info@daninihub.com">info@daninihub.com ↗</a>
        </p>
      </div>
      <Intake locale={locale} />
    </div>
  </section>
  <div class="wrap">
    <div class="auto-banner">
      <div>
        <b>AutoDanini · by DANINI</b>
        <p>
          {locale === "de"
            ? "Fahrzeugsuche, Kaufvorbereitung und unabhängige Prüfung."
            : "Pretraga vozila, priprema kupovine i nezavisna provera."}
        </p>
      </div>
      <a class="button secondary" href="/auto/">
        AutoDanini ↗
      </a>
    </div>
  </div>
</Base>
