---
import { content, type Locale } from "../lib/content";
const { locale = "de" } = Astro.props as { locale: Locale };
const c = content[locale];
---

<form class="form" id="intake" data-locale={locale}>
  <div class="form-grid">
    <label class="field">
      {c.name}
      <input name="name" autocomplete="name" required maxlength="100" />
    </label>
    <label class="field">
      {c.company}
      <input
        name="company"
        autocomplete="organization"
        required
        maxlength="160"
      />
    </label>
    <label class="field">
      {c.email}
      <input
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="254"
      />
    </label>
    <label class="field">
      {c.country}
      <select name="country">
        <option value="DE">Deutschland</option>
        <option value="AT">Österreich</option>
        <option value="CH">Schweiz</option>
      </select>
    </label>
    <label class="field full">
      {c.area}
      <select name="vertical">
        {c.cards.map((v) => (
          <option value={v.id}>{v.title}</option>
        ))}
      </select>
    </label>
    <label class="field full">
      {c.message}
      <textarea
        name="message"
        required
        minlength="20"
        maxlength="4000"
      ></textarea>
    </label>
    <p class="notice full">{c.notice}</p>
    <label class="check full">
      <input name="consent" type="checkbox" required />
      <span>
        {c.consent}{" "}
        <a href={`/${locale}/datenschutz/`}>
          {locale === "de" ? "Datenschutz" : "Privatnost"}
        </a>
      </span>
    </label>
    <div id="captcha" class="full"></div>
    <button class="button full" type="submit" disabled>
      {c.send} ↗
    </button>
    <div
      class="status full"
      role="status"
      aria-live="polite"
      id="form-status"
    ></div>
  </div>
</form>
<script>
  import "../lib/intake-client";
</script>
