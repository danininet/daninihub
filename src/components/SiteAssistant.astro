---
import type {Locale} from "../lib/content";
const {locale} = Astro.props as {locale:Locale};
const de=locale==="de";
---
<aside class="da-root" data-danini-assistant data-language={locale} aria-label={de?"DANINI KI-Berater":"DANINI AI mentor"}>
  <button class="da-toggle" id="danini-assistant-toggle" type="button" aria-expanded="false" aria-controls="danini-assistant-panel">
    <span class="da-dot" aria-hidden="true">?</span><span>{de?"DANINI KI fragen":"Pitaj DANINI AI"}</span>
  </button>
  <section class="da-panel" id="danini-assistant-panel" role="region" aria-label={de?"DANINI Hilfeassistent":"DANINI AI pomoćnik"} hidden>
    <header class="da-head">
      <div><strong>DANINI AI Asistent</strong><small>{de?"Hilfe zu DANINI und Ihrer eigenen Geschäftsidee":"Pomoć za DANINI i tvoju poslovnu ideju"}</small></div>
      <button class="da-close" type="button" id="danini-assistant-close" aria-label={de?"Hilfe schließen":"Zatvori pomoć"}>×</button>
    </header>
    <div class="da-content">
      <p class="da-start">{de?"Stellen Sie Fragen zur gesamten DANINI-Website oder zum Aufbau Ihres eigenen Online-Unternehmens. Für eingeloggte Testnutzer ist ein Projekt auf Wunsch auswählbar. Kostenlose KI-Kapazität ist begrenzt.":"Pitaj bilo šta o DANINI sajtu ili izgradnji svog online preduzeća: kupci, ponuda, tržište, SEO, prodaja i sledeći koraci. Prijavljeni test korisnici mogu izabrati svoj projekat. AI je ograničen besplatnom kvotom."}</p>
      <button type="button" class="da-local" id="danini-assistant-local">{de?"Aktuelles Feld erklären (kostenlos)":"Objasni izabrano polje (besplatno)"}</button>
      <label class="da-label" for="danini-assistant-question">{de?"Was möchten Sie für Ihr Unternehmen klären?":"Šta želiš da razradiš za svoj biznis?"}</label>
      <textarea id="danini-assistant-question" rows="3" maxlength="620" placeholder={de?"Z. B. Wie validiere ich meine Geschäftsidee ohne Budget?":"Npr. kako da proverim potražnju i napravim prvu ponudu?"}></textarea>
      <div class="da-project-box">
        <label class="da-label" for="danini-assistant-project">{de?"Mein eigenes Projekt (freiwillig)":"Moj projekat (opciono)"}</label>
        <select id="danini-assistant-project" aria-describedby="danini-assistant-project-notice">
          <option value="">{de?"Ohne Projektdaten fragen":"Pitaj bez podataka projekta"}</option>
        </select>
        <p id="danini-assistant-project-notice" class="da-privacy">{de?"Nur bei Anmeldung und ausdrücklicher Projektauswahl fließen Ihre eigenen Projektschritte in diese eine KI-Frage ein.":"Samo ako si prijavljen i izričito izabereš projekat, njegovi sačuvani koraci biće poslati AI za taj odgovor."}</p>
        <button type="button" class="da-refresh" id="danini-assistant-project-reload">{de?"Meine Projekte laden":"Učitaj moje projekte"}</button>
      </div>
      <div class="da-dialog" id="danini-assistant-history" role="log" aria-label={de?"Bisheriger Dialog":"Dosadašnji razgovor"} aria-live="polite"></div>
      <p class="da-privacy">{de?"Formularwerte werden nicht automatisch gelesen. Nur Ihre Frage, die letzten Dialogschritte und ein explizit ausgewähltes Projekt werden an KI übertragen. Keine Ausweis-, Karten- oder vertraulichen Angaben.":"Sadržaj formulara se ne čita automatski. AI dobija tvoje pitanje, poslednje poruke i samo projekat koji sam izabereš. Ne šalji lične dokumente, kartice ili poslovne tajne."}</p>
      <div id="danini-assistant-captcha" class="da-captcha"></div>
      <button type="button" class="da-ai" id="danini-assistant-ask" hidden>{de?"KI-Antwort anfordern":"Zatraži AI odgovor"}</button>
      <p id="danini-assistant-status" role="status" aria-live="polite" class="da-status"></p>
      <button type="button" class="da-retry" id="danini-assistant-retry" hidden>{de?"KI-Verbindung erneut prüfen":"Ponovo proveri AI vezu"}</button>
      <div id="danini-assistant-reply" aria-live="polite" class="da-reply"></div>
      <p id="danini-assistant-note" class="da-note"></p>
      <p class="da-support">{de?"Bei Bestellungen, Erstattung und sensiblen Fragen:":"Za narudžbine, povraćaj i osetljiva pitanja:"} <a href="mailto:info@daninihub.com">info@daninihub.com</a></p>
    </div>
  </section>
</aside>
<script is:inline src="/js/danini-site-assistant.js" defer></script>
<style>
.da-root{position:fixed;right:max(16px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));z-index:80;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#12263a}
.da-root button{cursor:pointer;font:inherit}
.da-toggle{display:flex;align-items:center;gap:9px;border:1px solid #0b726d;background:#08665e;color:white;border-radius:100px;padding:13px 18px;font-size:.85rem;font-weight:800;box-shadow:0 14px 30px #0416214d}
.da-toggle:focus-visible,.da-root :is(button,textarea,a):focus-visible{outline:3px solid #facc15;outline-offset:3px}
.da-dot{display:grid;place-items:center;border:1.5px solid currentColor;border-radius:50%;font-size:.9rem;width:21px;height:21px}
.da-panel{position:absolute;bottom:calc(100% + 12px);right:0;width:min(390px,calc(100vw - 26px));max-height:min(78vh,720px);overflow-y:auto;overscroll-behavior:contain;background:#fff;border:1px solid #b5ccd5;border-radius:17px;box-shadow:0 23px 65px #04162162}
.da-panel[hidden]{display:none!important}
.da-head{padding:16px 18px;background:#102a3c;color:#fff;display:flex;justify-content:space-between;gap:10px;align-items:center}
.da-head strong{display:block;font-size:1.03rem}.da-head small{display:block;font-size:.75rem;color:#dfebf4;margin-top:3px}
.da-close{border:1px solid #b5cbd8;border-radius:8px;background:#173d53;color:#fff;padding:2px 10px;font-size:1.5rem}
.da-content{padding:17px;display:grid;gap:12px}
.da-start,.da-privacy,.da-note,.da-support{font-size:.81rem;line-height:1.55;color:#365368;margin:0}
.da-label{font-size:.85rem;font-weight:800}
.da-content textarea{width:100%;min-height:75px;background:#fafcfd;color:#142b3d;border:1.5px solid #7896a9;border-radius:9px;padding:11px;font-size:.9rem;line-height:1.5;resize:vertical}
.da-content .da-local,.da-content .da-ai{padding:12px 13px;border:0;border-radius:9px;min-height:44px;font-weight:800}
.da-local{background:#e7f2f1;color:#084b47;border:1px solid #9ac5bd!important}
.da-ai{background:#0b7166;color:white}
.da-ai[hidden]{display:none}
.da-project-box{display:grid;gap:7px;border:1px solid #d0e0e3;border-radius:9px;padding:10px}
.da-project-box select{max-width:100%;background:#fff;color:#18364d;padding:9px;border:1px solid #7896a9;border-radius:8px;font:inherit}
.da-refresh{padding:7px 10px;border:1px solid #477d86;border-radius:8px;background:white;color:#0b5c61;font-size:.8rem}
.da-dialog{display:grid;gap:9px;max-height:240px;overflow-y:auto}
.da-dialog:empty{display:none}
.da-turn{padding:9px 11px;border-radius:9px;white-space:pre-wrap;overflow-wrap:anywhere;font-size:.84rem;line-height:1.5}
.da-turn-user{background:#e6f2f4;color:#173548}
.da-turn-assistant{background:#f2f8f9;color:#19374b}
.da-retry{background:#fff;color:#0b5c61;border:1px solid #477d86;border-radius:8px;min-height:40px;padding:8px 12px;font-weight:750}
.da-retry[hidden]{display:none!important}
.da-ai:disabled{opacity:.6;cursor:wait}
.da-captcha{min-height:0}
.da-status{min-height:15px;color:#365368;font-size:.81rem;line-height:1.4;margin:0}
.da-reply{background:#f2f8f9;padding:13px;border-radius:9px;line-height:1.6;font-size:.9rem;white-space:pre-wrap;overflow-wrap:anywhere}
.da-reply:empty{display:none}.da-note:empty{display:none}
.da-support{border-top:1px solid #d1e0e7;padding-top:12px}
.da-support a{color:#095e60;font-weight:750}
@media(max-width:550px){.da-root{right:10px;bottom:max(10px,env(safe-area-inset-bottom))}.da-toggle{padding:12px 15px;font-size:.78rem}.da-panel{width:calc(100vw - 20px);max-height:74vh}}
@media print{.da-root{display:none!important}}
</style>
