---
import "../styles/global.css";
import type { Locale } from "../lib/content";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title: string;
  description: string;
  locale: Locale;
  slug?: string;
  noindex?: boolean;
}
const { title, description, locale, slug = "", noindex = false } = Astro.props;
const canonical = new URL(
  `/${locale}/${slug ? slug + "/" : ""}`,
  "https://daninihub.com",
);
const isDe = locale === "de";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} | DANINI</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0F172A" />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow"} />
    <link rel="canonical" href={canonical} />
    {["de", "sr"].map((l) => (
      <link
        rel="alternate"
        hreflang={l}
        href={`https://daninihub.com/${l}/${slug ? slug + "/" : ""}`}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={`https://daninihub.com/de/${slug ? slug + "/" : ""}`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={`${title} | DANINI`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isDe ? "de_DE" : "sr_RS"} />
  </head>
  <body>
    <a class="skip" href="#main">
      {isDe ? "Zum Inhalt" : "Pređi na sadržaj"}
    </a>
    <Header locale={locale} slug={slug} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
