---
import Base from "../../layouts/Base.astro";
const locale = Astro.params.locale as "de" | "sr";
export function getStaticPaths() {
 return ["de","sr"].map(locale => ({params:{locale}}));
}
const de=locale==="de";
const questions=de?[
 ["Liegt ein Herkunfts- und Eigentumsnachweis vor?","Nachweis vorhanden","Nicht belegt"],
 ["Stimmen FIN und Fahrzeugdokumente überein?","Abgeglichen","Widerspruch / unklar"],
 ["Sind Wartung, Laufleistung und Schäden dokumentiert?","Dokumentiert","Nachweis fehlt"]
]:[
 ["Postoji li dokaz o poreklu i pravu prodaje?","Dokaz postoji","Nije dokazano"],
 ["Da li se VIN i dokumenta vozila podudaraju?","Upoređeno","Neslaganje / nejasno"],
 ["Postoji li dokumentovana servisna i štetna istorija?","Dokumentovano","Dokaz nedostaje"]
];
---
<Base locale={locale} slug="ai-savetnik"
 title={de?"KI-Berater — Fahrzeugkauf vorbereiten":"AI Savetnik — priprema kupovine vozila"}
 description={de?"Drei Fragen und dokumentierte Prüfpunkte vor dem Autokauf.":"Tri pitanja i kontrolne tačke pre kupovine automobila."}>
 <section class="section advisor-page" data-advisor data-locale={locale}>
  <div class="wrap advisor-wrap">
   <span class="eyebrow">AUTODANINI · {de?"KI-BERATER":"AI SAVETNIK"}</span>
   <h1>{de?"Ihr Auto. Ihre Fragen. Ein klarer Prüfweg.":"Tvoj automobil. Tri pitanja. Jasnija odluka."}</h1>
   <p class="advisor-lead">{de?"Erfassen Sie das Inserat, beantworten Sie drei konkrete Fragen und sehen Sie offene Risiken und bekannte Kosten auf einen Blick. Keine automatische Auswertung externer Verkaufsportale.":"Unesi oglas, odgovori na tri konkretna pitanja i pogledaj šta treba dodatno proveriti i koliko iznose poznati troškovi. Bez automatskog čitanja oglasnika."}</p>
   <div class="advisor-grid">
    <section class="advisor-panel">
     <h2>01 / {de?"Fahrzeugangaben":"Podaci o vozilu"}</h2>
     <label for="listing">{de?"Inserat / FIN / kopierter Text":"Oglas / VIN / kopirani tekst"}</label>
     <textarea id="listing" maxlength="6000" rows="6" placeholder={de?"Inserat aus beliebiger Quelle, FIN oder Beschreibung":"Oglas sa bilo koje platforme, VIN ili opis vozila"}></textarea>
     <p id="vehicle-identifier" class="source-preview">—</p>
     <p class="micro">{de?"Die Übergabe erfolgt nur innerhalb dieser Browser-Sitzung. Kein automatischer Abruf externer Portale.":"Podaci se prenose samo u okviru ove sesije pregledača. Nema automatskog otvaranja oglasnika."}</p>
     <div class="advisor-warning">
      <strong>{de?"Zusätzliche Prüfpunkte":"Dodatne tačke provere"}</strong>
      <p id="source-caution">{de?"Verkäuferstatus und Eigentum sind nicht bestätigt.":"Status prodavca i vlasništvo nisu potvrđeni."}</p>
      <ul>
       <li>{de?"Verkäuferidentität und Berechtigung zur Veräußerung prüfen":"Proveriti identitet prodavca i pravo prodaje"}</li>
       <li>{de?"Zulassungsbescheinigung Teil I/II und FIN abgleichen":"Uporediti Zulassungsbescheinigung Teil I/II i VIN"}</li>
       <li>{de?"Kein Vorschuss ohne unabhängige Besichtigung":"Bez avansa pre nezavisnog pregleda"}</li>
      </ul>
     </div>
    </section>
    <section class="advisor-panel">
     <h2>02 / {de?"KI fragt nach":"AI pita tebe"}</h2>
     {questions.map((q,i)=>(
      <article data-question={i} class="advisor-question">
       <h3>{i+1}. {q[0]}</h3>
       <div class="answer-grid">
        <button type="button" data-answer="confirmed" aria-pressed="false">{q[1]}</button>
        <button type="button" data-answer={i===1?"critical":"missing"} aria-pressed="false">{q[2]}</button>
       </div>
      </article>
     ))}
    </section>
    <section class="advisor-panel">
     <h2>03 / {de?"Risikomatrix":"Matrica rizika"}</h2>
     {[0,1,2].map(i=>(<div class="advisor-risk" data-risk-row={i}><i class="dot neutral"></i><span data-risk-label>{de?"Ungeprüft":"Nije provereno"}</span></div>))}
     <p id="advisor-status" role="status" aria-live="polite"></p>
     <details><summary>{de?"Kostenübersicht":"Pregled troškova"}</summary>
      <p>{de?"Unverbindliche Summe nur aus Ihren eingetragenen Euro-Beträgen. Nicht erfasste Steuern und Gebühren sind nicht enthalten.":"Neobavezujući zbir iznosa koje sami unesete u evrima. Nepoznati porezi i dažbine nisu uključeni."}</p>
      <div class="advisor-costs" id="advisor-costs">
        <label for="cost-price">{de?"Kaufpreis (€)":"Cena vozila (€)"}</label><input id="cost-price" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" placeholder="0,00" />
        <label for="cost-transport">{de?"Transport (€)":"Prevoz (€)"}</label><input id="cost-transport" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" placeholder="0,00" />
        <label for="cost-fees">{de?"Steuern / Abgaben (nur bekannter Betrag, €)":"Porezi / dažbine (samo poznat iznos, €)"}</label><input id="cost-fees" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" placeholder="0,00" />
        <label for="cost-check">{de?"Fahrzeugprüfung (€)":"Pregled vozila (€)"}</label><input id="cost-check" type="number" min="0" max="10000000" step="0.01" inputmode="decimal" placeholder="0,00" />
        <output id="cost-total" aria-live="polite">{de?"Beträge eingeben":"Unesite iznose"}</output>
      </div>
     </details>
     <form id="advisor-contact" class="advisor-contact" onsubmit="return false">
      <label for="advisor-name">{de?"Name":"Ime"}</label><input id="advisor-name" required maxlength="90" autocomplete="name" />
      <label for="advisor-email">E-mail</label><input id="advisor-email" required type="email" maxlength="254" autocomplete="email" />
      <label class="advisor-check"><input type="checkbox" id="advisor-consent" required /> {de?"Ich stimme der Verarbeitung meiner Angaben zur Beantwortung dieser Anfrage zu.":"Saglasan/saglasna sam sa obradom podataka radi odgovora na upit."}</label>
      <a href={`/${locale}/datenschutz/`}>{de?"Datenschutz":"Privatnost"}</a>
     </form>
     <div id="advisor-turnstile"></div>
     <button id="advisor-cta" class="button" type="button" disabled>{de?"Manuelle Prüfung anfragen":"Zatraži ručnu proveru"}</button>
     <a class="advisor-email-fallback" href="mailto:info@daninihub.com?subject=AutoDanini%20-%20Fahrzeugpruefung">{de?"Anfrage stattdessen per E-Mail senden":"Pošalji zahtev putem e-maila"}</a>
     <p id="advisor-feedback" role="status" aria-live="polite"></p>
     <p class="micro">{de?"Dies ist eine Selbsteinschätzung, kein Nachweis für Eigentum, Zustand oder Betrug. Freigabe und Versand hängen vom konfigurierten Backend ab.":"Ovo je samoprocena, ne dokaz vlasništva, stanja ili prevare. Slanje zavisi od aktivnog i bezbedno konfigurisanog servera."}</p>
    </section>
   </div>
   <p class="advisor-back"><a href={`/${locale}/#ai-savetnik`}>{de?"← Zurück zur Startseite":"← Nazad na početnu"}</a></p>
  </div>
 </section>
</Base>
<script is:inline src="/danini-advisor-client.js"></script>
<script>
 const root=document.querySelector('[data-advisor]');
 const source=root?.querySelector('#listing') as HTMLTextAreaElement|null;
 const caution=root?.querySelector('#source-caution');
 if(source&&caution) {
  const update=()=>{
   const v=source.value.trim(),de=root?.getAttribute('data-locale')==='de';
   const weak=/kleinanzeigen\.de|quoka\.de/i.test(v)||(!/^https:\/\//i.test(v)&&!(/^[A-HJ-NPR-Z0-9]{17}$/i.test(v)));
   caution.textContent=weak?
    (de?'Bei Privat-/Kleinanzeigen oder Text fehlen geprüfte Verkäufer- und Eigentumsnachweise; unbedingt unabhängig prüfen.':'Kod malih oglasa ili kopiranog teksta identitet prodavca i vlasništvo nisu nezavisno potvrđeni.'):
    (de?'Auch große Portale bestätigen weder Eigentum noch Fahrzeugzustand.':'Ni veliki oglasnici ne garantuju vlasništvo i stanje vozila.');
  };
  source.addEventListener('input',update);update();
 }
</script>
<style>
.advisor-page{background:linear-gradient(145deg,#f3f7fb 0%,#eaf1f8 100%);padding:clamp(44px,5vw,82px) 0 95px;color:#142338;min-height:75vh}
.advisor-wrap{max-width:1440px}
.advisor-page .eyebrow{color:#0f766e;font-weight:800;letter-spacing:.15em;font-size:.74rem}
.advisor-page h1{color:#112338;font-size:clamp(2.5rem,4.7vw,4.8rem);max-width:1000px;font-weight:810;line-height:1.08;letter-spacing:-.055em;margin:24px 0}
.advisor-page .advisor-lead{color:#40536a;max-width:800px;line-height:1.75;font-size:clamp(1.04rem,1.4vw,1.22rem)}
.advisor-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:start;margin:clamp(30px,4vw,55px) 0 20px}
.advisor-panel{min-width:0;background:#fff;border:1px solid #d2deea;border-radius:22px;padding:clamp(24px,3vw,40px);box-shadow:0 15px 44px #142b4210;color:#142338}
.advisor-panel:nth-child(3){grid-column:1/-1;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);column-gap:40px;align-items:start}
.advisor-panel:nth-child(3)>h2{grid-column:1/-1}
.advisor-panel h2{color:#142338;font-size:clamp(1.4rem,2vw,1.8rem);font-weight:790;line-height:1.25;margin:0 0 23px;letter-spacing:-.03em}
.advisor-panel h3{color:#142338}
.advisor-panel p{color:#46586d;line-height:1.7}
.advisor-panel label{display:block;color:#142338;font-weight:700;font-size:.9rem;margin:10px 0 9px}
.advisor-panel :is(input,textarea){font:inherit;background:#fcfdff;color:#13253b;border:1.5px solid #a1b3c3;border-radius:11px;padding:12px 15px;width:100%}
.advisor-panel textarea{min-height:167px;resize:vertical;font-size:1rem;line-height:1.6}
.advisor-panel textarea::placeholder{color:#64748b;opacity:1}
.source-preview{overflow-wrap:anywhere;max-height:125px;overflow:auto;font-size:.79rem;padding:8px 0;color:#41556a}
.advisor-warning{background:#fffaea;border:1px solid #eadbaa;border-radius:13px;padding:20px;margin-top:20px;font-size:.88rem;color:#513e17}
.advisor-warning strong{color:#413117}
.advisor-warning p{color:#59461f}
.advisor-warning ul{padding-left:19px;line-height:1.75;margin-bottom:0}
.advisor-question{background:#f3f7fa;padding:20px;margin:13px 0;border:1px solid #dfE8f0;border-radius:13px}
.advisor-question h3{font-size:1rem;line-height:1.55;margin:0 0 16px;font-weight:740}
.answer-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.answer-grid button{border:1.5px solid #a1b3c3;background:#fff;color:#17283a;border-radius:10px;padding:13px 15px;cursor:pointer;text-align:left;font:inherit;font-size:.86rem;line-height:1.45;font-weight:670;min-height:52px}
.answer-grid button:hover{border-color:#0f766e}
.answer-grid button[aria-pressed=true]{border:2px solid #0b7669;background:#ddf8ef;color:#064c46}
.advisor-risk{display:flex;gap:12px;align-items:center;border-bottom:1px solid #e2e8f0;padding:13px 0;color:#22354b;font-size:.94rem}
.dot{width:13px;height:13px;border-radius:50%;background:#8697ab;flex:none}
.dot.green{background:#169b76}.dot.yellow{background:#e4a11b}.dot.red{background:#e04f58}
#advisor-status{border-radius:10px;background:#eff7fa;padding:15px;color:#233e53;font-size:.9rem;font-weight:680}
.advisor-panel details{margin:22px 0}
.advisor-panel summary{cursor:pointer;font-weight:800;color:#0f766e;padding:13px 0;font-size:1rem}
.advisor-costs{display:grid;grid-template-columns:1fr 1fr;gap:9px 16px;margin-top:16px}
.advisor-costs label{margin:8px 0 0}
.advisor-costs input{max-width:100%;grid-row:auto}
.advisor-costs output{grid-column:1/-1;font-size:1.12rem;font-weight:800;padding:19px;background:#e4f6ef;color:#07564e;border-radius:11px;margin-top:12px}
.advisor-contact{display:grid;gap:5px;margin:0}
.advisor-contact a{text-decoration:underline;color:#0f766e;font-size:.85rem}
.advisor-check{display:flex!important;gap:10px;align-items:flex-start;font-size:.81rem!important;line-height:1.55}
.advisor-check input{width:19px;height:19px;flex:none;margin:2px 0 0}
#advisor-turnstile{min-height:0}
#advisor-cta{width:100%;min-height:54px;margin-top:15px;background:#0f766e;color:#fff;border:none;border-radius:10px;font-weight:790;font-size:.94rem}
#advisor-cta:disabled{display:none}
.advisor-email-fallback{display:flex;align-items:center;justify-content:center;min-height:54px;background:#0d776b;color:#fff!important;border-radius:11px;padding:13px 18px;margin-top:16px;font-weight:780;font-size:.92rem;text-align:center;text-decoration:none!important}
.advisor-email-fallback:hover{background:#095e55}
.advisor-email-fallback:focus-visible{outline:3px solid #facc15;outline-offset:4px}
#advisor-feedback{font-size:.89rem}
.advisor-back{margin:30px 0 0!important}
.advisor-back a{color:#0f766e;font-weight:750;text-decoration:underline;text-underline-offset:4px}
@media(max-width:1020px){.advisor-panel:nth-child(3){display:block}.advisor-grid{gap:18px}}
@media(max-width:790px){.advisor-grid{grid-template-columns:1fr}.advisor-panel:nth-child(3){grid-column:auto}.advisor-panel{padding:24px}.advisor-page{padding-top:48px}.advisor-page h1{font-size:clamp(2.35rem,7vw,3.2rem)}}
@media(max-width:420px){.answer-grid{grid-template-columns:1fr}.advisor-costs{grid-template-columns:1fr}.advisor-costs output{grid-column:1}.advisor-panel{padding:20px}.advisor-page h1{font-size:2.25rem}}
</style>