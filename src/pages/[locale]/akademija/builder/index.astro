---
import Base from "../../../../layouts/Base.astro";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de"|"sr";
const de=locale==="de";
---
<Base locale={locale} slug="akademija/builder" noindex={false}
 title={de?"Kostenloser Online Business Builder – in sechs Schritten zum Startpaket":"Besplatni Online Business Builder – poslovni paket u šest koraka"}
 description={de?"Kostenloses Tool: Geschäftsidee in sechs Schritten strukturieren, individuelles Startpaket als Text/JSON exportieren oder als PDF drucken. Ohne Anmeldung.":"Besplatan alat: razradi poslovnu ideju kroz šest koraka i izvezi operativni paket kao TXT/JSON ili PDF. Bez prijave."}>
<section class="bb-hero"><div class="wrap"><p class="bb-eyebrow">DANINI / ONLINE BUSINESS BUILDER · {de?"KOSTENLOS & SOFORT NUTZBAR":"BESPLATNO I ODMAH DOSTUPNO"}</p><h1>{de?"Ihre Geschäftsidee. Sechs Schritte. Ein konkretes Startpaket.":"Tvoja poslovna ideja. Šest koraka. Konkretan poslovni paket."}</h1><p>{de?"Nutzen Sie den kostenlosen Builder direkt ohne Anmeldung: entwickeln Sie Ihren Plan und speichern Sie Ihr Ergebnis als TXT, JSON oder druckbares PDF. Der Entwurf ist keine geprüfte Marktanalyse; Ihre Eingaben bleiben im Browser-Tab.":"Koristi besplatni Builder odmah i bez prijave: razradi plan i sačuvaj rezultat kao TXT, JSON ili PDF. Nacrt nije potvrđena analiza tržišta; tvoji unosi ostaju u kartici browsera."}</p><a class="bb-start-link" href="#demo">{de?"Jetzt kostenlos starten":"Započni besplatno"}</a></div></section>
<div class="wrap bb-shell" id="builder" data-locale={locale}>
 <p id="notice" class="bb-notice" role="status" aria-live="polite">{de?"Prüfe Verfügbarkeit…":"Proveravam dostupnost…"}</p>
 <section class="bb-card bb-demo" id="demo" hidden aria-labelledby="demo-heading">
  <p class="bb-demo-label">{de?"KOSTENLOSES TOOL · SOFORT STARTEN":"BESPLATAN ALAT · POČNI ODMAH"}</p>
  <h2 id="demo-heading">{de?"Ihr eigenes Startpaket in sechs Schritten erstellen":"Napravi svoj poslovni paket u šest koraka"}</h2>
  <p>{de?"Sechs aufeinander aufbauende Schritte, um Ihre Idee zu konkretisieren. Ihre Angaben bleiben ausschließlich in diesem offenen Browser-Tab und werden weder gespeichert noch versendet. Laden Sie Ihr Ergebnis vor dem Schließen herunter. Keine KI-Analyse oder Marktvalidierung.":"Šest povezanih koraka za razradu poslovne ideje. Uneti podaci ostaju samo u ovoj otvorenoj kartici browsera — ne čuvaju se i ne šalju serveru. Pre zatvaranja preuzmi rezultat. Nema AI analize niti nezavisne provere tržišta."}</p>
  <div class="bb-demo-progress"><span id="demo-count"></span><span id="demo-step-title"></span></div>
  <div class="bb-demo-meter" aria-hidden="true"><span id="demo-meter-fill"></span></div>
  <form id="demo-form">
   <div class="bb-field"><label for="demo-title">{de?"Name Ihres Geschäftsvorhabens":"Naziv poslovnog projekta"}</label><input id="demo-title" maxlength="120" required placeholder={de?"z. B. Digitaler Büroservice":"npr. Digitalna administrativna podrška"} /></div>
   <div id="demo-fields"></div>
   <div class="bb-demo-actions"><button class="bb-outline" type="button" id="demo-back"></button><button class="bb-btn" type="submit" id="demo-next"></button></div>
  </form>
  <div id="demo-result" hidden aria-live="polite">
   <h3>{de?"Ihr vorläufiges Projektdossier":"Tvoj preliminarni poslovni dosije"}</h3>
   <p>{de?"Die Angaben wurden ausschließlich von Ihnen eingegeben. Es fand keine externe Prüfung oder KI-Auswertung statt.":"Prikazani podaci potiču isključivo od tebe. Nije izvršena nezavisna provera niti AI analiza."}</p>
   <div id="demo-summary"></div>
   <div class="bb-demo-actions"><button class="bb-btn" type="button" id="demo-export"></button><button class="bb-outline" type="button" id="demo-text"></button><button class="bb-outline" type="button" id="demo-print"></button><button class="bb-outline" type="button" id="demo-edit"></button><button class="bb-outline" type="button" id="demo-reset"></button></div>
  </div>
  <p class="bb-fine">{de?"Privater Entwurf ohne Speicherung oder Kauf. Keine Passwörter, fremden personenbezogenen Daten oder vertraulichen Unterlagen eingeben.":"Privatni nacrt bez čuvanja i kupovine. Ne unosi lozinke, tuđe lične podatke ni poverljivu dokumentaciju."}</p>
 </section>
 <section class="bb-card" id="signin" hidden>
  <h2>{de?"Mit E-Mail anmelden":"Prijavi se preko e-maila"}</h2>
  <p>{de?"Sie erhalten einen einmaligen Code. Keine automatische Newsletter-Anmeldung.":"Dobićeš jednokratni kod. Nema automatske prijave na newsletter."}</p>
  <form id="login-form"><label for="email">E-mail</label><input type="email" name="email" id="email" maxlength="254" required autocomplete="email" /><div id="turnstile"></div><button class="bb-btn" type="submit">{de?"Einmalcode senden":"Pošalji kod za prijavu"}</button></form>
  <form id="verify-form" hidden><label for="otp">{de?"8-stelliger Einmalcode":"Jednokratni kod (8 cifara)"}</label><input id="otp" name="code" required pattern="[0-9]{8}" inputmode="numeric" autocomplete="one-time-code" maxlength="8" /><button type="submit" class="bb-btn">{de?"Anmelden":"Prijavi se"}</button></form>
 </section>
 <section id="dashboard" hidden>
  <div class="bb-top"><h2>{de?"Meine Projekte":"Moji projekti"}</h2><button type="button" id="logout" class="bb-outline">{de?"Abmelden":"Odjavi se"}</button></div>
  <form id="new-project" class="bb-card bb-new"><label for="project-title">{de?"Projektname":"Naziv projekta"}</label><input id="project-title" name="title" required maxlength="120" placeholder={de?"z. B. Online-Büroservice":"npr. Online administrativna podrška"} /><button class="bb-btn" type="submit">{de?"Projekt erstellen":"Kreiraj projekat"}</button></form>
  <div class="bb-layout"><nav id="project-list" class="bb-card" aria-label={de?"Gespeicherte Projekte":"Sačuvani projekti"}></nav>
   <section id="editor" class="bb-card" hidden><div class="bb-top"><h3 id="selected-title"></h3><button type="button" class="bb-outline" id="export">{de?"JSON exportieren":"Izvezi JSON"}</button></div>
    <div id="step-tabs" class="bb-tabs" role="group" aria-label={de?"Projektphasen":"Faze projekta"}></div>
    <h4 id="stage-title"></h4><p id="stage-help"></p>
    <form id="step-form"><div id="step-fields"></div><button class="bb-btn" type="submit">{de?"Arbeitsschritt speichern":"Sačuvaj korak"}</button></form>
    <div class="bb-danger"><button type="button" id="delete-project" class="bb-outline">{de?"Projekt löschen":"Obriši projekat"}</button></div>
   </section></div>
 </section>
 <p class="bb-fine">{de?"Ohne Erfolgsgarantie. Daten werden nur nach Anmeldung gespeichert; bei abgeschalteter Pilotfunktion werden keine Projekte angenommen. Teilen Sie keine fremden personenbezogenen Daten, Passwörter oder Geschäftsgeheimnisse.":"Bez garancije uspeha. Podaci se čuvaju tek nakon prijave; kada je pilot isključen, projekti se ne primaju. Ne unosite tuđe lične podatke, lozinke niti poslovne tajne."}</p>
</div>
<script is:inline src="/js/academy-builder.js" defer></script>
<style>
.bb-hero{background:linear-gradient(115deg,#0b2437,#0c5862);color:white;padding:clamp(50px,7vw,90px) 0}.bb-hero .wrap{max-width:1070px}.bb-eyebrow{font-size:.78rem;font-weight:850;letter-spacing:.15em;color:#f5d98d}.bb-hero h1{font-size:clamp(2rem,4.5vw,3.4rem);line-height:1.13;color:#fff;max-width:850px}.bb-hero p:last-of-type{color:#e9f4f7;max-width:780px;font-size:1.13rem}.bb-start-link{display:inline-flex;margin-top:12px;border-radius:9px;background:#f7d87e;color:#122f40!important;font-weight:850;text-decoration:none;padding:14px 20px}.bb-start-link:hover,.bb-start-link:focus-visible{background:#fff0b0}
.bb-shell{max-width:1070px;padding:35px 22px 70px}.bb-notice{background:#e6f4f5;color:#16444a;border-left:4px solid #0d727a;padding:13px 17px;border-radius:5px}
.bb-card{background:#fff;border:1px solid #c7d6df;border-radius:15px;padding:clamp(18px,3vw,30px);margin:18px 0;box-shadow:0 12px 28px #0b304010}.bb-card h2,.bb-card h3,.bb-card h4{color:#12374a}.bb-card input,.bb-card textarea{display:block;background:#fff;color:#1c3a4f;border:1.5px solid #648694;border-radius:8px;padding:11px 13px;width:100%;max-width:610px;font:inherit}.bb-card label{font-weight:780;color:#193d50;display:block;margin:14px 0 7px}.bb-btn{background:#075e65;color:#fff;border:2px solid #075e65;min-height:48px;padding:11px 19px;border-radius:8px;font-weight:850;cursor:pointer;margin-top:15px}.bb-btn:hover{background:#034c52}.bb-outline{background:#fff;border:2px solid #37757d;color:#074e54;border-radius:8px;padding:9px 14px;cursor:pointer;font:inherit;font-weight:800}.bb-card button:focus-visible,.bb-card input:focus-visible,.bb-card textarea:focus-visible{outline:3px solid #b07c1e;outline-offset:3px}.bb-top{display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap}.bb-layout{display:grid;grid-template-columns:minmax(230px,.65fr) minmax(0,1.5fr);gap:20px}.bb-project{display:block;border:1px solid #91b2be;background:#f5fafb;color:#114052;text-align:left;border-radius:8px;padding:13px;width:100%;font:inherit;cursor:pointer;margin:8px 0}.bb-tabs{display:flex;flex-wrap:wrap;gap:9px;margin:20px 0}.bb-tab{background:#f3f8fa;color:#174151;border:1px solid #84a5b2;border-radius:8px;padding:9px 11px;font:inherit;cursor:pointer}.bb-tab[aria-pressed="true"]{background:#104d5b;color:#fff}.bb-field{margin:15px 0}.bb-field textarea{max-width:100%;min-height:85px;resize:vertical}.bb-danger{border-top:1px solid #cedde4;margin-top:28px;padding-top:14px}.bb-fine{color:#385a69;font-size:.91rem;margin-top:24px}#turnstile{margin:15px 0;min-height:65px}.bb-new{display:flex;flex-wrap:wrap;align-items:end;gap:12px}.bb-new label{flex-basis:100%;margin:0}.bb-new input{flex:1;min-width:210px}.bb-new button{margin:0}@media(max-width:780px){.bb-layout{grid-template-columns:1fr}.bb-shell{padding:22px 16px 55px}.bb-hero{padding:48px 0}.bb-card{padding:20px}}

/* Dynamic no-login preview: JavaScript creates labels, textarea and helper paragraphs
   without Astro's data-astro attribute. Scoped rules alone do not reach those nodes.
   Explicitly style the actual rendered controls and the light card's text. */
.bb-card > p,.bb-demo > p:not(.bb-demo-label){color:#334155}
/* Fine print outside the white card sits on the near-black shell, not on white. */
.bb-shell > .bb-fine{color:#c7d6e2}
.bb-demo :global(#demo-fields label){display:block;color:#193d50;font-weight:780;margin:14px 0 7px}
.bb-demo :global(#demo-fields textarea){display:block;width:100%;max-width:100%;min-height:85px;resize:vertical;background:#fff;color:#1c3a4f;border:1.5px solid #648694;border-radius:8px;padding:11px 13px;font:inherit}
.bb-demo :global(#demo-fields textarea::placeholder){color:#475569;opacity:1}
.bb-demo :global(#demo-fields textarea:focus-visible){outline:3px solid #b07c1e;outline-offset:3px}
.bb-demo :global(#demo-fields .bb-demo-stage){color:#164a5d;font-weight:750;font-size:1.08rem;line-height:1.65;margin-top:22px}
.bb-demo :global(#demo-result p),.bb-demo :global(#demo-summary p){color:#334155}
.bb-demo #demo-title::placeholder{color:#475569;opacity:1}

.bb-demo{border-top:5px solid #0a737a}
.bb-demo-label{font-size:.8rem;font-weight:850;letter-spacing:.07em;color:#745110;margin:0 0 10px}
.bb-demo-progress{display:flex;gap:12px;flex-wrap:wrap;justify-content:space-between;color:#143c4e;font-weight:850;margin:23px 0 12px}
.bb-demo-meter{height:9px;border-radius:20px;background:#d9e7eb;overflow:hidden}
.bb-demo-meter span{display:block;height:100%;background:#0b6974;transition:width .15s;width:0}
.bb-demo-actions{display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:20px}
.bb-demo-actions .bb-btn{margin:0}
.bb-demo-row{padding:12px 0;border-bottom:1px solid #d1dfe5;overflow-wrap:anywhere}
.bb-demo-row strong{display:block;color:#11384b}
.bb-demo-row p{margin:5px 0;white-space:pre-wrap;overflow-wrap:anywhere}
.bb-demo-stage{color:#164a5d;font-weight:850;font-size:1.08rem;margin-top:22px}
@media(max-width:600px){.bb-demo-actions>*{flex:1;min-width:145px}}
@media print{header,.bb-hero,.bb-demo>p,.bb-demo>form,.bb-demo-progress,.bb-demo-meter,.bb-demo-actions,.bb-fine,.bb-notice,footer{display:none!important}.bb-demo{box-shadow:none;border:none}.bb-demo-row{break-inside:avoid}#demo-result{display:block!important}}

@media print{
 :global(body *){visibility:hidden!important}
 #demo-result,#demo-result :global(*){visibility:visible!important}
 #demo-result{position:absolute!important;top:0!important;left:0!important;width:100%!important;padding:10mm!important;background:#fff!important;color:#111!important}
 #demo-result .bb-demo-actions{display:none!important}
 #demo-result :global(.bb-demo-row),#demo-result :global(.bb-evidence-section){break-inside:avoid-page}
}
</style>
</Base>