---
import Base from "../../../layouts/Base.astro";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de" | "sr";
const de=locale==="de";
const base="/"+locale+"/";
const lessons=de?[
 {num:"01",name:"Nische und Problem prüfen",sub:"Verfügbar · kostenlose Praxislektion",status:"live"},
 {num:"02",name:"Zielgruppe, Recherche und Nachfrage",sub:"Verfügbar · kostenlose Recherchelektion",status:"live"},
 {num:"03",name:"Ein konkretes Angebot formulieren",sub:"Verfügbar · kostenlose Angebotslektion",status:"live"},
 {num:"04",name:"Online-Präsenz und erste Anfragen",sub:"Curriculum · in Vorbereitung",status:"planned"},
 {num:"05",name:"KI-gestützte Abläufe aufbauen",sub:"Curriculum · in Vorbereitung",status:"planned"},
 {num:"06",name:"Liefern, messen und verbessern",sub:"Curriculum · in Vorbereitung",status:"planned"}
]:[
 {num:"01",name:"Izbor niše i provera problema",sub:"Dostupno · besplatna praktična lekcija",status:"live"},
 {num:"02",name:"Publika, istraživanje i potražnja",sub:"Dostupno · besplatna lekcija istraživanja",status:"live"},
 {num:"03",name:"Konkretna ponuda i prvi proizvod",sub:"Dostupno · besplatna praktična lekcija",status:"live"},
 {num:"04",name:"Online prisustvo i prvi upiti",sub:"Program · u pripremi",status:"planned"},
 {num:"05",name:"AI tokovi i automatizacija",sub:"Program · u pripremi",status:"planned"},
 {num:"06",name:"Isporuka, merenje i unapređenje",sub:"Program · u pripremi",status:"planned"}
];
const prompts=de?[
 {label:"Prompt 1 — Problem statt Technologie",text:"Ich möchte ein kleines Online-Unternehmen in der Nische [NISCHE] aufbauen. Stelle mir zuerst höchstens drei konkrete Fragen zu meiner Zielgruppe, deren Problem und meinem verfügbaren Zeitbudget. Schlage noch keine Website oder Tools vor."},
 {label:"Prompt 2 — Annahmen kennzeichnen",text:"Auf Basis meiner Antworten: Trenne bestätigte Fakten, Annahmen und unbekannte Informationen. Nenne drei Möglichkeiten, reale Nachfrage ohne Werbung oder Anschaffungen zu prüfen. Erfinde keine Kunden, Belege oder Marktpreise."},
 {label:"Prompt 3 — Eine überprüfbare Entscheidung",text:"Entwerfe ein kleines, klar begrenztes Ergebnis, das ich in meiner Nische liefern könnte. Liste Voraussetzungen, Risiken, realistische Zeitaufwände und eine Stop-Bedingung. Kennzeichne alle Schätzungen; entscheide nicht an meiner Stelle."}
]:[
 {label:"Prompt 1 — Problem pre tehnologije",text:"Želim da pokrenem malo online preduzeće u niši [NIŠA]. Postavi mi prvo najviše tri konkretna pitanja o kupcima, problemu koji rešavam i vremenu koje imam. Nemoj još predlagati sajt ni alate."},
 {label:"Prompt 2 — Činjenice i pretpostavke",text:"Na osnovu mojih odgovora odvoji potvrđene činjenice, pretpostavke i nepoznate informacije. Predloži tri načina da besplatno proverim da li postoji stvarna potreba. Ne izmišljaj kupce, dokaze ni tržišne cene."},
 {label:"Prompt 3 — Proverljiva odluka",text:"Predloži mali, jasno ograničen rezultat koji mogu da isporučim u svojoj niši. Navedi uslove, rizike, realno vreme izrade i kriterijum za odustajanje. Sve procene obeleži, a konačnu odluku ostavi meni."}
];
---
<Base locale={locale} slug="akademija" title={de?"DANINI Akademie – mit KI ein Online-Business entwickeln":"DANINI Akademija – nauči da izgradiš online biznis uz AI"} description={de?"Kostenloser Einstieg: eine Geschäftsnische mit KI strukturiert prüfen, Annahmen und Nachfrage trennen und erste nächste Schritte planen. Reale Praxisbeispiele DANINI Business und AutoDanini.":"Besplatna prva lekcija: izaberi nišu, proveri problem i upotrebi AI za jasne poslovne odluke. Praktični primeri AutoDanini i DANINI Business."}>
<section class="ed-hero">
 <div class="wrap ed-hero-grid">
  <div>
   <p class="ed-kicker">DANINI / {de?"AKADEMIE & PRAXIS":"AKADEMIJA I PRAKSA"}</p>
   <h1>{de?"Mit KI ein Online-Business entwickeln. Schritt für Schritt.":"Nauči da uz AI izgradiš svoje online preduzeće."}</h1>
   <p class="ed-lead">{de?"Von der ersten Nischenidee bis zu einem überprüfbaren Angebot: Lernen Sie, wie Sie KI als Werkzeug für Recherche, Planung, Inhalte und Arbeitsabläufe nutzen – mit menschlicher Kontrolle und echten Praxisbeispielen.":"Od ideje za bilo koju nišu do proverljive ponude: nauči da koristiš AI za istraživanje, planiranje, izradu sadržaja i organizovanje poslovanja. Sve kroz konkretne zadatke i stvarne DANINI primere."}</p>
   <div class="ed-actions"><a class="ed-btn" href="#lektion-1">{de?"Kostenlose erste Lektion starten":"Započni besplatnu prvu lekciju"} ↓</a><a class="ed-btn ed-outline" href="#praxis">{de?"Praxisprojekte ansehen":"Pogledaj primere iz prakse"} ↗</a></div>
   <p class="ed-fine">{de?"Keine Registrierung erforderlich. Kein Einkommensversprechen. Drei weitere Module sind in Vorbereitung.":"Bez registracije i obećanja zarade. Dostupna su tri modula; još tri se razvijaju."}</p>
  </div>
  <div class="ed-display" aria-label={de?"Von einer Nischenidee zum prüfbaren Online-Angebot":"Od ideje za nišu do proverljive online ponude"}>
   <p>{de?"DANINI METHODE / BEISPIEL":"DANINI METODA / PRIMER"}</p>
   <div><span>01</span><strong>{de?"Ein echtes Problem":"Stvaran problem"}</strong><small>{de?"Wer braucht welche Hilfe?":"Kome i za šta treba pomoć?"}</small></div>
   <div><span>02</span><strong>{de?"Prüfen statt vermuten":"Provera umesto nagađanja"}</strong><small>{de?"Nachweise, Bedarf, Risiken":"Dokazi, potreba i rizici"}</small></div>
   <div><span>03</span><strong>{de?"Angebot und Ergebnis":"Ponuda i rezultat"}</strong><small>{de?"Klarer Umfang, transparente Grenzen":"Jasan obim i ograničenja"}</small></div>
   <div><span>04</span><strong>{de?"Liefern und lernen":"Isporuči i nauči"}</strong><small>{de?"Test, Feedback, echte Kennzahlen":"Test, povratne informacije, stvarni pokazatelji"}</small></div>
  </div>
 </div>
</section>
<section class="ed-intro"><div class="wrap"><div class="ed-intro-grid"><p><strong>{de?"Für verschiedene Nischen":"Za različite niše"}</strong><span>{de?"Dienstleistungen, Produkte, digitale Angebote und lokale Unternehmen.":"Usluge, digitalni proizvodi, lokalni i online poslovi."}</span></p><p><strong>{de?"KI als Werkzeug":"AI kao alat"}</strong><span>{de?"Fragen, recherchieren, Entwürfe erstellen – Ergebnisse selbst prüfen.":"Pitaj, istraži, pripremi nacrte — samostalno proveri rezultate."}</span></p><p><strong>{de?"Praxis statt Versprechen":"Praksa umesto obećanja"}</strong><span>{de?"DANINI Business und AutoDanini sind dokumentierte Entwicklungsbeispiele, keine behaupteten Verkaufserfolge.":"DANINI Business i AutoDanini su primeri razvoja, ne izmišljene priče o zaradi."}</span></p></div></div></section>
<section class="ed-section" id="programm"><div class="wrap">
 <p class="ed-kicker">{de?"LERNPFAD":"PROGRAM UČENJA"}</p><h2>{de?"Sechs Themen. Drei kostenlose Praxislektionen.":"Šest oblasti. Tri besplatne lekcije dostupne."}</h2><p class="ed-description">{de?"Der Lernpfad ist der geplante Rahmen, kein behaupteter fertiger Videokurs. Modul 01, 02 und 03 sind als vollständige Arbeitslektionen verfügbar.":"Ovo je struktura programa, ne tvrdnja da je svih šest modula gotovo. Moduli 01, 02 i 03 su objavljene praktične lekcije."}</p>
 <div class="ed-modules">{lessons.map(l=><article class:list={["ed-module",l.status==="live"?"ed-live":"ed-pending"]}><span>{l.num}</span><div><h3>{l.name}</h3><p>{l.sub}</p></div>{l.status==="live"?<a href={l.num==="01"?"#lektion-1":base+"akademija/modul-"+l.num+"/"}>{de?"Öffnen":"Otvori"} →</a>:<small>{de?"Geplant":"Planirano"}</small>}</article>)}</div>
</div></section>
<section class="ed-section ed-lesson" id="lektion-1"><div class="wrap ed-reading">
 <p class="ed-kicker">{de?"MODUL 01 · KOSTENLOS":"MODUL 01 · BESPLATNO"}</p><h2>{de?"Eine Nische mit KI prüfen, bevor Sie investieren.":"Kako da uz AI proveriš poslovnu nišu pre ulaganja."}</h2>
 <p class="ed-description">{de?"Ziel: Nach dieser Lektion besitzen Sie keine fertige Firma, sondern ein dokumentiertes, prüfbares Startkonzept. Rechnen Sie für die Übung mit 45–60 Minuten; das ist eine Orientierung, keine Erfolgsgarantie.":"Cilj: posle lekcije ne dobijaš automatski firmu, već dokumentovan početni koncept za proveru. Za rad izdvoji okvirno 45–60 minuta; vreme je procena, ne obećanje."}</p>
 <div class="ed-lesson-steps">
 <article><span>01</span><h3>{de?"Wählen Sie einen konkreten Kunden und ein Problem":"Izaberi kupca i konkretan problem"}</h3><p>{de?"Beispiele: kleine Handwerksbetriebe verlieren Kundenanfragen; Käufer eines Gebrauchtwagens haben vor einer Anzahlung unklare Dokumente. Eine Nische ist kein Software-Tool, sondern eine Gruppe mit einem konkreten Bedarf.":"Primeri: mala firma gubi upite; kupac polovnog automobila nema dovoljno podataka pre kapare. Niša nije AI alat — niša je grupa ljudi sa konkretnom potrebom."}</p><p class="ed-task">{de?"Ihr Ergebnis: Ein Satz „Ich helfe [Kundengruppe], [Problem] zu lösen, durch [prüfbares Ergebnis].“":"Tvoj rezultat: jedna rečenica „Pomažem [kome] da reši [problem] kroz [proverljiv rezultat].“"}</p></article>
 <article><span>02</span><h3>{de?"Prüfen Sie den Bedarf statt nur KI-Antworten zu glauben":"Proveri potražnju, ne veruj samo AI odgovorima"}</h3><p>{de?"Suchen Sie überprüfbare Hinweise: konkrete öffentliche Anfragen, vorhandene Angebote, wiederkehrende Beschwerden. Notieren Sie Quelle und Datum. Eine KI-Zusammenfassung allein beweist weder Nachfrage noch Zahlungsbereitschaft.":"Potraži stvarne signale: javne upite, postojeće ponude, ponavljajuće pritužbe. Zapiši izvor i datum. AI odgovor nije dokaz ni potražnje ni spremnosti za plaćanje."}</p><p class="ed-task">{de?"Ihr Ergebnis: Drei Hinweise mit Quellen oder ausdrücklich „noch unbelegt“.":"Tvoj rezultat: tri signala sa izvorima ili iskreno označeno „još nepotvrđeno“."}</p></article>
 <article><span>03</span><h3>{de?"Definieren Sie ein kleines Ergebnis":"Definiši mali rezultat koji možeš da isporučiš"}</h3><p>{de?"Beginnen Sie beispielsweise mit einer Checkliste, einem strukturierten Bericht oder der Bearbeitung eines klar begrenzten Vorgangs. Legen Sie fest, was nicht enthalten ist, wie lange es dauert und was Sie vorher prüfen müssen.":"Počni od kontrolne liste, strukturisanog izveštaja ili jednog jasno ograničenog procesa. Zapiši šta usluga ne uključuje, koliko vremena treba i šta moraš da proveriš pre isporuke."}</p><p class="ed-task">{de?"Ihr Ergebnis: Leistungsumfang, eine Grenze, Aufwandsschätzung und nächster Test.":"Tvoj rezultat: obim usluge, jedno ograničenje, procena vremena i sledeći test."}</p></article>
 </div>
 <div class="ed-prompts"><h3>{de?"Drei sofort nutzbare KI-Prompts":"Tri gotova AI zadatka koja možeš odmah koristiti"}</h3><p>{de?"Ersetzen Sie [NISCHE] und verwenden Sie die Prompts nacheinander. Prüfen Sie die Ergebnisse, bevor Sie Entscheidungen treffen. Keine Kundendaten oder Geheimnisse eingeben.":"Zameni [NIŠA] svojom idejom. Kopiraj zadatke redom u AI asistenta i proveri odgovore. Ne unosi tuđe lične podatke, šifre ili poslovne tajne."}</p>{prompts.map((p,i)=><div class="ed-prompt"><p><strong>{p.label}</strong></p><blockquote>{p.text}</blockquote><button class="ed-copy" type="button" data-copy-prompt={i} data-copy-de={de?"Kopiert":"Kopirano"}>{de?"Text kopieren":"Kopiraj zadatak"}</button></div>)}</div>
 <div class="ed-worksheet"><h3>{de?"Ihre eigene Ein-Seiten-Arbeitsvorlage":"Tvoja radna sveska na jednoj strani"}</h3><p>{de?"Füllen Sie diese fünf Felder aus und speichern oder drucken Sie Ihre Entscheidungen. Die Angaben bleiben auf Ihrem Gerät und werden nicht an DANINI gesendet.":"Popuni pet polja i sačuvaj ili odštampaj rezultat. Uneti podaci ostaju u tvom pregledaču i ne šalju se DANINI sistemu."}</p>
 <div class="ed-fields">
  <label>{de?"Meine Nische / Zielgruppe":"Moja niša i publika"}<textarea rows="2" maxlength="500" placeholder={de?"Für wen genau?":"Za koga tačno?"}></textarea></label>
  <label>{de?"Das Problem, das ich lösen möchte":"Problem koji rešavam"}<textarea rows="2" maxlength="500" placeholder={de?"Was ist heute schwierig oder teuer?":"Šta je danas teško, sporo ili skupo?"}></textarea></label>
  <label>{de?"Belege und noch offene Annahmen":"Dokazi i nepotvrđene pretpostavke"}<textarea rows="3" maxlength="850" placeholder={de?"Quelle, Datum, was ich noch nicht weiß":"Izvor, datum, šta još ne znam"}></textarea></label>
  <label>{de?"Mein kleines Angebot und seine Grenzen":"Moja početna ponuda i ograničenja"}<textarea rows="2" maxlength="650" placeholder={de?"Ein Ergebnis, das ich liefern kann":"Jedan rezultat koji mogu da isporučim"}></textarea></label>
  <label>{de?"Nächster Test und Stop-Bedingung":"Sledeći test i uslov za odustajanje"}<textarea rows="2" maxlength="500" placeholder={de?"Was prüfe ich vor weiteren Kosten?":"Šta proveravam pre većeg ulaganja?"}></textarea></label>
 </div>
 <button class="ed-btn ed-print" type="button" data-education-print>{de?"Arbeitsblatt drucken / PDF speichern":"Odštampaj / sačuvaj kao PDF"}</button><p class="ed-privacy">{de?"Kein Konto, keine Datenübertragung, keine Werbe-E-Mail. Beim Neuladen ohne Ausdruck gehen die Einträge verloren.":"Bez naloga, slanja podataka i newsletter prijave. Ako osvežiš stranicu bez čuvanja, uneti tekst se gubi."}</p></div>
 <div class="ed-decision"><h3>{de?"Was bedeutet ein guter erster Test?":"Kako znaš da si napravio prvi korak?"}</h3><p>{de?"Sie können eine Zielgruppe, ein Problem, mindestens einen überprüfbaren Nachfragesignal-Typ und ein begrenztes Angebot beschreiben. Wenn Nachfrage oder Fähigkeiten fehlen, prüfen oder überarbeiten – nicht automatisch verkaufen.":"Možeš da navedeš kome pomažeš, šta rešavaš, gde ćeš tražiti dokaz potrebe i šta tačno isporučuješ. Ako nedostaju dokazi ili sposobnost isporuke, dodatno proveri ili promeni ideju — ne kreći odmah u prodaju."}</p></div>
</div></section>
<section class="ed-section ed-cases" id="praxis"><div class="wrap">
 <p class="ed-kicker">{de?"AN UNSEREN EIGENEN PROJEKTEN ZEIGEN":"POKAZUJEMO NA SOPSTVENIM PROJEKTIMA"}</p><h2>{de?"Zwei Geschäftsbeispiele. Dieselbe Methode.":"Dva različita poslovna primera. Ista metoda."}</h2><p class="ed-description">{de?"Diese Seiten zeigen reale Entwicklungsarbeit und veröffentlichte Funktionen, nicht behauptete zahlende Kunden oder garantierte Ergebnisse.":"Na njima možeš da vidiš razvijene funkcionalnosti i naše odluke, ali ne tvrdimo da je time dokazana profitabilnost ili da postoje kupci."}</p>
 <div class="ed-case-grid">
  <article><p>01 / AutoDanini</p><h3>{de?"Nische: Gebrauchtwagen vor der Anzahlung":"Niša: provera auta pre kapare"}</h3><p>{de?"Ausgangspunkt: Käufer brauchen vor Fahrt und Zahlung strukturierte Informationen. Ergebnis: eine kostenlose 12-Punkte-Checkliste und ein konkreter Anfrageweg.":"Problem: kupac želi jasne podatke pre puta i kapare. Rezultat: besplatna lista sa 12 provera i postojeći formular za konkretan upit."}</p><a href={base+"wissen/checkliste/"}>{de?"Praxisbeispiel ansehen":"Otvori praktični primer"} →</a></article>
  <article><p>02 / DANINI Business</p><h3>{de?"Nische: digitale Bearbeitung von Kundenanfragen":"Niša: obrada poslovnih upita"}</h3><p>{de?"Ausgangspunkt: Informationen verteilen sich auf E-Mails und Formulare. Ergebnis: ein dokumentierter Anfrageprozess mit menschlicher Freigabe.":"Problem: upiti se gube u e-mailovima i obrascima. Rezultat: dokumentovan tok prijema, nacrta odgovora i ljudskog odobrenja."}</p><a href={base+"business/"}>{de?"Business-Prozess ansehen":"Pogledaj poslovni primer"} →</a></article>
 </div>
 <div class="ed-digital"><div><p class="ed-kicker">{de?"ARBEITSMATERIALIEN & DIGITALE PRODUKTE":"MATERIJALI I DIGITALNI PROIZVODI"}</p><h3>{de?"Vorlagen nutzen. Ergebnisse nachvollziehbar machen.":"Koristi šablone i uči na konkretnim rezultatima."}</h3><p>{de?"Zwei kostenlose Lektionen sind verfügbar. Weitere Lernmaterialien werden einzeln entwickelt und geprüft. Ein bestehender PDF-Ratgeber ist technisch vorbereitet; öffentlicher Kauf noch nicht aktiviert. Kein bezahlter Gesamtkurs wird als lieferbar ausgegeben.":"Dve besplatne lekcije su dostupne. Naredne lekcije i radne sveske razvijamo pojedinačno. Postojeći PDF vodič je pripremljen, ali javna kupovina nije aktivna. Ne prodajemo kurs koji nije gotov."}</p></div><a class="ed-btn" href={base+"wissen/produkte/"}>{de?"Produkte und Status ansehen":"Pogledaj proizvode i status"} →</a></div>
</div></section>
<section class="ed-section ed-free-kit" id="starter-kit"><div class="wrap">
 <p class="ed-kicker">DANINI / {de?"KOSTENLOSE MATERIALIEN":"BESPLATNI MATERIJALI"}</p>
 <h2>{de?"AI Business Starter Kit – Arbeitsvorlagen":"AI Business Starter Kit – radni šabloni"}</h2>
 <p class="ed-description">{de?"Nutzen Sie drei praktische Dateien ohne Registrierung: Markt- und Quellenmatrix (CSV), eine Vorlage für ein erstes Angebot und eine Prüfliste. Die Dateien sind Lernhilfen, keine verbindlichen Angebote.":"Besplatno preuzmi tri konkretna materijala bez registracije: tabelu izvora (CSV), šablon ponude i kontrolnu listu validacije. To su obrazovni obrasci, ne stvarne komercijalne ponude."}</p>
 <div class="ed-kit-links">
  <a href="/downloads/akademija/danini-starter-kit-recherche.csv" download>{de?"Recherche-Tabelle (CSV)":"Tabela za istraživanje (CSV)"} ↓</a>
  <a href="/downloads/akademija/danini-starter-kit-offer-de-sr.md" download>{de?"Angebotsvorlage (DE/SR)":"Šablon ponude (DE/SR)"} ↓</a>
  <a href="/downloads/akademija/danini-starter-kit-checklist-de-sr.md" download>{de?"Validierungs-Checkliste (DE/SR)":"Kontrolna lista (DE/SR)"} ↓</a>
 </div>
 <p class="ed-privacy">{de?"Keine Anmeldung und keine Zahlungsabwicklung. Markdown-Dateien lassen sich in einem Texteditor öffnen.":"Bez naloga i naplate. Markdown (.md) fajlovi otvaraju se u običnom uređivaču teksta."}</p>
</div></section>
</Base>
<script>
const prompts=Array.from(document.querySelectorAll<HTMLElement>(".ed-prompt blockquote"));
for(const button of document.querySelectorAll<HTMLButtonElement>("[data-copy-prompt]")){
 button.addEventListener("click",async()=>{
  const i=Number(button.dataset.copyPrompt);
  if(!Number.isInteger(i)||i<0||i>=prompts.length)return;
  try{await navigator.clipboard.writeText(prompts[i].textContent||"");
   const before=button.textContent||"";
   button.textContent=button.dataset.copyDe||"Kopirano";
   window.setTimeout(()=>button.textContent=before,1900);
  }catch{button.setAttribute("aria-label","Clipboard unavailable");}
 });
}
document.querySelector<HTMLButtonElement>("[data-education-print]")?.addEventListener("click",()=>window.print());
</script>
<style>
.ed-hero{background:radial-gradient(circle at 80% 20%,#17636a 0%,transparent 43%),linear-gradient(120deg,#0c182a,#102d41);color:#fff;padding:clamp(55px,6vw,95px) 0}.ed-hero-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(320px,.88fr);gap:clamp(30px,5vw,78px);align-items:center}.ed-kicker{color:#b99537;letter-spacing:.14em;font-weight:850;font-size:.75rem}.ed-hero .ed-kicker{color:#f5d27c}.ed-hero h1{font-size:clamp(2.5rem,5vw,5rem);line-height:1.07;margin:16px 0 25px;color:#fff;letter-spacing:-.04em}.ed-lead{color:#e0edf4;font-size:clamp(1.04rem,1.4vw,1.22rem);line-height:1.7}.ed-actions{display:flex;gap:13px;flex-wrap:wrap;margin:28px 0}.ed-btn{border:1px solid #facc15;background:#facc15;color:#0c2336;min-height:50px;display:inline-flex;align-items:center;justify-content:center;text-align:center;padding:14px 21px;border-radius:9px;font:inherit;font-weight:850;cursor:pointer;text-decoration:none}.ed-outline{background:transparent;color:white;border-color:#a1bbc9}.ed-fine{color:#bed1dd;font-size:.82rem}.ed-display{padding:28px;border:1px solid #b2d2dd69;border-radius:20px;background:#ffffff0b;box-shadow:0 20px 65px #07122266}.ed-display>p{font-weight:850;letter-spacing:.12em;font-size:.74rem;color:#f0cf79}.ed-display>div{display:grid;grid-template-columns:46px 1fr;column-gap:14px;row-gap:4px;align-items:center;background:#ffffff0a;border:1px solid #ffffff20;border-radius:12px;padding:16px;margin:12px 0}.ed-display span{grid-row:span 2;display:grid;place-items:center;background:#facc15;color:#143043;font-weight:850;width:42px;height:42px;border-radius:10px}.ed-display strong{font-size:1.03rem}.ed-display small{font-size:.78rem;color:#c6d8e3}.ed-intro{background:#eaf2f6}.ed-intro-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px;padding:27px 0}.ed-intro p{margin:0;display:grid;gap:7px}.ed-intro strong{color:#153d4c}.ed-intro span{color:#416175;font-size:.9rem}.ed-section{padding:clamp(55px,7vw,95px) 0;background:#fff;scroll-margin