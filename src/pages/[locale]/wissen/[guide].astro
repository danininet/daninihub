---
import Base from "../../../layouts/Base.astro";
import {guides} from "../../../lib/knowledge";
export function getStaticPaths(){return ["de","sr"].flatMap(locale=>guides.map(g=>({params:{locale,guide:g.slug}})));}
const locale=Astro.params.locale as "de"|"sr";const de=locale==="de";
const guide=guides.find(g=>g.slug===Astro.params.guide)!;
const sections=[[["Vor der Zahlung","Anzeige, FIN, Verkäuferidentität, Wartungsnachweise und schriftliche Zahlungsbedingungen vergleichen. Keine Überweisung allein aufgrund eines Fotos oder Zeitdrucks.","Vor einer Anzahlung offene Punkte schriftlich beim Verkäufer klären und bei Widersprüchen eine unabhängige Prüfung vereinbaren."],["Pre uplate","Uporediti oglas, VIN, identitet prodavca, servisnu istoriju i pisane uslove uplate. Ne plaćati samo na osnovu fotografije ili pritiska.","Pre kapare zatražiti odgovore u pisanoj formi i po potrebi nezavisni pregled."]],[["Dokumente abgleichen","FIN am Fahrzeug mit Teil I, Teil II und Kaufvertrag vergleichen. HU-Bericht und Wartungsbelege nach Datum, Kilometerstand und Aussteller prüfen.","Teil II allein beweist nicht das Eigentum. Unklare Einträge vor Kauf durch zuständige Stellen oder Fachleute klären."],["Poređenje dokumenata","Uporediti VIN na vozilu sa oba dela nemačkih dokumenata i ugovorom. Proveriti datume, kilometražu i izdavaoce HU i servisnih zapisa.","Dokument Teil II sam po sebi ne dokazuje vlasništvo. Nejasnoće razjasniti pre kupovine."]],[["Ablauf und Risiken","Vor dem Kauf Ausfuhrkennzeichen, Versicherung, Transport, Kaufbelege und serbische Zollanforderungen separat prüfen. Einfuhrabgaben hängen vom Einzelfall ab.","Nicht mit pauschal garantierten Zollbeträgen rechnen. Vor Reise und Zahlung aktuelle Informationen der zuständigen Behörden einholen."],["Postupak i rizici","Pre kupovine posebno proveriti izvozne tablice, osiguranje, prevoz, račun i carinske zahteve Srbije. Troškovi zavise od konkretnog vozila.","Ne računati na univerzalni iznos carine. Proveriti aktuelne uslove kod nadležnih organa."]],[["Eingang strukturieren","Anfragen aus Formular und E-Mail mit Eingangsdatum, Anliegen, Zuständigkeit, Priorität und nächster Aktion erfassen. Fehlende Angaben gezielt nachfragen.","Beispiel: Eine Anfrage ohne gewünschte Frist wird als unvollständig markiert, nicht automatisch als Auftrag angenommen."],["Organizacija prijema","Upite iz formulara i e-maila evidentirati sa datumom, temom, odgovornom osobom, prioritetom i sledećim korakom.","Primer: upit bez roka označiti kao nepotpun, a ne automatski kao prihvaćenu narudžbinu."]],[["Medienbruch vermeiden","Formularfelder standardisieren, E-Mail-Antworten dem richtigen Vorgang zuordnen und im CRM eine eindeutige Referenz führen. Dubletten und Zugriffsrechte prüfen.","Beispiel: Zwei E-Mails zur selben Anfrage bleiben ein Vorgang; Marketing-Einwilligung wird nicht unterstellt."],["Povezivanje kanala","Standardizovati polja formulara, povezati odgovore sa predmetom i koristiti jedinstvenu CRM referencu. Kontrolisati duplikate i pristup.","Primer: dve poruke o istom problemu predstavljaju jedan predmet; marketinška saglasnost se ne podrazumeva."]],[["Automatisieren mit Freigabe","Klassifikation, Vollständigkeitsprüfung und Antwortentwürfe können unterstützt werden. Angebote, sensible Daten, Rechtsfragen und externe Zusagen benötigen menschliche Kontrolle.","Beispiel: KI erstellt einen Antwortentwurf; die zuständige Person prüft Inhalt, Datenschutz und Versand."],["Automatizacija uz odobrenje","Klasifikacija, provera potpunosti i nacrti odgovora mogu se automatizovati. Ponude, osetljivi podaci i pravni zaključci zahtevaju ljudsku proveru.","Primer: AI pripremi odgovor, a odgovorna osoba proveri sadržaj i odobri slanje."]]];
const sources=["https://www.adac.de/rund-ums-fahrzeug/auto-kaufen-verkaufen/gebrauchtwagenkauf/gebrauchtwagen-kaufen/","https://www.adac.de/rund-ums-fahrzeug/auto-kaufen-verkaufen/gebrauchtwagenkauf/kfz-kaufvertrag/","https://www.carina.rs/putnici/uvoz-motornih-vozila/sporazumi.html","https://www.bundesnetzagentur.de/","https://www.bsi.bund.de/","https://www.bfdi.bund.de/"];
const i=guides.findIndex(g=>g.slug===guide.slug);const [heading,detail,example]=sections[i][de?0:1];
const url=`/${locale}/wissen/${guide.slug}/`;
---
<Base locale={locale} slug={`wissen/${guide.slug}`} title={guide[locale]+" | DANINI"} description={detail}>
<article class="section white"><div class="wrap"><p><a href={`/${locale}/wissen/`}>{de?"Wissen & Ratgeber":"Vodiči i saveti"}</a></p><small>{guide.category==="auto"?"AutoDanini":"DANINI Business"} · {de?"Informationsratgeber":"Informativni vodič"}</small><h1>{guide[locale]}</h1><p class="intro">{detail}</p><h2>{heading}</h2><p>{detail}</p><h2>{de?"Praxisbeispiel":"Praktični primer"}</h2><p>{example}</p><h2>{de?"Prüfschritte":"Koraci provere"}</h2><ol><li>{de?"Ausgangsdaten und Quelle festhalten.":"Zabeležiti polazne podatke i izvor."}</li><li>{de?"Belegte und offene Angaben trennen.":"Razdvojiti potvrđene i nedostajuće informacije."}</li><li>{de?"Risiken schriftlich klären, bevor verbindliche Entscheidungen getroffen werden.":"Razjasniti rizike pre obavezujuće odluke."}</li></ol><h2>{de?"Weiterführende Informationen":"Dodatne informacije"}</h2><p><a href={sources[i]} rel="noopener noreferrer">{de?"Externe Informationsquelle":"Spoljni informativni izvor"}</a> · {de?"Quellenstand zur fachlichen Prüfung: 17.11.2026":"Datum redakcijske pripreme: 17.11.2026"}</p><p><a href={`/${locale}/wissen/glossar/`}>{de?"Begriffe im Glossar":"Pojmovi u rečniku"}</a></p><p><a class="button" href={guide.category==="auto"?`/${locale}/auto-check/`:`/${locale}/business/`}>{de?"Passende DANINI-Leistung ansehen":"Pogledajte odgovarajuću DANINI uslugu"}</a></p><p><small>{de?"Keine Rechtsberatung oder technische Fahrzeugbegutachtung.":"Nije pravni savet niti tehnički pregled vozila."}</small></p></div></article>
</Base>