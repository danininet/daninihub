---
import Base from "../../../../layouts/Base.astro";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de"|"sr";
const de=locale==="de";
const root="/"+locale+"/";
const groups=de?[
 {title:"1. Inserat & Verkäufer",desc:"Vor Reise, Reservierung und Anzahlung",items:["Inserat mit Datum, Preis und Fahrzeugidentität speichern","Anbieter, Standort, Kontaktdaten und Verkaufsberechtigung klären","FIN (Fahrzeug-Identifizierungsnummer) schriftlich erfragen","Fragen zu Unfallschäden, Halterzahl und Reparaturen stellen"]},
 {title:"2. Unterlagen & Historie",desc:"Behauptungen von Belegen trennen",items:["Zulassungsbescheinigung Teil I/II auf Vollständigkeit prüfen","HU-Bericht, Kilometerstand und Wartungsbelege vergleichen","Rechnungen, Servicehistorie und bekannte Mängel abgleichen","Fehlende oder unlesbare Dokumente ausdrücklich notieren"]},
 {title:"3. Geld & nächster Schritt",desc:"Keine ungeprüfte Zahlung",items:["Anzahlungsbetrag, Empfänger, Zahlungsweg und Rückabwicklung schriftlich klären","Reise, Transport, Ausfuhr, Zoll/Steuern und Zulassung als Szenario erfassen","Bei Widersprüchen unabhängige Fahrzeugprüfung organisieren","Erst nach Klärung offener Punkte über Reise, Vertrag oder Zahlung entscheiden"]}
]:[
 {title:"1. Oglas i prodavac",desc:"Pre puta, rezervacije i kapare",items:["Sačuvaj oglas sa datumom, cenom i podacima o vozilu","Razjasni ko prodaje vozilo, gde se nalazi i da li ima pravo prodaje","Traži VIN (identifikacioni broj vozila) pre odlaska","Pitaj za udese, vlasnike, popravke i poznate kvarove"]},
 {title:"2. Dokumenta i istorija",desc:"Uporedi tvrdnje i dostupne dokaze",items:["Proveri da li postoje Zulassungsbescheinigung Teil I i II","Uporedi HU/TÜV izveštaj, kilometražu i servisnu evidenciju","Pregledaj račune za popravke, servise i navode o oštećenjima","Zapiši sva nedostajuća i nečitka dokumenta"]},
 {title:"3. Novac i sledeći korak",desc:"Ne plaćaj pod pritiskom",items:["Pre kapare razjasni primaoca, račun, iznos, rok i uslove povrata","Odvojeno proceni put, transport, izvoz, carinu, PDV i registraciju","Za kontradiktorne navode organizuj nezavisan tehnički pregled","O putu, ugovoru i uplati odluči tek kada su ključne nejasnoće razjašnjene"]}
];
---
<Base locale={locale} slug="wissen/checkliste" title={de?"Kostenlose Checkliste: Gebrauchtwagen vor Anzahlung prüfen":"Besplatna kontrolna lista: automobil pre puta i kapare"} description={de?"12 konkrete Prüfpunkte für Inserat, Verkäufer, Fahrzeugpapiere und Anzahlung. Kostenlos ohne Registrierung und druckbar.":"12 konkretnih stavki za proveru oglasa, prodavca, dokumentacije i kapare. Besplatno i spremno za štampu."}>
<section class="cl-hero"><div class="wrap cl-width"><a class="cl-back" href={root+"wissen/"}>← {de?"Zur Ratgeber-Übersicht":"Nazad na vodiče"}</a><p class="cl-kicker">AUTODANINI · {de?"KOSTENLOSE PRÜFLISTE":"BESPLATNA KONTROLNA LISTA"}</p><h1>{de?"Gebrauchtwagen in Deutschland? Prüfen Sie diese 12 Punkte vor der Anzahlung.":"Kupujete auto u Nemačkoj? Proverite ovih 12 stvari pre kapare."}</h1><p>{de?"Eine kurze, praktische Liste für den ersten Faktencheck. Sie können sie direkt verwenden oder ausdrucken. Keine E-Mail-Adresse erforderlich.":"Praktična lista za početnu proveru, bez registracije i ostavljanja e-mail adrese. Možete je odmah koristiti ili odštampati."}</p><div class="cl-actions"><button class="cl-btn" type="button" onclick="window.print()">{de?"Checkliste drucken / PDF speichern":"Odštampaj / Sačuvaj kao PDF"}</button><a class="cl-btn cl-secondary" href={root+"auto-check/"}>{de?"Anzeige vorprüfen lassen":"Pošalji oglas na preliminarnu proveru"} →</a></div><small>{de?"Kein Download-Versprechen: Ihre Browser-Druckfunktion speichert auf Wunsch als PDF.":"PDF se može sačuvati opcijom „Štampaj → Sačuvaj kao PDF“ u pregledaču."}</small></div></section>
<section class="cl-main"><div class="wrap cl-width">
<div class="cl-topline"><strong>{de?"VORPRÜFUNG – KEINE TECHNISCHE ABNAHME":"PRELIMINARNA PROVERA – NIJE TEHNIČKI PREGLED"}</strong><span>{de?"DANINI · 20.11.2026":"DANINI · 20.11.2026"}</span></div>
{groups.map((g,i)=><section class="cl-group"><div class="cl-heading"><span>{"0"+(i+1)}</span><div><h2>{g.title}</h2><p>{g.desc}</p></div></div><ul>{g.items.map(item=><li><span class="cl-square" aria-hidden="true"></span><span>{item}</span></li>)}</ul></section>)}
<section class="cl-notes"><h2>{de?"Notieren Sie offene Fragen":"Zapišite nejasnoće"}</h2><p>{de?"Für jedes Dokument: Quelle, Datum und Frage. Ungeklärte Punkte bleiben ungeklärt – sie werden nicht als bestätigt markiert.":"Za svaki dokument zapišite izvor, datum i pitanje. Ono što nije provereno mora ostati označeno kao nepoznato."}</p><div class="cl-note-lines" aria-label={de?"Freies Notizfeld für den Ausdruck":"Prostor za beleške pri štampi"}></div></section>
<div class="cl-cta"><p class="cl-kicker">{de?"WENN ANGABEN FEHLEN":"AKO NEŠTO NEDOSTAJE"}</p><h2>{de?"Sie müssen nicht nur raten.":"Ne morate odlučivati napamet."}</h2><p>{de?"DANINI kann übermittelte Inseratsangaben und Dokumente vorab strukturieren: bestätigte Aussagen, Widersprüche, Fragen an den Verkäufer und mögliche Folgekosten. Keine FIN-Datenbankgarantie, keine Besichtigung vor Ort.":"AutoDanini može da strukturira informacije iz dostavljenog oglasa i dokumentacije: šta je potvrđeno, šta je sporno, šta pitati prodavca i koje troškove razmotriti. Bez garancije o VIN istoriji ili fizičkom stanju vozila."}</p><div class="cl-actions"><a class="cl-btn" href={root+"auto-check/"}>{de?"AutoDanini Anfrage starten":"Pošalji AutoDanini upit"}</a><a class="cl-btn cl-secondary" href={root+"wissen/produkte/"}>{de?"Dossier & PDF-Ratgeber ansehen":"Dosije i digitalni PDF vodič"} →</a></div></div>
<p class="cl-disclaimer">{de?"Informationshilfe ohne individuelle Rechts-, Zoll- oder Steuerberatung. Für den technischen Zustand ist eine unabhängige Fahrzeugprüfung erforderlich.":"Informativna pomoć; nije nezavisan tehnički pregled, pravno, carinsko ni poresko savetovanje. Za tehničko stanje potreban je stručni pregled."}</p>
</div></section>
</Base>
<style>
.cl-hero{background:linear-gradient(115deg,#102135,#0b3a4a);color:#fff;padding:clamp(48px,6vw,78px) 0}.cl-width{max-width:1000px}.cl-back{color:#cfdee5;text-decoration:underline;text-underline-offset:4px;font-weight:650}.cl-kicker{color:#e5c56a;font-weight:850;letter-spacing:.13em;font-size:.75rem}.cl-hero h1{font-size:clamp(2.3rem,4.2vw,4rem);max-width:820px;color:#fff;margin:15px 0}.cl-hero p:not(.cl-kicker){color:#dce9f0;font-size:1.1rem;max-width:75ch}.cl-hero small{color:#bdcfd8}.cl-actions{display:flex;flex-wrap:wrap;gap:13px;margin:26px 0 14px}.cl-btn{background:#facc15;color:#11283b;padding:14px 19px;min-height:49px;border:1px solid #facc15;border-radius:9px;font-weight:850;cursor:pointer;font:inherit;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.cl-secondary{color:#fff;border:1px solid #a9c5d3;background:transparent}.cl-main{background:#f5f8fa;padding:48px 0 80px}.cl-topline{display:flex;flex-wrap:wrap;justify-content:space-between;gap:14px;color:#365368;font-size:.76rem;letter-spacing:.04em;padding-bottom:22px;border-bottom:2px solid #d6e1e7}.cl-group{background:#fff;border:1px solid #d4e2e9;border-radius:18px;padding:clamp(18px,3vw,32px);margin:24px 0;box-shadow:0 10px 30px #0f354009;break-inside:avoid}.cl-heading{display:flex;align-items:flex-start;gap:20px}.cl-heading>span{display:grid;place-items:center;background:#13364c;color:#facc15;border-radius:11px;font-weight:850;min-width:48px;height:48px}.cl-heading h2{font-size:1.55rem;color:#11283b;margin:0}.cl-heading p{margin:3px 0 8px;color:#526b7c}.cl-group ul{list-style:none;margin:14px 0 0;padding:0}.cl-group li{display:flex;align-items:flex-start;gap:14px;padding:14px 0;border-top:1px solid #e5edf0;color:#1c3647;line-height:1.55}.cl-square{width:20px;height:20px;min-width:20px;border:2px solid #0e6d75;border-radius:4px;margin-top:2px}.cl-notes{padding:28px;background:#e7f0f4;border-radius:16px;margin:30px 0}.cl-notes h2{color:#18384a}.cl-note-lines{height:125px;background:repeating-linear-gradient(to bottom,transparent 0px,transparent 29px,#99b9c9 30px,#99b9c9 31px)}.cl-cta{background:#123045;color:#fff;padding:clamp(22px,4vw,45px);border-radius:18px;margin-top:30px}.cl-cta h2{color:#fff}.cl-cta p:not(.cl-kicker){color:#d6e6ef}.cl-disclaimer{font-size:.8rem;color:#516575}@media(max-width:600px){.cl-main{padding:24px 0 55px}.cl-heading{gap:12px}.cl-heading>span{min-width:38px;height:38px}.cl-heading h2{font-size:1.32rem}}@media print{@page{size:A4;margin:13mm}header,footer,.cl-back,.cl-actions,.cl-cta{display:none!important}.cl-hero{color:#000;background:#fff;padding:0 0 12px}.cl-hero h1,.cl-hero p:not(.cl-kicker),.cl-kicker{color:#000!important}.cl-main{background:#fff;padding:0}.cl-group{box-shadow:none;border:1px solid #999;padding:12px;margin:12px 0;break-inside:avoid}.cl-group li{padding:6px 0}.cl-notes{background:#fff;border:1px solid #ccc}.cl-disclaimer{font-size:9pt}}
</style>
