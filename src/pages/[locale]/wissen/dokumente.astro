---
import Base from "../../../layouts/Base.astro";
import {documentDrafts} from "../../../lib/document-drafts";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de"|"sr";const de=locale==="de";
const legalPaths=["impressum","datenschutz","agb"];
---
<Base locale={locale} slug="wissen/dokumente" title={de?"Dokumente & Vorlagen":"Dokumenti i obrasci"} description={de?"Leistungsbeschreibungen, Checklisten und nicht freigegebene Vertragsentwürfe für AutoDanini und DANINI Business.":"Opisi usluga, kontrolne liste i nacrti ugovora za AutoDanini i DANINI Business."}>
<section class="section white"><div class="wrap"><p><a href={`/${locale}/wissen/`}>{de?"Wissen & Ratgeber":"Vodiči i saveti"}</a></p><h1>{de?"Dokumente & Vorlagen":"Dokumenti i obrasci"}</h1><p class="draft-status"><strong>{de?"Arbeitsentwürfe – rechtliche Prüfung und ausdrückliche Freigabe ausstehend. Keine Vertragsbedingungen werden hiermit aktiviert.":"Radni nacrti – pravna provera i izričito odobrenje nisu završeni. Nijedan ugovorni uslov ovime nije aktiviran."}</strong></p><div class="document-grid">{documentDrafts.map(doc=><article class="document-card"><small>{doc.cat==="auto"?"AutoDanini":"DANINI Business"}</small><h2>{doc.name[de?0:1]}</h2><p>{de?"Druckbare, ausdrücklich unverbindliche Arbeitsvorlage.":"Obrazac za štampanje, jasno označen kao neobavezujući nacrt."}</p><a href={`/${locale}/wissen/dokumente/${doc.slug}/`}>{de?"Entwurf ansehen":"Pogledajte nacrt"}</a></article>)}</div><h2>{de?"Rechtliche Pflichtinformationen":"Pravne informacije"}</h2><p>{de?"Bestehende Rechtstexte sind getrennt von diesen Vorlagen; diese Seite ersetzt sie nicht.":"Postojeći pravni tekstovi su odvojeni od obrazaca i ova stranica ih ne menja."}</p><ul>{legalPaths.map(path=><li><a href={`/${locale}/${path}/`}>{path}</a></li>)}</ul><p>{de?"Bitte klären Sie vor einer Beauftragung Leistungsgrenzen, Datenschutz, gegebenenfalls AVV, Vergütung sowie erforderliche Widerrufsbelehrungen individuell.":"Pre narudžbine potrebno je posebno potvrditi obim, zaštitu podataka, eventualni DPA/AVV, cenu i potrebna obaveštenja o odustanku."}</p></div></section>
<style>.document-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin:1.5rem 0}.document-card{border:1px solid #cddae1;padding:1.4rem;border-radius:14px;background:#f4f8fa}.document-card h2{font-size:1.18rem;margin:.6rem 0}.document-card a{color:#075b72;text-decoration:underline;font-weight:700}.draft-status{padding:1rem 1.3rem;border-left:4px solid #b97b18;background:#fff5db;color:#4b3611}@media(max-width:640px){.document-grid{grid-template-columns:1fr}}</style>
</Base>