---
import Base from "../../../layouts/Base.astro";
import {glossary} from "../../../lib/knowledge";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de"|"sr";const de=locale==="de";
---
<Base locale={locale} slug="wissen/glossar" title={de?"Glossar – Fahrzeug & digitale Geschäftsprozesse":"Rečnik – vozila i digitalni poslovni procesi"} description={de?"24 praxisorientierte Begriffe aus Fahrzeugkauf und digitaler Administration.":"24 praktična pojma iz kupovine vozila i digitalne administracije."}>
<section class="section white"><div class="wrap"><p><a href={`/${locale}/wissen/`}>{de?"Wissen & Ratgeber":"Vodiči i saveti"}</a></p><h1>{de?"Glossar":"Rečnik pojmova"}</h1><p>{de?"Begriffe, Bedeutung, Anwendungsbeispiele und weiterführende Ratgeber.":"Pojmovi, značenje, primeri primene i povezani vodiči."}</p><nav class="term-index" aria-label={de?"Begriffsverzeichnis":"Spisak pojmova"}>{glossary.map((g,i)=><a href={`#begriff-${i+1}`}>{g.name}</a>)}</nav>{glossary.map((g,i)=><article id={`begriff-${i+1}`} class="glossary-item"><small>{g.category==="auto"?"AutoDanini":"DANINI Business"}</small><h2>{g.name}</h2><p>{g[locale]}</p><p><strong>{de?"Praxisbeispiel":"Praktični primer"}:</strong> {de?g.exampleDe:g.exampleSr}</p><p><strong>{de?"Verwandte Begriffe":"Povezani pojmovi"}:</strong> {g.related.map((n,j)=><span><a href={`#begriff-${n+1}`}>{glossary[n].name}</a>{j===0?" · ":""}</span>)}</p><p><a href={`/${locale}/wissen/${g.guide}/`}>{de?"Passender Ratgeber":"Povezani vodič"}</a> · <a href={g.category==="auto"?`/${locale}/auto-check/`:`/${locale}/business/`}>{de?"Passende Leistung":"Odgovarajuća usluga"}</a></p></article>)}</div></section>
<style>.term-index{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.5rem 0 2rem}.term-index a{display:inline-flex;padding:.5rem .8rem;background:#eff5f6;color:#164355;border:1px solid #b8cbd3;border-radius:20px;font-size:.87rem}.glossary-item{padding:1.6rem 0;border-bottom:1px solid #cddbe0;scroll-margin-top:2rem}.glossary-item p{max-width:74ch;line-height:1.75}.glossary-item a{color:#075b72;text-decoration:underline;text-underline-offset:3px}</style>
</Base>