---
import Base from "../../../layouts/Base.astro";
import {guides} from "../../../lib/knowledge";
import {originalEvergreen} from "../../../lib/original-evergreen";
import {srBusinessEvergreen} from "../../../lib/sr-business-evergreen";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de"|"sr";
const de=locale==="de";
const root="/"+locale+"/";
const autoGuides=guides.filter(g=>g.category==="auto");
const businessGuides=guides.filter(g=>g.category==="business");
const originals=[...originalEvergreen,...srBusinessEvergreen].filter(a=>a.locale===locale);
const coverAuto="/images/DANINI_Kartica_01_Salon_Auto_Bez_Osobe.jpg";
const coverDocs="/images/DANINI_Kartica_02_Uvoz_Dokumentacija_EUR1.jpg";
---
<Base locale={locale} slug="wissen" title={de?"Wissen & Ratgeber: Auto prüfen, Anfragen organisieren":"Vodiči i saveti: provera vozila i poslovni upiti"} description={de?"Fundierte Praxishilfen für Fahrzeugkauf vor Anzahlung und digitale Kundenanfragen. Kostenlose Checkliste, Produktübersicht und passende Leistungen.":"Praktični vodiči za proveru polovnih vozila pre kapare i organizaciju poslovnih upita. Besplatna kontrolna lista i konkretne usluge."}>
<section class="kh-hero">
 <div class="wrap kh-hero-grid">
  <div>
   <p class="kh-overline">DANINI / {de?"WISSEN & RATGEBER":"VODIČI I SAVETI"}</p>
   <h1>{de?"Erst Klarheit. Dann die Entscheidung.":"Prvo proverite. Onda odlučite."}</h1>
   <p class="kh-lead">{de?"Ob Gebrauchtwagen aus Deutschland oder Kundenanfragen im Unternehmen: Hier finden Sie verständliche Prüfwege, echte Entscheidungshilfen und den nächsten sinnvollen Schritt.":"Bilo da kupujete automobil u Nemačkoj ili organizujete upite svoje firme: pronađite konkretne korake, pitanja za proveru i jasno objašnjene usluge."}</p>
   <div class="kh-actions"><a class="kh-btn" href={root+"wissen/checkliste/"}>{de?"Kostenlose Auto-Checkliste öffnen":"Otvori besplatnu auto-checklistu"} <span aria-hidden="true">↗</span></a><a class="kh-btn kh-ghost" href={root+"wissen/produkte/"}>{de?"Produkte & Leistungen ansehen":"Pogledaj proizvode i usluge"}</a></div>
   <p class="kh-note">{de?"Ohne Registrierung lesbar. Keine automatischen Kauf- oder Sicherheitsgarantien.":"Besplatno čitanje bez registracije. Bez obećanja o sigurnosti vozila ili uspehu posla."}</p>
  </div>
  <figure class="kh-hero-visual"><img src={coverAuto} width="960" height="560" alt={de?"Symbolische Aufnahme eines Gebrauchtwagen-Angebots":"Ilustracija polovnih automobila u salonu"} decoding="async"/><figcaption>{de?"Informationen vor Fahrt und Anzahlung einordnen.":"Dokumenta i navode prodavca proverite pre puta i kapare."}</figcaption></figure>
 </div>
</section>
<section class="kh-bar"><div class="wrap kh-benefits">
 <div><strong>01</strong><span>{de?"Fakten und Annahmen trennen":"Odvojite činjenice od pretpostavki"}</span></div>
 <div><strong>02</strong><span>{de?"Fehlende Unterlagen erkennen":"Otkrijte šta od dokumentacije nedostaje"}</span></div>
 <div><strong>03</strong><span>{de?"Den nächsten Schritt planen":"Odaberite konkretan sledeći korak"}</span></div>
</div></section>
<section class="section white kh-section-light"><div class="wrap kh-content">
 <div class="kh-section-intro"><p class="kh-kicker">{de?"ZWEI SCHWERPUNKTE":"DVE OBLASTI"}</p><h2>{de?"Welches Problem möchten Sie lösen?":"Šta želite da rešite?"}</h2><p>{de?"Wählen Sie ein Thema. Jeder Weg führt zu einer nutzbaren Checkliste, konkreten Artikeln und einer klar beschriebenen DANINI-Leistung.":"Izaberite problem. Svaka oblast ima praktične vodiče, primer rezultata i odgovarajuću DANINI uslugu."}</p></div>
 <div class="kh-paths">
  <article class="kh-path kh-auto"><div class="kh-photo"><img src={coverDocs} width="960" height="560" loading="lazy" alt={de?"Fahrzeugunterlagen und Importdokumente":"Dokumentacija vozila i uvoza"}/><span>AutoDanini</span></div><div class="kh-card-body"><h3>{de?"Auto in Deutschland gefunden?":"Našli ste automobil u Nemačkoj?"}</h3><p>{de?"Anzeige, FIN, Fahrzeugpapiere und Verkäuferangaben vor Reise und Anzahlung systematisch prüfen.":"Sredite informacije iz oglasa, VIN, dokumenta i pitanja prodavcu pre putovanja ili uplate kapare."}</p><ul>{autoGuides.map(g=><li><a href={root+"wissen/"+g.slug+"/"}>{g[locale]} <span aria-hidden="true">↗</span></a></li>)}</ul><div class="kh-card-actions"><a class="kh-card-cta" href={root+"wissen/checkliste/"}>{de?"Checkliste öffnen":"Besplatna kontrolna lista"}</a><a href={root+"auto-check/"}>{de?"AutoDanini anfragen":"AutoDanini upit"} →</a></div></div></article>
  <article class="kh-path kh-business"><div class="kh-process" role="img" aria-label={de?"Geschäftsanfrage, Prüfung, menschliche Freigabe":"Poslovni upit, provera i ljudsko odobrenje"}><div><small>01</small><b>{de?"ANFRAGE":"UPIT"}</b></div><i aria-hidden="true">→</i><div><small>02</small><b>{de?"PRÜFUNG":"PROVERA"}</b></div><i aria-hidden="true">→</i><div><small>03</small><b>{de?"FREIGABE":"ODOBRENJE"}</b></div></div><div class="kh-card-body"><h3>{de?"Kundenanfragen gehen unter?":"Poslovni upiti se gube ili kasne?"}</h3><p>{de?"E-Mail, Formulare und CRM so organisieren, dass Zuständigkeit, fehlende Angaben und Antwortentwürfe nachvollziehbar bleiben.":"Uredite poslovne upite iz e-maila i formulara, pratite status i pripremite nacrte odgovora uz ljudsku proveru."}</p><ul>{businessGuides.map(g=><li><a href={root+"wissen/"+g.slug+"/"}>{g[locale]} <span aria-hidden="true">↗</span></a></li>)}</ul><div class="kh-card-actions"><a class="kh-card-cta" href={root+"business/"}>{de?"Business Check anfragen":"Zatraži Business Check"}</a><a href={root+"wissen/produkte/"}>{de?"Angebot ansehen":"Pogledaj ponudu"} →</a></div></div></article>
 </div>
</div></section>
<section class="kh-product-band"><div class="wrap kh-product-grid">
 <div><p class="kh-kicker">{de?"KONKRETES ANGEBOT":"KONKRETNA PONUDA"}</p><h2>{de?"Ein Leitfaden ist der Anfang. Ein prüfbares Ergebnis ist das Ziel.":"Vodič je početak. Dosije i jasna odluka su cilj."}</h2><p>{de?"Der bestehende Auto-Biznis Master-PDF ist technisch privat hinterlegt (bisheriger Testpreis 49 €). Der öffentliche PayPal-Kauf bleibt bis zur Freigabe deaktiviert. DANINI Business bietet einen abgegrenzten Business Check auf Anfrage.":"Postojeći Auto-Biznis Master PDF tehnički je pripremljen u privatnoj bazi (ranije definisana cena 49 €). Javna PayPal kupovina još nije aktivna. Business Check je usluga po dogovorenom obimu."}</p><a class="kh-btn" href={root+"wissen/produkte/"}>{de?"Alle verfügbaren Schritte & Produktstatus":"Proizvodi, status i sledeći koraci"} ↗</a></div>
 <aside class="kh-result"><p>{de?"BEISPIEL FÜR EIN ERGEBNIS":"PRIMER KRAJNJEG REZULTATA"} · {de?"DEMO":"DEMO"}</p><h3>{de?"Entscheidungsnotiz":"Dosije odluke"}</h3><dl><div><dt>{de?"Angabe":"Navod"}</dt><dd>{de?"„Unfallfrei“ im Inserat":"„Bez udesa“ u oglasu"}</dd></div><div><dt>{de?"Unklar":"Nejasno"}</dt><dd>{de?"Reparaturbeleg liegt vor":"Postoji račun za popravku"}</dd></div><div><dt>{de?"Nächster Schritt":"Sledeći korak"}</dt><dd>{de?"Schriftliche Erklärung und Fachprüfung einholen":"Tražiti pisano objašnjenje i stručnu proveru"}</dd></div></dl><small>{de?"Fiktives Beispiel, keine echte Kundenakte.":"Izmišljen primer, nije stvarni predmet kupca."}</small></aside>
</div></section>
<section class="section white kh-section-light"><div class="wrap kh-library">
 <div class="kh-section-intro"><p class="kh-kicker">{de?"VERTIEFEN":"DETALJNIJE"}</p><h2>{de?"Fachartikel mit Quellen und Prüffragen":"Detaljni vodiči sa izvorima i pitanjima za proveru"}</h2><p>{de?"Vorhandene SEO-Artikel, ursprüngliche URLs und der Importrechner bleiben bestehen.":"Postojeći SEO URL-ovi, izvorni članci i kalkulator uvoza ostaju sačuvani."}</p></div>
 <div class="kh-article-grid">{!de && <article class="kh-article"><span>DANINI Business · Vodič</span><h3><a href="/sr/wissen/javne-nabavke-nemacka-balkan-vodic/">Javne nabavke u Nemačkoj za firme sa Balkana</a></h3><p>CPV, e-Vergabe, dokumentacija, rizici i javni demo izveštaj sa kontrolnom listom.</p><a class="kh-read" href="/sr/wissen/javne-nabavke-nemacka-balkan-vodic/">Pročitaj vodič i preuzmi demo →</a></article>}{originals.map(a=><article class="kh-article"><span>{a.key.startsWith("auto")?"AutoDanini":"DANINI Business"}</span><h3><a href={root+"wissen/"+a.slug+"/"}>{a.title}</a></h3><p>{a.description}</p><a class="kh-read" href={root+"wissen/"+a.slug+"/"}>{de?"Ratgeber lesen":"Pročitaj vodič"} →</a></article>)}</div>
 <div class="kh-tools"><a href={root+"wissen/glossar/"}>{de?"Glossar · 24 Begriffe":"Rečnik · 24 pojma"} ↗</a><a href={root+"wissen/dokumente/"}>{de?"Dokumente & Vorlagen":"Dokumenti i obrasci"} ↗</a><a href="/auto/import/">{de?"Vorhandenen Importrechner ansehen":"Postojeći kalkulator uvoza"} ↗</a></div>
</div></section>
<section class="kh-academy"><div class="wrap kh-academy-flex"><div><p class="kh-kicker">DANINI AKADEMIJA</p><h2>{de?"Lernen, wie Sie Ihr eigenes Online-Business mit KI aufbauen.":"Nauči kako da uz AI izgradiš sopstveni online biznis."}</h2><p>{de?"DANINI Wissen ist ein Teil der Akademie: Hier vertiefen Sie einzelne Probleme. Die kostenlose erste Lektion zeigt die übertragbare Methode für jede verantwortungsvoll gewählte Nische." : "Vodiči su deo DANINI Akademije. Ovde rešavaš pojedinačne probleme, a prva besplatna lekcija pokazuje metodu za bilo koju odgovorno odabranu poslovnu nišu."}</p></div><a class="kh-btn" href={root+"akademija/"}>{de?"Kostenlose KI-Lektion öffnen":"Otvori besplatnu AI lekciju"} →</a></div></section>
<section class="kh-partner"><div class="wrap kh-partner-inner"><div><p class="kh-kicker">{de?"FÜR FACHBETRIEBE & EMPFEHLUNGSPARTNER":"ZA STRUČNJAKE I PARTNERE"}</p><h2>{de?"Gemeinsam helfen, ohne ungeprüfte Versprechen.":"Saradnja sa jasnim pravilima, bez lažnih obećanja."}</h2><p>{de?"Prüfstellen, Werkstätten, Händler und B2B-Dienstleister: Wir prüfen zunächst fachliche Passung und transparente Zuständigkeiten. Noch kein aktives Provisionsprogramm.":"Auto-servisi, stručne kontrole, trgovci i B2B saradnici: najpre proveravamo kompatibilnost i odgovornost. Provizijski program još nije aktivan."}</p></div><a class="kh-btn kh-ghost" href={root+"wissen/partner/"}>{de?"Partnerschaft prüfen":"Proverite mogućnost saradnje"} →</a></div></section>
</Base>
<style>
.kh-academy{background:#e6f1f3;padding:clamp(42px,6vw,80px) 0}.kh-academy-flex{display:flex;align-items:center;justify-content:space-between;gap:30px}.kh-academy-flex>div{max-width:800px}.kh-academy h2{color:#133447;font-size:clamp(1.8rem,3vw,2.7rem)}.kh-academy p:not(.kh-kicker){color:#395467}.kh-academy .kh-btn{flex-shrink:0}@media(max-width:820px){.kh-academy-flex{flex-direction:column;align-items:flex-start}}
.kh-hero{background:radial-gradient(circle at 15% 15%,#244d62 0%,transparent 44%),linear-gradient(115deg,#0b1828,#0d2b42);color:#fff;padding:clamp(56px,6vw,94px) 0}.kh-hero-grid{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(330px,.88fr);gap:clamp(32px,5vw,70px);align-items:center}.kh-overline,.kh-kicker{font-size:.75rem;font-weight:850;letter-spacing:.14em;color:#d8b56d}.kh-hero h1{color:#fff;font-size:clamp(2.65rem,5vw,5.2rem);max-width:720px;margin:20px 0 24px;line-height:1.05}.kh-lead{color:#e2edf5;font-size:clamp(1.04rem,1.4vw,1.2rem);max-width:64ch}.kh-actions{display:flex;gap:12px;flex-wrap:wrap;margin:30px 0 18px}.kh-btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;background:#facc15;color:#0b1828;font-weight:850;padding:16px 21px;border:1px solid #facc15;border-radius:10px;min-height:52px;text-align:center;line-height:1.35}.kh-btn.kh-ghost{background:transparent;border-color:#99bbcd;color:#fff}.kh-note{font-size:.8rem;color:#c4d7e3}.kh-hero-visual{margin:0;position:relative}.kh-hero-visual img{display:block;width:100%;height:auto;aspect-ratio:5/4;object-fit:cover;border-radius:20px;box-shadow:0 30px 80px #0005}.kh-hero-visual figcaption{background:#fff;color:#1c3448;padding:16px 20px;position:relative;max-width:92%;margin:-22px auto 0;border-radius:12px;box-shadow:0 12px 30px #0002;font-size:.9rem;font-weight:750}.kh-bar{background:#eaf1f4;border-bottom:1px solid #d7e3e8}.kh-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;padding-block:22px}.kh-benefits>div{display:flex;gap:14px;align-items:center;font-size:.9rem;color:#18384a;font-weight:730}.kh-benefits strong{color:#0f6b72}.kh-content,.kh-library{padding-block:clamp(20px,4vw,48px)}.kh-section-intro{max-width:800px;margin-bottom:34px}.kh-section-intro h2{font-size:clamp(2rem,3.3vw,3.1rem);color:#0f2538}.kh-section-intro>p:last-child{font-size:1.04rem;color:#405668}.kh-paths{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.kh-path{border:1px solid #d0dde4;border-radius:20px;overflow:hidden;background:#fff;box-shadow:0 10px 34px #0b2a400b;min-width:0}.kh-photo{position:relative}.kh-photo img{display:block;width:100%;height:auto;aspect-ratio:16/8;object-fit:cover}.kh-photo>span{position:absolute;left:20px;bottom:16px;background:#0b2438;color:#fff;font-size:.8rem;font-weight:800;border-radius:8px;padding:7px 12px}.kh-process{aspect-ratio:16/8;min-height:200px;background:linear-gradient(135deg,#10263b,#0c585e);display:flex;align-items:center;justify-content:center;gap:7px;color:#fff;padding:18px}.kh-process div{border:1px solid #90bac3;background:#ffffff10;border-radius:12px;padding:15px 12px;text-align:center;min-width:0;flex:1}.kh-process small{display:block;color:#e7ca79}.kh-process b{font-size:clamp(.75rem,1.2vw,.95rem)}.kh-process i{font-size:24px;color:#ffe08b;font-style:normal}.kh-card-body{padding:clamp(20px,2.5vw,32px)}.kh-card-body h3{font-size:clamp(1.35rem,2.2vw,1.8rem);line-height:1.2;color:#152a3d;margin:8px 0 12px}.kh-card-body p{color:#42586a}.kh-card-body ul{padding-left:20px;min-height:150px}.kh-card-body li{margin:10px 0}.kh-card-body li a{color:#075b72;text-decoration:underline;text-underline-offset:3px}.kh-card-actions{display:flex;align-items:center;flex-wrap:wrap;gap:14px;margin-top:27px}.kh-card-actions>a{font-size:.9rem;font-weight:800;color:#075b72}.kh-card-actions .kh-card-cta{background:#0d3345;color:#fff;padding:14px;border-radius:10px;text-decoration:none}.kh-product-band{background:#123249;color:#fff;padding:clamp(60px,7vw,96px) 0}.kh-product-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(30px,5vw,70px);align-items:center}.kh-product-band h2,.kh-partner h2{color:#fff;font-size:clamp(2rem,3.4vw,3.3rem)}.kh-product-band p{color:#d9e8f0}.kh-result{background:#f9fbfc;color:#12293a;padding:clamp(22px,3vw,36px);border-radius:18px;box-shadow:0 22px 65px #0003}.kh-result>p{font-size:.7rem;letter-spacing:.14em;font-weight:850;color:#0d5c69}.kh-result h3{color:#152a3c}.kh-result dl{margin:0}.kh-result dl div{border-top:1px solid #dae4e9;padding:12px 0}.kh-result dt{font-size:.75rem;font-weight:850;color:#39707b}.kh-result dd{margin:2px 0 0;font-size:.95rem;color:#203b4e}.kh-result small{color:#526674}.kh-library .kh-article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.kh-article{border:1px solid #d8e3e8;background:#f7fafb;border-radius:16px;padding:23px;min-width:0}.kh-article>span{font-size:.72rem;color:#0c6e70;font-weight:850;letter-spacing:.07em}.kh-article h3{font-size:1.24rem;line-height:1.3;overflow-wrap:anywhere;color:#142a3b}.kh-article h3 a:hover{text-decoration:underline}.kh-article p{font-size:.93rem;color:#41596a}.kh-read{color:#075b72;font-weight:850;text-decoration:underline}.kh-tools{display:flex;gap:13px;flex-wrap:wrap;margin-top:25px}.kh-tools a{border:1px solid #a7c2cb;padding:12px 16px;border-radius:10px;color:#0e5164;font-weight:750}.kh-partner{background:#0f2234;padding:55px 0}.kh-partner-inner{display:flex;align-items:center;justify-content:space-between;gap:36px}.kh-partner-inner>div{max-width:760px}.kh-partner h2{font-size:clamp(1.7rem,2.7vw,2.6rem)}.kh-partner p:not(.kh-kicker){color:#d8e7ee}.kh-partner .kh-btn{white-space:normal;flex-shrink:0}
@media(max-width:960px){.kh-hero-grid,.kh-product-grid{grid-template-columns:1fr}.kh-hero-visual{max-width:730px}.kh-library .kh-article-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.kh-partner-inner{flex-direction:column;align-items:flex-start}}@media(max-width:700px){.kh-paths,.kh-benefits,.kh-library .kh-article-grid{grid-template-columns:1fr}.kh-hero{padding:48px 0}.kh-hero h1{font-size:clamp(2.45rem,9vw,3.6rem)}.kh-benefits>div{padding:4px 0}.kh-path ul{min-height:0}.kh-process{min-height:170px}.kh-process div{padding:10px 4px}.kh-process i{font-size:17px}}@media(prefers-reduced-motion:no-preference){.kh-btn,.kh-card-cta,.kh-article{transition:transform .15s ease,box-shadow .15s ease}.kh-btn:hover,.kh-card-cta:hover{transform:translateY(-2px)}.kh-article:hover{box-shadow:0 14px 35px #0b2a4017}}

/* WCAG AA: restore legible knowledge section titles on light panels. */
.section.white.kh-section-light{background:#f4f8fb;color:#17384a}
.kh-section-light .kh-section-intro h2{color:#102d41}
.kh-section-light .kh-section-intro>p:last-child{color:#365468}
.kh-section-light .kh-kicker,.kh-academy .kh-kicker{color:#75520b}
.kh-section-light .kh-tools a:focus-visible,.kh-section-light .kh-article a:focus-visible{outline:3px solid #0d7377;outline-offset:4px}
</style>
