---
import Base from "../../../layouts/Base.astro";
import {guides} from "../../../lib/knowledge";
import {originalEvergreen} from "../../../lib/original-evergreen";
import {srBusinessEvergreen} from "../../../lib/sr-business-evergreen";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de"|"sr"; const de=locale==="de";
const autoGuides=guides.filter(g=>g.category==="auto");
const businessGuides=guides.filter(g=>g.category==="business");
const originals=[...originalEvergreen,...srBusinessEvergreen].filter(o=>o.locale===locale);
---
<Base locale={locale} slug="wissen" title={de?"DANINI Wissen & Ratgeber":"DANINI Vodiči i saveti"} description={de?"Fahrzeugkauf, Dokumente und digitale Büroprozesse verständlich erklärt.":"Kupovina vozila, dokumentacija i digitalni poslovni procesi na jednom mestu."}>
<section class="section white"><div class="wrap knowledge-home">
<p class="eyebrow">DANINI · {de?"WISSEN & RATGEBER":"VODIČI I SAVETI"}</p><h1>{de?"Wissen für bessere Entscheidungen":"Znanje za sigurnije odluke"}</h1><p class="intro">{de?"Praktische Informationen vor einer Auto-Anzahlung und zur Organisation von Geschäftsanfragen. Keine pauschalen Garantien – Quellen, offene Fragen und nächste Schritte.":"Praktične informacije pre kapare za vozilo i za organizaciju poslovnih upita. Bez neutemeljenih garancija – izvori, otvorena pitanja i konkretni koraci."}</p>
<div class="knowledge-shortcuts"><a href={`/${locale}/wissen/glossar/`}>{de?"Glossar: 24 Begriffe":"Rečnik: 24 pojma"}</a><a href={`/${locale}/wissen/dokumente/`}>{de?"Dokumente & Vorlagen":"Dokumenti i obrasci"}</a><a href={`/${locale}/#kontakt`}>{de?"Kontakt":"Kontakt"}</a></div>
<div class="knowledge-verticals">
<article class="knowledge-vertical"><img src="/images/DANINI_Kartica_01_Salon_Auto_Bez_Osobe.jpg" alt={de?"Fahrzeuge in einem Autosalon als Symbol für die Kaufvorbereitung":"Vozila u auto-salonu kao ilustracija pripreme kupovine"} width="960" height="560" loading="lazy" decoding="async"/><div class="knowledge-info"><p class="eyebrow">AutoDanini</p><h2>{de?"Vor Reise und Anzahlung besser prüfen":"Pre puta i kapare proverite informacije"}</h2><p>{de?"Inserat, Dokumente und Importweg verständlich einordnen.":"Razumevanje oglasa, dokumentacije i koraka uvoza."}</p><ul>{autoGuides.map(g=><li><a href={`/${locale}/wissen/${g.slug}/`}>{g[locale]}</a></li>)}</ul><a href={`/${locale}/auto-check/`}>{de?"AutoDanini kennenlernen":"Pogledajte AutoDanini"}</a></div></article>
<article class="knowledge-vertical"><div class="business-process" role="img" aria-label={de?"Darstellung: Kundenanfrage, CRM-Zuordnung, menschliche Freigabe":"Prikaz: poslovni upit, CRM evidencija, ljudsko odobrenje"}><div>{de?"ANFRAGE":"UPIT"}</div><span aria-hidden="true">→</span><div>CRM</div><span aria-hidden="true">→</span><div>{de?"FREIGABE":"ODOBRENJE"}</div></div><div class="knowledge-info"><p class="eyebrow">DANINI Business</p><h2>{de?"Kundenanfragen vollständig erfassen und gezielt bearbeiten":"Prikupite poslovne upite i pratite njihovu obradu"}</h2><p>{de?"Anfragen aus E-Mail und Formularen strukturiert erfassen, im CRM nachverfolgen und Antwortentwürfe mit menschlicher Freigabe vorbereiten.":"Objedinite upite iz e-maila i formulara, pratite njihov status i pripremite odgovore uz ljudsko odobrenje."}</p><ul>{businessGuides.map(g=><li><a href={`/${locale}/wissen/${g.slug}/`}>{g[locale]}</a></li>)}</ul><a href={`/${locale}/business/`}>{de?"DANINI Business kennenlernen":"Pogledajte DANINI Business"}</a></div></article>
</div>
<section class="source-manuscripts"><p class="eyebrow">{de?"AUS DER DANINI REDAKTION":"IZ ORIGINALNE DANINI REDAKCIJE"}</p><h2>{de?"Ausführliche Evergreen-Fachartikel":"Detaljni evergreen članci"}</h2><p>{de?"Hier finden Sie ausführliche Fachbeiträge mit praktischen Beispielen, Checklisten und nachvollziehbaren Informationen.":"Pročitajte detaljne vodiče sa praktičnim primerima, kontrolnim listama i jasno navedenim ograničenjima."}</p><div class="manuscript-list">{originals.map(a=><article class="manuscript"><small>{a.key.startsWith("auto")?"AutoDanini":"DANINI Business"}</small><h3><a href={`/${locale}/wissen/${a.slug}/`}>{a.title}</a></h3><p>{a.description}</p><a href={`/${locale}/wissen/${a.slug}/`}>{de?"Ganzen Artikel lesen":"Pročitajte ceo članak"}</a></article>)}</div></section>
<p class="knowledge-note">{de?"Bereits vorhandene AutoDanini-Hilfen und Kalkulatoren bleiben erhalten. Diese Sammlung ergänzt sie und ersetzt keine unabhängige Fahrzeugprüfung oder Rechtsberatung.":"Postojeći AutoDanini vodiči i kalkulator ostaju dostupni. Ova baza ih dopunjava i ne zamenjuje nezavisan tehnički pregled niti pravni savet."}</p>
</div></section>
<style>
.knowledge-home{max-width:1200px}.knowledge-home .intro{max-width:75ch}.knowledge-shortcuts{display:flex;flex-wrap:wrap;gap:1rem;margin:2rem 0}.knowledge-shortcuts a{padding:.8rem 1rem;border:1px solid #789ba7;border-radius:10px;color:#07495e;font-weight:700}.knowledge-verticals{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.knowledge-vertical{border:1px solid #cbd8de;border-radius:16px;overflow:hidden;background:#f6f9fa;min-width:0;color:#172b40}.knowledge-vertical img,.business-process{width:100%;aspect-ratio:12/7;object-fit:cover;display:block}.business-process{display:flex;align-items:center;justify-content:center;gap:clamp(.3rem,1vw,1rem);padding:1rem;background:linear-gradient(145deg,#102637,#155c64);color:#fff}.business-process div{padding:1rem .55rem;border:1px solid #a4d8d8;border-radius:12px;background:#214f61;font-weight:800;font-size:clamp(.7rem,1.1vw,1rem)}.business-process span{font-size:1.8rem;color:#ffe49e}.knowledge-info{padding:1.6rem}.knowledge-info h2,.source-manuscripts h2{color:#152a40}.knowledge-info p,.source-manuscripts>p:not(.eyebrow){color:#344b60}.knowledge-info li,.manuscript{overflow-wrap:anywhere}.knowledge-info a:focus-visible,.manuscript a:focus-visible{outline:3px solid #0b766e;outline-offset:4px}.knowledge-info li{margin:.8rem 0;line-height:1.5}.knowledge-info a{color:#075b72;text-decoration:underline;text-underline-offset:3px}.source-manuscripts{margin:2.5rem 0}.manuscript-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.manuscript{padding:1.25rem;border:1px solid #c8d7df;border-radius:14px;background:#f1f6f8;min-width:0}.manuscript h3{overflow-wrap:anywhere;color:#14283c}.manuscript p{color:#344b60}.manuscript h3{font-size:1.15rem;line-height:1.35}.manuscript a{color:#075b72;text-decoration:underline}.manuscript p{font-size:.94rem;line-height:1.6}@media(max-width:850px){.manuscript-list{grid-template-columns:1fr}}.knowledge-note{margin-top:2rem;max-width:78ch}@media(max-width:760px){.knowledge-verticals{grid-template-columns:1fr}}
</style>
</Base>