---
import Base from "../../../../layouts/Base.astro";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de"|"sr";
const de=locale==="de";
const root="/"+locale+"/";
const steps=de?[
 ["01","Bedarf prüfen","Klären, ob Ihre Leistung tatsächlich zur Anfrage passt. Keine pauschale Empfehlung."],
 ["02","Zuständigkeit regeln","Direkte Kommunikation, Datenschutz, fachliche Verantwortung und mögliche Kosten schriftlich festhalten."],
 ["03","Kleinen Pilot abstimmen","Nur auf Basis einer konkreten Anfrage und mit vorheriger Freigabe der Beteiligten."],
 ["04","Ergebnis dokumentieren","Nachvollziehbar festhalten, was vermittelt, vorbereitet oder nicht umgesetzt wurde."]
]:[
 ["01","Provera potrebe","Proveravamo da li usluga partnera zaista odgovara problemu kupca. Bez automatskih preporuka."],
 ["02","Jasna odgovornost","Dogovaramo komunikaciju, privatnost podataka, stručnu odgovornost i eventualne troškove."],
 ["03","Ograničeni pilot","Saradnja samo za konkretan slučaj uz prethodno odobrenje svih relevantnih strana."],
 ["04","Evidencija rezultata","Beležimo šta je dogovoreno, pripremljeno ili nije realizovano."]
];
---
<Base locale={locale} slug="wissen/partner" title={de?"Partnerschaft mit DANINI – Fachbetriebe und Empfehlungen":"Partnerstvo sa DANINI — stručni saradnici i preporuke"} description={de?"Interesse an einer nachvollziehbaren Kooperation mit DANINI? Prüfer, Werkstätten, Fahrzeugdienste und DACH-Balkan-B2B. Kein aktives Provisionsprogramm.":"Mogućnost saradnje sa DANINI za stručne provere vozila i DACH–Balkan poslovne usluge. Partnerski pilot, bez aktivnog provizijskog programa."}>
<section class="pp-hero"><div class="wrap pp-hero-grid"><div><a href={root+"wissen/"} class="pp-back">← {de?"Wissen & Ratgeber":"Vodiči i saveti"}</a><p class="pp-kicker">DANINI · DACH ↔ BALKAN</p><h1>{de?"Gute Partner sind ein Teil der Lösung.":"Pouzdani partneri su deo rešenja."}</h1><p>{de?"Wir prüfen eine Zusammenarbeit mit Fachbetrieben, Fahrzeugprüfern und digitalen B2B-Dienstleistern, wenn sie nachweislich ein konkretes Kundenproblem lösen.":"Razmatramo saradnju sa stručnjacima za vozila, auto-servisima i B2B pružaocima usluga kada mogu da reše konkretan problem kupca."}</p><a class="pp-btn" href="#kontakt">{de?"Unverbindlich Interesse bekunden":"Pošaljite interesovanje za saradnju"} →</a><p class="pp-note">{de?"Derzeit kein öffentliches Affiliate- oder Provisionsprogramm. Keine Zusage für Aufträge oder Vermittlungszahlungen.":"Trenutno nema javnog affiliate ili provizijskog programa. Ne obećavamo poslove ni provizije."}</p></div><div class="pp-graphic" role="img" aria-label={de?"DANINI verbindet Anfragen mit überprüften Fachpartnern":"DANINI povezuje upite i proverenog stručnog partnera"}><div class="pp-node"><small>{de?"ANFRAGE":"UPIT"}</small><b>{de?"Klarer Bedarf":"Jasna potreba"}</b></div><span aria-hidden="true">↘</span><div class="pp-node pp-middle"><small>DANINI</small><b>{de?"Prüfung & Freigabe":"Provera i odobrenje"}</b></div><span aria-hidden="true">↘</span><div class="pp-node"><small>{de?"FACHBETRIEB":"STRUČNI PARTNER"}</small><b>{de?"Passende Leistung":"Relevantna usluga"}</b></div></div></div></section>
<section class="pp-main"><div class="wrap">
<p class="pp-kicker">{de?"WER PASST ZU UNS?":"SA KIM RAZMATRAMO SARADNJU?"}</p><h2>{de?"Zwei klar begrenzte Partnerbereiche":"Dve jasno odvojene vrste partnera"}</h2>
<div class="pp-parts"><article><img src="/images/DANINI_Kartica_01_Pregled_Auta_Nemacka.jpg" loading="lazy" width="960" height="560" alt={de?"Fachliche Fahrzeugprüfung als mögliche Partnerleistung":"Stručni pregled vozila kao moguća partnerska usluga"}/><div><span>AutoDanini</span><h3>{de?"Fahrzeugprüfung & Kaufvorbereitung":"Provera vozila i priprema kupovine"}</h3><p>{de?"Unabhängige Fahrzeugprüfer, Werkstätten, Diagnostiker und zugelassene Dienstleister, die ihre Leistungen, Kosten und Zuständigkeiten transparent erläutern können.":"Nezavisni pregledači vozila, servisi, dijagnostika i odgovarajući pružaoci usluga sa jasnim cenama, nadležnostima i obimom rada."}</p></div></article><article><div class="pp-b2b-cover"><small>DANINI BUSINESS</small><b>DE ↔ BALKAN</b><span>{de?"ANFRAGEN · DOKUMENTE · PROZESSE":"UPITI · DOKUMENTA · PROCESI"}</span></div><div><span>DANINI Business</span><h3>{de?"Geschäftsprozesse & dokumentierte Kooperation":"Poslovni procesi i dokumentovana saradnja"}</h3><p>{de?"Dienstleister für digitale Büroabläufe, technische Unterlagen, qualifizierte Sourcing-Vorbereitung und klar abgegrenzte DACH-Balkan-B2B-Aufgaben.":"Saradnici za digitalnu administraciju, tehničku dokumentaciju, pripremu zahteva dobavljačima i jasno definisanu DACH–Balkan B2B podršku."}</p></div></article></div>
<div class="pp-process"><p class="pp-kicker">{de?"SO WÜRDE EIN PILOT ABLAUFEN":"KAKO BI IZGLEDAO PILOT"}</p><h2>{de?"Erst Eignung prüfen. Dann begrenzt zusammenarbeiten.":"Prvo proverimo saradnju. Zatim radimo na konkretnom slučaju."}</h2><div class="pp-steps">{steps.map(([no,title,description])=><article><span>{no}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div>
<section class="pp-contact" id="kontakt"><div><p class="pp-kicker">{de?"KONTAKT":"KONTAKT"}</p><h2>{de?"Sie möchten eine Kooperation vorschlagen?":"Želite da predložite saradnju?"}</h2><p>{de?"Senden Sie eine kurze Beschreibung Ihrer Fachleistung, Region, Verfügbarkeit und vorhandener Nachweise. Bitte keine Kundendaten oder sensiblen Dokumente im Erstkontakt.":"Pošaljite kratak opis usluge, područje rada, raspoloživost i relevantne potvrde. Ne šaljite osetljiva dokumenta ni podatke tuđih klijenata u prvom kontaktu."}</p><a class="pp-btn" href="mailto:info@daninihub.com?subject=DANINI%20Partner%20Interesse">{de?"E-Mail für Partneranfrage öffnen":"Otvori e-mail za partnerski upit"} →</a><p class="pp-contact-note">{de?"Eine Anfrage begründet weder Partnerschaft noch Anspruch auf Provision. Über Bedingungen und eventuelle Vergütung wird erst nach Prüfung gesondert entschieden.":"Slanje upita ne znači partnerski ugovor niti pravo na proviziju. Pravila i eventualna naknada određuju se tek nakon provere i pisanog dogovora."}</p></div></section>
<div class="pp-related"><a href={root+"wissen/produkte/"}>{de?"Produkte und Angebote":"Proizvodi i usluge"} →</a><a href={root+"business/"}>{de?"DANINI Business":"DANINI Business"} →</a><a href={root+"auto-check/"}>AutoDanini →</a></div>
</div></section>
</Base>
<style>
.pp-hero{background:radial-gradient(circle at 90% 20%,#21656a,transparent 42%),linear-gradient(115deg,#102237,#0a3245);color:#fff;padding:clamp(55px,7vw,100px) 0}.pp-hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(25px,6vw,85px);align-items:center}.pp-back{color:#d2e3eb;text-decoration:underline}.pp-kicker{color:#bd9e50;font-weight:850;letter-spacing:.13em;font-size:.75rem}.pp-hero .pp-kicker{color:#facc15;margin-top:35px}.pp-hero h1{color:#fff;font-size:clamp(2.55rem,5vw,4.8rem)}.pp-hero p:not(.pp-kicker){color:#deebf1;font-size:1.08rem}.pp-btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;background:#facc15;color:#13283a;font-weight:850;padding:15px 21px;border-radius:10px;min-height:53px;margin:18px 0;text-align:center}.pp-hero .pp-note{font-size:.83rem!important;color:#b8ceda!important}.pp-graphic{display:flex;flex-direction:column;align-items:center;gap:9px;padding:32px;background:#ffffff0c;border:1px solid #ffffff38;border-radius:20px}.pp-node{border:1px solid #86bfca;border-radius:12px;padding:17px 25px;width:80%;background:#ffffff14;display:flex;flex-direction:column;gap:5px;text-align:center}.pp-node small{color:#facc15;font-size:.7rem;letter-spacing:.1em}.pp-node b{font-size:1.08rem}.pp-middle{background:#facc15;border-color:#facc15;color:#12273a}.pp-middle small{color:#183849}.pp-graphic>span{color:#eecb65;font-size:1.5rem}.pp-main{background:#f7fafb;padding:clamp(55px,7vw,100px) 0}.pp-main h2{color:#132c40;max-width:820px}.pp-parts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;margin-top:30px}.pp-parts article{background:#fff;border:1px solid #d2e2e9;border-radius:18px;overflow:hidden}.pp-parts article img,.pp-b2b-cover{display:flex;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover}.pp-b2b-cover{background:linear-gradient(130deg,#123b50,#0a6669);color:#fff;align-items:flex-start;justify-content:center;flex-direction:column;padding:36px;gap:12px}.pp-b2b-cover small{color:#facc15;font-weight:800;letter-spacing:.12em}.pp-b2b-cover b{font-size:clamp(1.8rem,3vw,2.8rem)}.pp-b2b-cover span{font-size:.8rem;color:#d8ecf3}.pp-parts article>div:not(.pp-b2b-cover){padding:25px}.pp-parts article>div>span{font-size:.78rem;color:#0d6a70;font-weight:800}.pp-parts h3{color:#122d42;font-size:1.65rem;line-height:1.23}.pp-parts p{color:#465e6d}.pp-process{margin-top:65px}.pp-steps{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px;margin-top:28px}.pp-steps article{border:1px solid #d1e1e8;background:#fff;padding:23px;border-radius:15px}.pp-steps article>span{font-size:1.6rem;font-weight:850;color:#0e7175}.pp-steps h3{color:#12364d;font-size:1.12rem}.pp-steps p{font-size:.91rem;color:#4d6574}.pp-contact{background:#122e43;color:#fff;border-radius:20px;margin-top:65px;padding:clamp(26px,5vw,55px);scroll-margin-top:30px}.pp-contact>div{max-width:880px}.pp-contact h2{color:#fff}.pp-contact p:not(.pp-kicker){color:#d7e6ee}.pp-contact .pp-contact-note{font-size:.8rem}.pp-related{display:flex;flex-wrap:wrap;gap:20px;margin-top:30px}.pp-related a{color:#0b5c6e;font-weight:800;text-decoration:underline}@media(max-width:900px){.pp-hero-grid,.pp-parts{grid-template-columns:1fr}.pp-graphic{max-width:550px}.pp-steps{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.pp-steps{grid-template-columns:1fr}.pp-node{width:96%}}
</style>
