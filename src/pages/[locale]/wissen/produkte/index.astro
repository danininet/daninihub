---
import Base from "../../../../layouts/Base.astro";
export function getStaticPaths(){return ["de","sr"].map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as "de"|"sr";
const de=locale==="de";
const root="/"+locale+"/";
---
<Base locale={locale} slug="wissen/produkte" title={de?"DANINI Produkte: Akademie, Ratgeber und Praxisleistungen":"DANINI proizvodi: AI Akademija, vodiči i praktične usluge"} description={de?"Kostenlosen Online Business Builder direkt nutzen, drei Praxislektionen öffnen oder individuelle AutoDanini- und Business-Anfragen stellen.":"Koristi besplatan Online Business Builder, tri praktične lekcije i pošalji AutoDanini ili Business upit."}>
<section class="pd-hero"><div class="wrap"><a class="pd-back" href={root+"wissen/"}>← {de?"Wissen & Ratgeber":"Vodiči i saveti"}</a><p class="pd-label">DANINI · {de?"PRODUKTE & LEISTUNGEN":"PROIZVODI I USLUGE"}</p><h1>{de?"Nicht nur Informationen. Klar definierte Ergebnisse.":"Ne samo informacije. Konkretni proizvodi i rezultati."}</h1><p>{de?"Nutzen Sie den kostenlosen Online Business Builder direkt, lernen Sie mit drei Praxislektionen oder stellen Sie eine konkrete AutoDanini- bzw. Business-Anfrage.":"Odmah koristi besplatni Online Business Builder, prođi tri praktične lekcije ili pošalji konkretan AutoDanini ili Business upit."}</p></div></section>
<section class="pd-main"><div class="wrap pd-width">
<div class="pd-intro"><h2>{de?"Was bekommen Sie konkret?":"Šta konkretno dobijate?"}</h2><p>{de?"Nutzen Sie die kostenlosen Werkzeuge sofort oder stellen Sie eine unverbindliche Anfrage für individuelle Leistungen.":"Besplatne alate koristi odmah, a za individualne usluge pošalji neobavezujući upit."}</p></div>
<article class="pd-education">
 <div><p class="pd-label">DANINI AKADEMIJA · {de?"HAUPTPRODUKT":"GLAVNI PROIZVOD"}</p><h2>{de?"Ihr eigenes Online-Business mit KI entwickeln":"Izgradi svoje online preduzeće uz AI"}</h2>
 <p>{de?"Kostenlose Module 01–03: Nische eingrenzen, Marktsignale prüfen und ein klar begrenztes Angebot mit Kostenkalkulation erstellen. Mit KI-Prompts und Arbeitsblättern. Drei weitere Module sind in Vorbereitung." : "Besplatni moduli 01–03: izbor niše, provera tržišta i konkretna ponuda sa računicom troškova. AI zadaci i radne sveske. Ostala tri modula su planirana."}</p>
 <p class="pd-education-status">{de?"Module 01–03 kostenlos verfügbar · kein kostenpflichtiger Gesamtkurs":"Moduli 01–03 besplatno dostupni · kompletan kurs nije u prodaji"}</p>
 <a class="pd-cta" href={root+"akademija/builder/"}>{de?"Kostenlosen Builder direkt nutzen":"Odmah koristi besplatan Builder"} →</a><a class="pd-cta pd-outline" href={root+"akademija/"}>{de?"Drei kostenlose Lektionen":"Tri besplatne lekcije"} →</a></div>
 <div class="pd-edu-scheme" role="img" aria-label={de?"Nische, Prüfung, Angebot, Lieferung":"Niša, provera, ponuda, isporuka"}><span>01 / {de?"NICHE":"NIŠA"}</span><strong>{de?"Problem finden":"Pronađi problem"}</strong><span>02 / {de?"EVIDENZ":"DOKAZ"}</span><strong>{de?"Nachfrage prüfen":"Proveri potražnju"}</strong><span>03 / {de?"ERGEBNIS":"REZULTAT"}</span><strong>{de?"Angebot definieren":"Definiši ponudu"}</strong></div>
</article>
<div class="pd-grid">
 <article class="pd-card"><div class="pd-cover pd-free"><span>{de?"KOSTENLOS":"BESPLATNO"}</span><b>12 / 12</b><small>{de?"AUTO VOR ANZAHLUNG":"AUTO PRE KAPARE"}</small></div><div class="pd-body"><p class="pd-eyebrow">01 · AutoDanini</p><h3>{de?"Checkliste vor Fahrt & Anzahlung":"Kontrolna lista pre puta i kapare"}</h3><p>{de?"12 praktische Punkte zu Inserat, Verkäufer, FIN, Dokumenten, Risiken und Kosten. Sofort lesbar, ohne E-Mail-Eingabe, druckbar.":"12 stavki za proveru oglasa, prodavca, VIN-a, dokumentacije i mogućih troškova. Bez registracije, za čitanje i štampu."}</p><p class="pd-status pd-ready">{de?"Sofort kostenlos nutzbar":"Odmah besplatno dostupno"}</p><a class="pd-cta" href={root+"wissen/checkliste/"}>{de?"Checkliste öffnen":"Otvori kontrolnu listu"} →</a></div></article>
 <article class="pd-card"><div class="pd-cover pd-auto"><img src="/images/DANINI_Kartica_02_Uvoz_Dokumentacija_EUR1.jpg" width="960" height="560" loading="lazy" alt={de?"Beispielhafte Fahrzeugdokumente":"Ilustrativna dokumentacija vozila"}/><span>{de?"INDIVIDUELLE LEISTUNG":"USLUGA PO ZAHTEVU"}</span></div><div class="pd-body"><p class="pd-eyebrow">02 · AutoDanini</p><h3>{de?"Entscheidungsdossier vor Anzahlung":"Dosije odluke pre kapare"}</h3><p>{de?"Wir strukturieren die von Ihnen übermittelten Anzeige- und Dokumentenangaben: bestätigte Punkte, Widersprüche, fehlende Nachweise, Verkäuferfragen und mögliche Folgekosten.":"Od dostavljenog oglasa i dokumentacije pravimo strukturisan dosije: potvrđene podatke, neslaganja, nedostajuće dokaze, pitanja prodavcu i moguće dodatne troškove."}</p><p class="pd-limits">{de?"Keine unabhängige FIN-Datenbankabfrage und keine technische Begutachtung. Umfang, Preis und Termin werden vor Beauftragung bestätigt.":"Nije nezavisna VIN baza niti fizički pregled. Obim, cenu i rok potvrđujemo pre narudžbine."}</p><p class="pd-status">{de?"Anfrage möglich · keine Sofortzahlung":"Upit je dostupan · bez automatske naplate"}</p><a class="pd-cta" href={root+"auto-check/"}>{de?"Dossier anfragen":"Zatraži dosije"} →</a></div></article>
 <article class="pd-card"><div class="pd-cover pd-business"><span>DANINI BUSINESS</span><div class="pd-flow"><b>{de?"Anfrage":"Upit"}</b><i>→</i><b>{de?"Analyse":"Analiza"}</b><i>→</i><b>{de?"Plan":"Plan"}</b></div></div><div class="pd-body"><p class="pd-eyebrow">04 · DANINI Business</p><h3>{de?"Business Check / Anfragebüro":"Business Check / Anfragebüro"}</h3><p>{de?"Analyse eines klar abgegrenzten Anfrage- oder Verwaltungsprozesses mit Lückenübersicht, Verbesserungsschritten und optionaler Umsetzung nach gesonderter Vereinbarung.":"Pregled jednog konkretnog toka poslovnih upita ili administracije, identifikovanje propusta i pisani naredni koraci. Implementacija se ugovara odvojeno."}</p><p class="pd-limits">{de?"Kein verbindliches Angebot ohne Klärung des Umfangs. Keine Rechtsberatung oder garantierte Zahl neuer Kunden.":"Bez ugovorenog obima nema konačne ponude. Nema pravnog savetovanja ni garantovanog broja novih klijenata."}</p><p class="pd-status">{de?"Qualifizierte Anfrage möglich":"Kvalifikovani upit je dostupan"}</p><a class="pd-cta" href={root+"business/#anfrage"}>{de?"Business Check anfragen":"Zatraži Business Check"} →</a></div></article>
</div>
<section class="pd-next"><h2>{de?"Noch unsicher, was Sie brauchen?":"Niste sigurni šta vam treba?"}</h2><p>{de?"Starten Sie mit der kostenlosen Checkliste oder schildern Sie Ihren konkreten Fall. Ohne bestätigten Leistungsumfang und Preis entsteht kein Auftrag.":"Počnite besplatnom kontrolnom listom ili pošaljite konkretan problem. Sam upit ne znači narudžbinu."}</p><div class="pd-actions"><a class="pd-cta" href={root+"wissen/checkliste/"}>{de?"Kostenlos beginnen":"Počni besplatno"}</a><a class="pd-cta pd-outline" href={root+"business/#anfrage"}>{de?"Geschäftsanfrage senden":"Pošalji poslovni upit"}</a></div></section>
</div></section>
</Base>
<style>
.pd-education{margin:0 0 28px;background:#102d43;border-radius:20px;padding:clamp(22px,4vw,42px);display:grid;grid-template-columns:1.3fr .7fr;gap:32px;color:#fff;align-items:center}.pd-education h2{font-size:clamp(1.8rem,3vw,2.9rem);color:#fff}.pd-education>div>p:not(.pd-label){color:#dce9f0}.pd-education .pd-label{color:#facc15}.pd-education-status{font-size:.82rem;font-weight:850}.pd-edu-scheme{display:grid;gap:9px;padding:24px;border-radius:15px;background:#ffffff11;border:1px solid #ffffff3b}.pd-edu-scheme span{color:#facc15;letter-spacing:.1em;font-size:.73rem;font-weight:850}.pd-edu-scheme strong{font-size:1.25rem;color:#fff;margin-bottom:10px}@media(max-width:850px){.pd-education{grid-template-columns:1fr}}

.pd-hero{background:radial-gradient(circle at 80% 20%,#1c5761,transparent 42%),linear-gradient(115deg,#0e1d30,#10344a);padding:64px 0 78px;color:#fff}.pd-hero .wrap{max-width:1150px}.pd-back{font-size:.9rem;color:#d0e0e8;text-decoration:underline}.pd-label,.pd-eyebrow{font-size:.74rem;letter-spacing:.12em;font-weight:850;color:#b99b50}.pd-label{margin-top:32px}.pd-hero h1{color:#fff;font-size:clamp(2.6rem,4.8vw,4.6rem);max-width:850px}.pd-hero p:not(.pd-label){color:#dceaf0;max-width:77ch;font-size:1.15rem}.pd-main{background:#f5f8fa;padding:clamp(36px,6vw,78px) 0}.pd-width{max-width:1200px}.pd-intro{margin-bottom:26px}.pd-intro h2{color:#142a3d}.pd-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px}.pd-card{background:#fff;border:1px solid #d4e2e8;border-radius:18px;overflow:hidden;box-shadow:0 12px 37px #12293b0b;min-width:0;display:flex;flex-direction:column}.pd-cover{height:215px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;padding:30px;position:relative;overflow:hidden;color:#fff}.pd-cover>span{font-size:.75rem;letter-spacing:.12em;font-weight:850;color:#f9d67e}.pd-cover>b{font-size:clamp(2rem,3.4vw,3.5rem);line-height:1.1;margin-top:18px}.pd-cover>small{font-weight:750;margin-top:4px;letter-spacing:.1em}.pd-free{background:linear-gradient(120deg,#12394d,#0c7572)}.pd-guide{background:linear-gradient(135deg,#102538,#31395d)}.pd-business{background:linear-gradient(135deg,#0b3345,#0b5a59)}.pd-auto{padding:0}.pd-auto img{width:100%;height:100%;object-fit:cover}.pd-auto span{position:absolute;bottom:15px;left:20px;background:#102d40;color:#fff;border-radius:8px;padding:10px 13px}.pd-flow{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:23px}.pd-flow b{padding:12px;background:#ffffff1b;border:1px solid #ffffff55;border-radius:9px}.pd-flow i{color:#facc15;font-style:normal;font-weight:850}.pd-body{padding:clamp(23px,3vw,34px);display:flex;flex:1;flex-direction:column}.pd-body h3{color:#142a3e;font-size:clamp(1.45rem,2.1vw,1.85rem);margin:4px 0 16px;line-height:1.18}.pd-body>p:not(.pd-eyebrow){color:#405668;margin:10px 0;line-height:1.68}.pd-body .pd-limits{font-size:.88rem}.pd-body .pd-status{font-size:.83rem;font-weight:850;background:#e9f3f7;color:#135669;padding:10px 13px;border-radius:8px;margin-top:auto!important}.pd-body .pd-status.pd-ready{background:#e6f4e9;color:#1a6a3c}.pd-body .pd-status.pd-hold{background:#fff0d6;color:#805016}.pd-cta{display:inline-flex;align-items:center;justify-content:center;text-align:center;min-height:48px;padding:13px 19px;background:#0c4155;color:#fff;font-weight:800;border:1px solid #0c4155;border-radius:9px;margin-top:17px;align-self:flex-start}.pd-cta.pd-outline{background:transparent;color:#0c4155}.pd-future{margin-top:32px;background:#e7f0f4;border:1px solid #c7dbe3;padding:30px;border-radius:16px;display:flex;justify-content:space-between;gap:30px;align-items:center}.pd-future h2{font-size:1.6rem;color:#133249}.pd-future p{max-width:75ch}.pd-future a{font-weight:850;white-space:normal;color:#0b5b72;text-decoration:underline}.pd-next{margin-top:30px;background:#fff;border:1px solid #d2e0e7;border-radius:16px;padding:30px}.pd-next h2{font-size:1.7rem;color:#123047}.pd-actions{display:flex;flex-wrap:wrap;gap:12px}@media(max-width:780px){.pd-grid{grid-template-columns:1fr}.pd-future{display:block}.pd-future a{display:inline-block;margin-top:10px}}@media(max-width:450px){.pd-cover{height:175px}.pd-flow{gap:6px}.pd-flow b{font-size:.76rem;padding:8px}}
</style>
