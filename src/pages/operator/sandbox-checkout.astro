---
// Operator-only test interface for the existing protected sandbox endpoint.
// This page has no payment keys or access token embedded in source or URL.
---
<!doctype html>
<html lang="sr">
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width,initial-scale=1" />
 <meta name="robots" content="noindex,nofollow,noarchive" />
 <meta name="referrer" content="no-referrer" />
 <meta http-equiv="Cache-Control" content="no-store" />
 <title>DANINI · PayPal Sandbox operator test</title>
 <style>
  :root{color-scheme:dark;font-family:system-ui,sans-serif;background:#0e1a26;color:#edf4fb}
  *{box-sizing:border-box}
  body{margin:0;padding:clamp(16px,4vw,54px)}
  main{max-width:690px;margin:auto;padding:clamp(20px,4vw,40px);border:1px solid #506577;border-radius:18px;background:#14283a}
  h1{font-size:clamp(1.4rem,3.5vw,2rem)}
  p{line-height:1.6;color:#d9e5ee}
  label{display:block;font-weight:700;margin-top:18px}
  input{display:block;margin-top:9px;width:100%;padding:14px;background:#fff;color:#102233;border:2px solid #c9d6e0;border-radius:8px;font:inherit}
  .check{display:flex;align-items:flex-start;gap:12px;font-weight:500}
  .check input{width:20px;height:20px;flex:none;margin:3px 0 0}
  button{display:block;margin-top:24px;width:100%;min-height:54px;border:0;border-radius:8px;background:#c6f2d5;color:#0a3024;font:700 1rem system-ui;cursor:pointer}
  button:disabled{opacity:.5;cursor:not-allowed}
  a{color:#c4f1ff}
  #status{border-left:3px solid #82bccd;padding-left:14px}
 </style>
</head>
<body>
 <main>
  <p><strong>DANINI · INTERNI OPERATORSKI TEST</strong></p>
  <h1>PayPal Sandbox — test kupovine PDF vodiča</h1>
  <p>Isključivo testna PayPal kupovina, bez stvarnog novca. Cena u Sandbox narudžbini je postojećih 49,00 €. Ovo nije javni checkout i ne aktivira produkcionu naplatu.</p>
  <p id="status" role="status" aria-live="polite">Proveravam postojeći Sandbox režim…</p>
  <form id="sandbox" autocomplete="off" hidden>
   <label for="operator-access">Postojeći DANINI Sandbox operator pristup</label>
   <input id="operator-access" type="password" required minlength="32" autocomplete="off" spellcheck="false" autocapitalize="none" aria-describedby="access-notice" />
   <p id="access-notice">Ovo nije PayPal Client ID ili Secret. Koristite samo ranije ustanovljeni operator pristup. Vrednost se ne čuva u browseru, URL-u niti se šalje ChatGPT-u.</p>
   <label class="check"><input type="checkbox" id="terms" required /> Razumem da je ovo samo interno Sandbox testiranje i prihvatam uslove testa.</label>
   <label class="check"><input type="checkbox" id="delivery" required /> Saglasan sam da se nakon simulirane Sandbox kupovine testira trenutna digitalna isporuka PDF-a.</label>
   <button id="submit" type="submit">Otvori postojeći PayPal Sandbox checkout</button>
  </form>
  <p>Posle odobrenja u PayPal Sandbox nalogu proveravaju se D1 status <code>PAID</code>, Capture ID, Brevo testni e-mail i privatni PDF. Ova stranica ne prikazuje rezultat unapred.</p>
  <p><a href="/digital.html">Nazad na digitalne proizvode</a></p>
 </main>
 <script>
  const form=document.getElementById('sandbox') as HTMLFormElement;
  const status=document.getElementById('status')!;
  const button=document.getElementById('submit') as HTMLButtonElement;
  let ready=false;
  fetch('/api/danini/digital/status',{cache:'no-store',headers:{accept:'application/json'}})
    .then(async r=>{if(!r.ok)throw Error('status');return r.json();})
    .then(s=>{ready=s.mode==='sandbox';form.hidden=!ready;
      status.textContent=ready?'Sandbox okruženje je dostupno. Test zahteva postojeći operator pristup i tvoje odobrenje u PayPal-u.':'Sandbox nije potvrđen ili nije konfigurisan. Nijedna naplata nije pokrenuta.';})
    .catch(()=>{status.textContent='Nije moguće proveriti Sandbox stanje. Nijedna naplata nije pokrenuta.';});
  form.addEventListener('submit',async e=>{
    e.preventDefault();if(!ready||!form.reportValidity())return;
    button.disabled=true;status.textContent='Kreiranje zaštićene Sandbox narudžbine…';
    const input=document.getElementById('operator-access') as HTMLInputElement;
    const access=input.value;input.value='';
    try{
      const response=await fetch('/api/danini/digital/paypal/sandbox/checkout',{
        method:'POST',headers:{'content-type':'application/json','X-Danini-Sandbox-Access':access},
        credentials:'same-origin',cache:'no-store',
        body:JSON.stringify({sku:'guide',language:'sr',termsAccepted:(document.getElementById('terms') as HTMLInputElement).checked,instantDeliveryConsent:(document.getElementById('delivery') as HTMLInputElement).checked})
      });
      const data=await response.json();
      if(!response.ok||data.ok!==true||typeof data.checkoutUrl!=='string')throw Error(String(data.error||'CHECKOUT_UNAVAILABLE'));
      const target=new URL(data.checkoutUrl);
      if(target.protocol!=='https:'||target.origin!=='https://www.sandbox.paypal.com')throw Error('INVALID_PAYPAL_DESTINATION');
      status.textContent='Otvara se PayPal Sandbox za tvoje testno odobrenje…';
      location.assign(target.href);
    }catch(err){
      status.textContent='Sandbox checkout nije otvoren. Nema naplate. Proveri operator pristup i postojeću konfiguraciju; šifra nije sačuvana. Kod: '+(err instanceof Error?err.message:'UNAVAILABLE');
      button.disabled=false;
    }
  });
 </script>
</body>
</html>
