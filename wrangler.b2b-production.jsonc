{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autodanini",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "keep_vars": true,
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/portal/*"],
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "daninihub.com", "custom_domain": true },
    { "pattern": "www.daninihub.com", "custom_domain": true }
  ],
  "vars": {
    "B2B_ACTIVE": "false",
    "AI_ENABLED": "false",
    "SITE_ORIGIN": "https://daninihub.com",
    "RETENTION_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DANINI_DB",
      "database_name": "danini-commerce",
      "database_id": "9c3fc741-5cb0-432f-82ca-c75e8220c435",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PARTNERS",
      "id": "b87637aaa2c24b1281a8bd86ca86525d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "danini-b2b-private"
    }
  ],
  "workflows": [
    {
      "name": "danini-intake-production",
      "binding": "INTAKE_WORKFLOW",
      "class_name": "IntakeWorkflow"
    }
  ]
}
