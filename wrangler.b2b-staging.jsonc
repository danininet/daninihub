{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "danini-b2b-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/portal/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    "B2B_ACTIVE": "false",
    "AI_ENABLED": "false",
    "SITE_ORIGIN": "https://danini-b2b-staging.dragangaganet.workers.dev",
    "RETENTION_DAYS": "30"
  },
  "d1_databases": [
    {
      "binding": "DANINI_DB",
      "database_name": "danini-b2b-staging",
      "database_id": "213809a5-0622-417e-a631-accd8940504e",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PARTNERS",
      "id": "b6f5a45160ee428391c3f22fdc28f48e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "danini-b2b-private"
    }
  ],
  "workflows": [
    {
      "name": "danini-intake-staging",
      "binding": "INTAKE_WORKFLOW",
      "class_name": "IntakeWorkflow"
    }
  ]
}
