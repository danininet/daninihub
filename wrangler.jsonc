{
  "name": "autodanini",
  "compatibility_date": "2026-11-07",
  "previews": {},
  "assets": {
    "directory": "./autodanini-auto-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "daninihub.com",
      "custom_domain": true
    },
    {
      "pattern": "www.daninihub.com",
      "custom_domain": true
    }
  ],
  "main": "workers/danini-intake.mjs"
}
