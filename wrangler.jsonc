{
  "name": "autodanini",
  "compatibility_date": "2026-11-07",
  "previews": {},
  "ai": {"binding": "AI"},
  "assets": {
    "directory": "./autodanini-auto-dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "daninihub.com",
      "custom_domain": true
    },
    {
      "pattern": "www.daninihub.com",
      "custom_domain": true
    }
  ],
  "main": "workers/danini-intake.mjs",
  "kv_namespaces": [
    {
      "binding": "PARTNERS",
      "id": "b87637aaa2c24b1281a8bd86ca86525d"
    }
  ],
  "d1_databases": [
    {
      "binding": "DANINI_DB",
      "database_name": "danini-commerce",
      "database_id": "9c3fc741-5cb0-432f-82ca-c75e8220c435"
    }
  ]
}
